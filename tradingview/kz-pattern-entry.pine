// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
//
// KZ Pattern Entry — H4 SNR zones (with DBD / RBR) + M30 double top / double bottom entries
//
// Flow
//   1. Key zones (rectangles), H4 only. A swing level (SNR) is only marked when price left it
//      with a DBD or RBR:
//        SNR + DBD   swing high -> drop -> base (shallow bounce) -> second drop below the base
//                    -> red zone at the swing high (resistance / sell zone)
//        SNR + RBR   swing low -> rally -> base (shallow pullback) -> second rally above the base
//                    -> blue zone at the swing low (support / buy zone)
//        Breakout    an H4 close through a zone turns it grey and flips its role
//                    (broken resistance -> support, broken support -> resistance); its retest is fresh.
//   2. Confirmation (M30 chart only), on FRESH zones only: when price makes its first approach
//      to a zone and forms a double top (sell zone) = SELL, or a double bottom (buy zone) = BUY,
//      the zone becomes VALID and that is the entry. If the first approach forms no pattern,
//      the zone is marked TESTED and ignored.
//   3. Risk: fixed stop loss / take profit in points (default 600 / 1000).
//
indicator("KZ Pattern Entry (H4 SNR Zones + M30 DT/DB)", shorttitle = "KZ-DTB", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
grpZ = "1 · H4 key zones (SNR with DBD / RBR)"
swLen        = input.int(3, "H4 swing strength (bars each side)", minval = 1, maxval = 10, group = grpZ)
minMoveAtr   = input.float(2.0, "Min first drop / rally (× H4 ATR)", minval = 0.5, step = 0.25, group = grpZ,
     tooltip = "Size of the first leg away from the swing level, e.g. the drop from the swing high in a DBD.")
maxRetr      = input.float(0.7, "Max base bounce (fraction of first leg)", minval = 0.1, maxval = 1.0, step = 0.05, group = grpZ,
     tooltip = "The base may retrace at most this much of the first leg. Deeper retracements are not a base.")
maxBaseBars  = input.int(50, "Max base length (H4 bars)", minval = 2, maxval = 200, group = grpZ)
minZoneAtr   = input.float(1.0, "Min zone height (× H4 ATR)", minval = 0.0, step = 0.1, group = grpZ,
     tooltip = "A zone runs from the swing wick to the candle body, and is made at least this tall.")
maxZones     = input.int(10, "Max zones kept", minval = 1, maxval = 50, group = grpZ)
mergeOverlap = input.bool(true, "Skip new zones that overlap an existing one", group = grpZ)
keepDead     = input.bool(false, "Keep invalidated zones on chart", group = grpZ)
hideTested   = input.bool(false, "Hide tested (used-up) zones", group = grpZ)

grpC = "Zone colours"
colRes       = input.color(color.new(color.red, 80), "Resistance (SNR + DBD)", group = grpC)
colSup       = input.color(color.new(color.blue, 80), "Support (SNR + RBR)", group = grpC)
colBrk       = input.color(color.new(color.gray, 75), "Breakout", group = grpC)
showZoneText = input.bool(true, "Show zone labels", group = grpC)

grpP = "2 · M30 confirmation (double top / bottom)"
showEntries = input.bool(false, "Show M30 entries (patterns, SL/TP)", group = grpP,
     tooltip = "Off = zones only. On = also track zone freshness, find M30 double tops / bottoms and draw SL/TP.")
pL          = input.int(5, "Pattern pivot left bars", minval = 1, group = grpP)
pR          = input.int(3, "Pattern pivot right bars", minval = 1, group = grpP)
minGap      = input.int(5, "Min bars between the two peaks", minval = 2, group = grpP)
maxGap      = input.int(60, "Max bars between the two peaks", minval = 3, maxval = 300, group = grpP)
eqTolAtr    = input.float(0.5, "Peak equality tolerance (× ATR)", minval = 0.05, step = 0.05, group = grpP)
minDepthAtr = input.float(1.0, "Min pattern depth to neckline (× ATR)", minval = 0.0, step = 0.1, group = grpP)
zoneTolAtr  = input.float(0.25, "Zone touch tolerance (× ATR)", minval = 0.0, step = 0.05, group = grpP)
leaveAtr    = input.float(1.0, "Fresh zone: approach ends when price moves away (× H4 ATR)", minval = 0.25, step = 0.25, group = grpP,
     tooltip = "A zone only counts on its first approach. The approach starts when price first reaches the zone and ends when price moves this far away from it. Both peaks of the pattern must form during that approach. If none forms, the zone is marked TESTED and gives no more signals.")
trigger     = input.string("Second peak confirmed", "Signal trigger", options = ["Second peak confirmed", "Neckline break"], group = grpP)
neckExpiry  = input.int(20, "Neckline break must happen within (bars)", minval = 1, group = grpP)
allowBrk    = input.bool(true, "Allow entries at breakout (grey) zones", group = grpP)

grpR = "3 · Risk management"
slPts      = input.int(600, "Stop loss (points)", minval = 1, group = grpR)
tpPts      = input.int(1000, "Take profit (points)", minval = 1, group = grpR)
ptOverride = input.float(0.0, "Point size override (0 = symbol min tick)", minval = 0.0, step = 0.00001, group = grpR)
oneTrade   = input.bool(true, "One trade at a time", group = grpR)
showStats  = input.bool(true, "Show stats table", group = grpR)

// ─────────────────────────────────────────────────────────────────────────────
// H4 scan (runs on H4 through request.security)
//
//   SNR + DBD: swing high H0 -> first drop to swing low L1 (>= minMove × ATR)
//              -> base: price bounces but stays below H0 and retraces <= maxRetr of the drop
//              -> second drop: an H4 close below L1  => resistance zone at H0
//   SNR + RBR: mirror image                           => support zone at the swing low
//
// Values are returned with a [1] offset and requested with lookahead_on, so only closed H4
// candles are used: no repainting.
// ─────────────────────────────────────────────────────────────────────────────
// Remove element i from six parallel arrays (one structure candidate)
pop6(array<float> a, array<float> b, array<int> c, array<float> d, array<int> e, array<float> f, int i) =>
    array.remove(a, i)
    array.remove(b, i)
    array.remove(c, i)
    array.remove(d, i)
    array.remove(e, i)
    array.remove(f, i)
    true

h4Scan(int len, float minMove, float retr, int maxBase, float minH) =>
    float atr   = ta.atr(14)
    float ph    = ta.pivothigh(high, len, len)
    float pl    = ta.pivotlow(low, len, len)
    float hhLen = ta.highest(high, len)
    float llLen = ta.lowest(low, len)

    // last confirmed swing high / low
    var float shP = na
    var float shB = na
    var int   shT = na
    var int   shI = na
    var float slP = na
    var float slB = na
    var int   slT = na
    var int   slI = na

    // DBDs in progress (several at once): swing high H0 (+ body, time) -> swing low L1 (+ bar), base high so far
    var array<float> dH0   = array.new<float>()
    var array<float> dH0B  = array.new<float>()
    var array<int>   dH0T  = array.new<int>()
    var array<float> dL1   = array.new<float>()
    var array<int>   dL1I  = array.new<int>()
    var array<float> dBase = array.new<float>()
    // RBRs in progress: swing low L0 (+ body, time) -> swing high H1 (+ bar), base low so far
    var array<float> uL0   = array.new<float>()
    var array<float> uL0B  = array.new<float>()
    var array<int>   uL0T  = array.new<int>()
    var array<float> uH1   = array.new<float>()
    var array<int>   uH1I  = array.new<int>()
    var array<float> uBase = array.new<float>()

    float resTop = na
    float resBot = na
    int   resT   = na
    float supTop = na
    float supBot = na
    int   supT   = na

    // Progress DBDs: second drop (close below L1) confirms; new high above H0, too-deep bounce or too-long base cancels
    if array.size(dL1) > 0
        for i = array.size(dL1) - 1 to 0
            float h0   = array.get(dH0, i)
            float l1   = array.get(dL1, i)
            bool  done = false
            if high > h0 or bar_index - array.get(dL1I, i) > maxBase
                done := true
            else if close < l1
                if na(resT)
                    resTop := h0
                    resBot := math.min(array.get(dH0B, i), h0 - minH * atr)
                    resT   := array.get(dH0T, i)
                done := true
            else
                float bs = math.max(array.get(dBase, i), high)
                array.set(dBase, i, bs)
                if bs - l1 > retr * (h0 - l1)
                    done := true
            if done
                pop6(dH0, dH0B, dH0T, dL1, dL1I, dBase, i)

    // Progress RBRs: second rally (close above H1) confirms
    if array.size(uH1) > 0
        for i = array.size(uH1) - 1 to 0
            float l0   = array.get(uL0, i)
            float h1   = array.get(uH1, i)
            bool  done = false
            if low < l0 or bar_index - array.get(uH1I, i) > maxBase
                done := true
            else if close > h1
                if na(supT)
                    supBot := l0
                    supTop := math.max(array.get(uL0B, i), l0 + minH * atr)
                    supT   := array.get(uL0T, i)
                done := true
            else
                float bs = math.min(array.get(uBase, i), low)
                array.set(uBase, i, bs)
                if h1 - bs > retr * (h1 - l0)
                    done := true
            if done
                pop6(uL0, uL0B, uL0T, uH1, uH1I, uBase, i)

    // New swing low that ends a big drop from the last swing high -> DBD candidate
    if not na(pl)
        int iL = bar_index - len
        if not na(shI) and shI < iL and shP - pl >= minMove * atr and hhLen - pl <= retr * (shP - pl)
            int k = array.indexof(dH0T, shT)
            if k >= 0
                pop6(dH0, dH0B, dH0T, dL1, dL1I, dBase, k)
            array.push(dH0, shP)
            array.push(dH0B, shB)
            array.push(dH0T, shT)
            array.push(dL1, pl)
            array.push(dL1I, iL)
            array.push(dBase, hhLen)
            if array.size(dL1) > 5
                pop6(dH0, dH0B, dH0T, dL1, dL1I, dBase, 0)
        slP := pl
        slB := math.min(open[len], close[len])
        slT := time[len]
        slI := iL

    // New swing high that ends a big rally from the last swing low -> RBR candidate
    if not na(ph)
        int iH = bar_index - len
        if not na(slI) and slI < iH and ph - slP >= minMove * atr and ph - llLen <= retr * (ph - slP)
            int k = array.indexof(uL0T, slT)
            if k >= 0
                pop6(uL0, uL0B, uL0T, uH1, uH1I, uBase, k)
            array.push(uL0, slP)
            array.push(uL0B, slB)
            array.push(uL0T, slT)
            array.push(uH1, ph)
            array.push(uH1I, iH)
            array.push(uBase, llLen)
            if array.size(uH1) > 5
                pop6(uL0, uL0B, uL0T, uH1, uH1I, uBase, 0)
        shP := ph
        shB := math.max(open[len], close[len])
        shT := time[len]
        shI := iH

    [resTop[1], resBot[1], resT[1], supTop[1], supBot[1], supT[1], close[1], atr[1]]

[rTop, rBot, rT, sTop, sBot, sT, h4C, h4Atr] = request.security(syminfo.tickerid, "240", h4Scan(swLen, minMoveAtr, maxRetr, maxBaseBars, minZoneAtr), lookahead = barmerge.lookahead_on)

h4Ok = timeframe.in_seconds() <= 14400

// ─────────────────────────────────────────────────────────────────────────────
// Zones
// ─────────────────────────────────────────────────────────────────────────────
type Zone
    box    bx
    float  top
    float  bot
    int    role            // 1 = buy zone (support / broken resistance), -1 = sell zone
    string kind
    bool   broken     = false
    int    state      = 0     // 0 FRESH (untouched), 1 IN PLAY (first approach), 2 TESTED (no pattern), 3 VALID (pattern formed)
    int    firstTouch = na
    int    leaveBar   = na    // bar where price moved away after the first approach

var array<Zone> zones   = array.new<Zone>()
var int         lastResT = 0
var int         lastSupT = 0

zoneName(Zone z) => z.kind + (z.broken ? " · BRK" : "")

styleZone(Zone z) =>
    color base = z.broken ? colBrk : z.role == 1 ? colSup : colRes
    color c    = z.state == 2 ? color.new(base, math.min(100, color.t(base) + 12)) : base
    box.set_bgcolor(z.bx, c)
    box.set_border_color(z.bx, color.new(base, z.state == 2 ? 70 : 30))
    box.set_border_width(z.bx, z.state == 3 ? 2 : 1)
    box.set_border_style(z.bx, z.state == 2 ? line.style_dotted : line.style_solid)
    string st = z.state == 0 ? "FRESH" : z.state == 1 ? "IN PLAY" : z.state == 2 ? "TESTED" : "✓ VALID"
    box.set_text(z.bx, showZoneText ? zoneName(z) + (showEntries ? " · " + st : "") : "")
    box.set_text_color(z.bx, color.new(base, z.state == 2 ? 50 : 0))
    true

addZone(float top, float bot, int t, int role, string kind) =>
    bool skip = false
    if mergeOverlap
        for z in zones
            if z.role == role and not z.broken and z.state <= 1 and top >= z.bot and bot <= z.top
                skip := true
                break
    if not skip
        Zone nz = Zone.new(box.new(t, top, time, bot, xloc = xloc.bar_time, border_width = 1,
             text_size = size.small, text_halign = text.align_right, text_valign = text.align_top),
             top, bot, role, kind)
        styleZone(nz)
        array.push(zones, nz)
        if array.size(zones) > maxZones
            box.delete(array.shift(zones).bx)
    true

if h4Ok and not na(rT) and rT != lastResT
    lastResT := rT
    addZone(rTop, rBot, rT, -1, "H4 SNR · DBD")
if h4Ok and not na(sT) and sT != lastSupT
    lastSupT := sT
    addZone(sTop, sBot, sT, 1, "H4 SNR · RBR")

// Breakouts: an H4 close through a zone turns it grey, flips its role and makes it fresh
// again (its first retest can give an entry). A grey zone closed back through is removed.
if array.size(zones) > 0 and not na(h4C)
    for i = array.size(zones) - 1 to 0
        Zone z = array.get(zones, i)
        if not z.broken
            if (z.role == -1 and h4C > z.top) or (z.role == 1 and h4C < z.bot)
                z.broken     := true
                z.role       := -z.role
                z.state      := 0
                z.firstTouch := na
                z.leaveBar   := na
                styleZone(z)
        else if (z.role == 1 and h4C < z.bot) or (z.role == -1 and h4C > z.top)
            if keepDead
                box.set_right(z.bx, time)
                box.set_bgcolor(z.bx, color.new(color.gray, 92))
                box.set_border_color(z.bx, color.new(color.gray, 80))
                box.set_border_style(z.bx, line.style_dotted)
                box.set_text(z.bx, "")
            else
                box.delete(z.bx)
            array.remove(zones, i)

// Pattern check: both peaks inside the zone and both formed during the zone's FIRST approach
// (after first touch, before price moved away). Every matching zone becomes VALID.
validateZones(float a, float b, int role, float tol, int i1, int i2) =>
    string names = ""
    for z in zones
        if z.state == 1 and z.role == role and (allowBrk or not z.broken) and i1 >= z.firstTouch and (na(z.leaveBar) or i2 <= z.leaveBar)
            float lo = z.bot - tol
            float hi = z.top + tol
            if a >= lo and a <= hi and b >= lo and b <= hi
                z.state := 3
                styleZone(z)
                names := names == "" ? zoneName(z) : names + " + " + zoneName(z)
    names

// ─────────────────────────────────────────────────────────────────────────────
// Trades (risk management)
// ─────────────────────────────────────────────────────────────────────────────
type Trade
    int   dir
    float entry
    float sl
    float tp
    int   startBar
    box   riskBx
    box   rewBx
    bool  open = true

var array<Trade> trades = array.new<Trade>()
var int wins   = 0
var int losses = 0

pt = ptOverride > 0 ? ptOverride : syminfo.mintick

int openCount = 0
for t in trades
    if t.open and bar_index > t.startBar
        bool hitSL = t.dir == 1 ? low <= t.sl : high >= t.sl
        bool hitTP = t.dir == 1 ? high >= t.tp : low <= t.tp
        if hitSL or hitTP
            t.open := false
            bool win = hitTP and not hitSL     // both in one candle -> counted as SL (conservative)
            if win
                wins += 1
            else
                losses += 1
            box.set_right(t.riskBx, bar_index)
            box.set_right(t.rewBx, bar_index)
            label.new(bar_index, win ? t.tp : t.sl, win ? "TP ✓" : "SL ✗", style = label.style_label_left,
                 color = win ? color.new(color.green, 0) : color.new(color.red, 0), textcolor = color.white, size = size.small)
        else
            box.set_right(t.riskBx, bar_index + 1)
            box.set_right(t.rewBx, bar_index + 1)
    if t.open
        openCount += 1

if array.size(trades) > 100 and not array.get(trades, 0).open
    array.shift(trades)

// ─────────────────────────────────────────────────────────────────────────────
// M30 double top / double bottom
// ─────────────────────────────────────────────────────────────────────────────
isM30 = timeframe.period == "30"
atrM  = ta.atr(14)
ph    = ta.pivothigh(high, pL, pR)
pl    = ta.pivotlow(low, pL, pR)

var float  lastPH   = na
var int    lastPHi  = na
var float  lastPL   = na
var int    lastPLi  = na
var int    pendDir  = 0
var float  pendNeck = na
var float  pendInv  = na
var int    pendExp  = na
var string pendZone = ""

drawPattern(int i1, float p1, int iN, float neck, int i2, float p2, int dir) =>
    color c = dir == -1 ? color.red : color.blue
    line.new(i1, p1, iN, neck, color = c, width = 2)
    line.new(iN, neck, i2, p2, color = c, width = 2)
    line.new(i1, neck, bar_index, neck, color = color.new(c, 40), style = line.style_dashed)
    label.new(i2, p2, dir == -1 ? "DT" : "DB", style = dir == -1 ? label.style_label_down : label.style_label_up,
         color = color.new(color.white, 100), textcolor = c, size = size.small)
    true

int    sig     = 0
string sigZone = ""

// Zone freshness: FRESH until price first reaches it (-> IN PLAY). The first approach ends when
// price moves leaveAtr × H4 ATR away from the zone; if no M30 pattern formed by then, the zone
// is marked TESTED and is ignored from then on.
float zTol  = zoneTolAtr * atrM
float leave = leaveAtr * nz(h4Atr, 3 * atrM)
if showEntries and array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        Zone z = array.get(zones, i)
        if z.state == 0
            if (z.role == -1 and high >= z.bot - zTol) or (z.role == 1 and low <= z.top + zTol)
                z.state      := 1
                z.firstTouch := bar_index
                styleZone(z)
        else if z.state == 1 and na(z.leaveBar)
            if (z.role == -1 and low < z.bot - leave) or (z.role == 1 and high > z.top + leave)
                z.leaveBar := bar_index
        else if z.state == 1 and bar_index > z.leaveBar + pR
            z.state := 2
            if hideTested
                box.delete(z.bx)
                array.remove(zones, i)
            else
                styleZone(z)

if showEntries and isM30 and barstate.isconfirmed
    // Neckline-break trigger for a pattern found earlier
    if pendDir != 0
        bool failed = pendDir == -1 ? high > pendInv : low < pendInv
        if failed or bar_index > pendExp
            pendDir := 0
        else if (pendDir == -1 and close < pendNeck) or (pendDir == 1 and close > pendNeck)
            sig     := pendDir
            sigZone := pendZone
            pendDir := 0

    // Double top -> SELL (both peaks inside a sell zone)
    if not na(ph)
        int   i2 = bar_index - pR
        float p2 = ph
        if not na(lastPH)
            int   gap = i2 - lastPHi
            float p1  = lastPH
            if gap >= minGap and gap <= maxGap and math.abs(p2 - p1) <= eqTolAtr * atrM
                float neck    = low[pR + 1]
                int   neckOff = pR + 1
                float maxMid  = high[pR + 1]
                for k = pR + 1 to pR + gap - 1
                    if low[k] < neck
                        neck    := low[k]
                        neckOff := k
                    maxMid := math.max(maxMid, high[k])
                float top2 = math.max(p1, p2)
                if maxMid <= top2 and math.min(p1, p2) - neck >= minDepthAtr * atrM
                    string zn = validateZones(p1, p2, -1, zTol, lastPHi, i2)
                    if zn != ""
                        drawPattern(lastPHi, p1, bar_index - neckOff, neck, i2, p2, -1)
                        if trigger == "Second peak confirmed"
                            sig     := -1
                            sigZone := zn
                        else
                            pendDir  := -1
                            pendNeck := neck
                            pendInv  := top2
                            pendExp  := bar_index + neckExpiry
                            pendZone := zn
        lastPH  := p2
        lastPHi := i2

    // Double bottom -> BUY (both lows inside a buy zone)
    if not na(pl)
        int   j2 = bar_index - pR
        float q2 = pl
        if not na(lastPL)
            int   gap = j2 - lastPLi
            float q1  = lastPL
            if gap >= minGap and gap <= maxGap and math.abs(q2 - q1) <= eqTolAtr * atrM
                float neck    = high[pR + 1]
                int   neckOff = pR + 1
                float minMid  = low[pR + 1]
                for k = pR + 1 to pR + gap - 1
                    if high[k] > neck
                        neck    := high[k]
                        neckOff := k
                    minMid := math.min(minMid, low[k])
                float bot2 = math.min(q1, q2)
                if minMid >= bot2 and neck - math.max(q1, q2) >= minDepthAtr * atrM
                    string zn = validateZones(q1, q2, 1, zTol, lastPLi, j2)
                    if zn != ""
                        drawPattern(lastPLi, q1, bar_index - neckOff, neck, j2, q2, 1)
                        if trigger == "Second peak confirmed"
                            sig     := 1
                            sigZone := zn
                        else
                            pendDir  := 1
                            pendNeck := neck
                            pendInv  := bot2
                            pendExp  := bar_index + neckExpiry
                            pendZone := zn
        lastPL  := q2
        lastPLi := j2

// ─────────────────────────────────────────────────────────────────────────────
// Entry: SL / TP boxes, labels, alerts
// ─────────────────────────────────────────────────────────────────────────────
bool buyFired  = false
bool sellFired = false

if sig != 0 and not (oneTrade and openCount > 0)
    float entry = close
    float sl    = entry - sig * slPts * pt
    float tp    = entry + sig * tpPts * pt
    box rb = box.new(bar_index, math.max(entry, sl), bar_index + 1, math.min(entry, sl),
         border_color = color.new(color.red, 50), bgcolor = color.new(color.red, 85),
         text = "SL " + str.tostring(sl, format.mintick), text_color = color.new(color.red, 0),
         text_size = size.small, text_halign = text.align_left)
    box wb = box.new(bar_index, math.max(entry, tp), bar_index + 1, math.min(entry, tp),
         border_color = color.new(color.green, 50), bgcolor = color.new(color.green, 85),
         text = "TP " + str.tostring(tp, format.mintick), text_color = color.new(color.green, 0),
         text_size = size.small, text_halign = text.align_left)
    array.push(trades, Trade.new(sig, entry, sl, tp, bar_index, rb, wb))
    string side = sig == 1 ? "BUY" : "SELL"
    label.new(bar_index, sig == 1 ? low : high,
         side + " · " + sigZone + "\nEntry " + str.tostring(entry, format.mintick) +
         "\nSL " + str.tostring(sl, format.mintick) + "\nTP " + str.tostring(tp, format.mintick),
         style = sig == 1 ? label.style_label_up : label.style_label_down,
         color = sig == 1 ? color.blue : color.red, textcolor = color.white, size = size.small)
    buyFired  := sig == 1
    sellFired := sig == -1
    alert(syminfo.ticker + " " + side + " (" + (sig == 1 ? "double bottom" : "double top") + " in " + sigZone + " zone)" +
         " | Entry " + str.tostring(entry, format.mintick) + " | SL " + str.tostring(sl, format.mintick) +
         " | TP " + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)

plotshape(buyFired, "Buy signal", shape.triangleup, location.belowbar, color.blue, size = size.tiny)
plotshape(sellFired, "Sell signal", shape.triangledown, location.abovebar, color.red, size = size.tiny)

alertcondition(buyFired, "KZ Buy", "Double bottom in buy zone — BUY {{ticker}} @ {{close}}")
alertcondition(sellFired, "KZ Sell", "Double top in sell zone — SELL {{ticker}} @ {{close}}")

// Keep live zones extended to the current bar
if barstate.islast
    int ext = time + 10 * timeframe.in_seconds() * 1000
    for z in zones
        box.set_right(z.bx, ext)

// ─────────────────────────────────────────────────────────────────────────────
// Stats table
// ─────────────────────────────────────────────────────────────────────────────
var table tb = table.new(position.top_right, 2, 9, bgcolor = color.new(color.black, 20),
     border_color = color.new(color.gray, 70), border_width = 1)

if barstate.islast and showStats
    int total = wins + losses
    color tc  = color.white
    table.cell(tb, 0, 0, "KZ Pattern Entry", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 0, "", text_color = tc, text_size = size.small)
    table.cell(tb, 0, 1, "Pattern TF", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 1, isM30 ? "M30 ✓" : "Switch chart to M30", text_color = isM30 ? color.lime : color.orange, text_size = size.small)
    table.cell(tb, 0, 2, "Zones", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 2, "Red SNR+DBD · Blue SNR+RBR · Grey BRK", text_color = tc, text_size = size.small)
    int nFresh = 0
    int nPlay  = 0
    for z in zones
        if z.state == 0
            nFresh += 1
        else if z.state == 1
            nPlay += 1
    table.cell(tb, 0, 7, "Fresh / in play", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 7, str.tostring(nFresh) + " / " + str.tostring(nPlay), text_color = tc, text_size = size.small)
    table.cell(tb, 0, 3, "SL / TP", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 3, str.tostring(slPts) + " / " + str.tostring(tpPts) + " pts  (" +
         str.tostring(slPts * pt, format.mintick) + " / " + str.tostring(tpPts * pt, format.mintick) + ")",
         text_color = tc, text_size = size.small)
    table.cell(tb, 0, 4, "Trades", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 4, str.tostring(total) + "  (open " + str.tostring(openCount) + ")", text_color = tc, text_size = size.small)
    table.cell(tb, 0, 5, "Wins / Losses", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 5, str.tostring(wins) + " / " + str.tostring(losses), text_color = tc, text_size = size.small)
    table.cell(tb, 0, 6, "Win rate", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 6, total > 0 ? str.tostring(100.0 * wins / total, "#.0") + "%" : "–", text_color = tc, text_size = size.small)
