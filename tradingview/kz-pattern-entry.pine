// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
//
// KZ Pattern Entry — D1/H4 key zones + M30 double top / double bottom entries
//
// Flow
//   1. Key zones (rectangles). SNR levels come from H4 only; DBD/RBR bases from D1 and H4.
//      By default a zone is only marked where an H4 SNR level overlaps a DBD/RBR base:
//        SNR + DBD   drop-base-drop at an SNR level   -> red  (resistance / sell zone)
//        SNR + RBR   rally-base-rally at an SNR level -> blue (support / buy zone)
//        Breakout    a zone that a D1/H4 candle closed through turns grey and flips role
//                    (broken resistance -> support, broken support -> resistance)
//   2. Confirmation (M30 chart only), on FRESH zones only: when price makes its first
//      approach to a zone and forms a double top (red zone) = SELL, or a double bottom
//      (blue zone) = BUY, the zone becomes VALID and that is the entry. If the first
//      approach forms no pattern, the zone is marked TESTED and ignored.
//   3. Risk: fixed stop loss / take profit in points (default 600 / 1000).
//
indicator("KZ Pattern Entry (D1/H4 Zones + M30 DT/DB)", shorttitle = "KZ-DTB", overlay = true,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
grpZ = "1 · D1 / H4 key zones"
useD1        = input.bool(true, "D1 DBD/RBR", inline = "tf", group = grpZ)
useH4        = input.bool(true, "H4 DBD/RBR", inline = "tf", group = grpZ)
zoneMode     = input.string("SNR + DBD/RBR only", "Zones to mark", options = ["SNR + DBD/RBR only", "All SNR and DBD/RBR"], group = grpZ,
     tooltip = "SNR levels come from H4 only. SNR + DBD/RBR only: a zone is drawn only where an H4 swing level (SNR) overlaps a drop-base-drop (red, sell) or rally-base-rally (blue, buy) base.")
snrMemory    = input.int(30, "Levels remembered for matching", minval = 5, maxval = 100, group = grpZ)
pivLen       = input.int(5, "H4 SNR swing strength (bars each side)", minval = 2, maxval = 20, group = grpZ)
legMult      = input.float(1.0, "DBD/RBR leg candle min body (× ATR)", minval = 0.1, step = 0.1, group = grpZ)
baseRatio    = input.float(0.5, "Base candle max body / range", minval = 0.1, maxval = 1.0, step = 0.05, group = grpZ)
maxBase      = input.int(3, "Max base candles", minval = 1, maxval = 6, group = grpZ)
minZoneAtr   = input.float(0.15, "Min zone height (× ATR)", minval = 0.0, step = 0.05, group = grpZ)
maxZones     = input.int(8, "Max zones kept per timeframe", minval = 1, maxval = 50, group = grpZ)
allZones     = zoneMode == "All SNR and DBD/RBR"
mergeOverlap = input.bool(true, "Skip new zones that overlap an existing one", group = grpZ)
keepDead     = input.bool(false, "Keep invalidated zones on chart", group = grpZ)
hideTested   = input.bool(false, "Hide tested (used-up) zones", group = grpZ)

grpC = "Zone colours"
colRes       = input.color(color.new(color.red, 80), "Resistance (SNR + DBD)", group = grpC)
colSup       = input.color(color.new(color.blue, 80), "Support (SNR + RBR)", group = grpC)
colBrk       = input.color(color.new(color.gray, 75), "Breakout", group = grpC)
showZoneText = input.bool(true, "Show zone labels", group = grpC)

grpP = "2 · M30 confirmation (double top / bottom)"
pL          = input.int(5, "Pattern pivot left bars", minval = 1, group = grpP)
pR          = input.int(3, "Pattern pivot right bars", minval = 1, group = grpP)
minGap      = input.int(5, "Min bars between the two peaks", minval = 2, group = grpP)
maxGap      = input.int(60, "Max bars between the two peaks", minval = 3, maxval = 300, group = grpP)
eqTolAtr    = input.float(0.5, "Peak equality tolerance (× ATR)", minval = 0.05, step = 0.05, group = grpP)
minDepthAtr = input.float(1.0, "Min pattern depth to neckline (× ATR)", minval = 0.0, step = 0.1, group = grpP)
zoneTolAtr  = input.float(0.25, "Zone touch tolerance (× ATR)", minval = 0.0, step = 0.05, group = grpP)
freshWin    = input.int(12, "Fresh zone: 1st peak within N bars of first touch", minval = 1, group = grpP,
     tooltip = "A zone only counts on its first approach. The pattern's first peak must form within this many M30 bars of price first reaching the zone. If no pattern forms on that approach, the zone is marked TESTED and gives no signals.")
trigger     = input.string("Second peak confirmed", "Signal trigger", options = ["Second peak confirmed", "Neckline break"], group = grpP)
neckExpiry  = input.int(20, "Neckline break must happen within (bars)", minval = 1, group = grpP)
allowBrk    = input.bool(true, "Allow entries at breakout (grey) zones", group = grpP)

grpR = "3 · Risk management"
slPts      = input.int(600, "Stop loss (points)", minval = 1, group = grpR)
tpPts      = input.int(1000, "Take profit (points)", minval = 1, group = grpR)
ptOverride = input.float(0.0, "Point size override (0 = symbol min tick)", minval = 0.0, step = 0.00001, group = grpR)
oneTrade   = input.bool(true, "One trade at a time", group = grpR)
showStats  = input.bool(true, "Show stats table", group = grpR)

// ─────────────────────────────────────────────────────────────────────────────
// Higher-timeframe scan (runs on D1 and H4 through request.security)
// Every value is offset by [1] and requested with lookahead_on, so only closed
// D1/H4 candles are used: no repainting.
// ─────────────────────────────────────────────────────────────────────────────
htfScan(int len, float legM, float baseR, int maxB, float minH) =>
    float atr  = ta.atr(14)
    float body = math.abs(close - open)
    float rng  = high - low
    float ph   = ta.pivothigh(high, len, len)
    float pl   = ta.pivotlow(low, len, len)

    // SNR resistance: swing-high wick down to the candle body
    float rTop = na
    float rBot = na
    int   rT   = na
    if not na(ph)
        rTop := high[len]
        rBot := math.max(open[len], close[len])
        if rTop - rBot < minH * atr[len]
            rBot := rTop - minH * atr[len]
        rT := time[len]

    // SNR support: swing-low wick up to the candle body
    float sTop = na
    float sBot = na
    int   sT   = na
    if not na(pl)
        sBot := low[len]
        sTop := math.min(open[len], close[len])
        if sTop - sBot < minH * atr[len]
            sTop := sBot + minH * atr[len]
        sT := time[len]

    // DBD / RBR: big leg-in, 1..maxB small base candles, big leg-out
    float dTop = na
    float dBot = na
    int   dT   = na
    float uTop = na
    float uBot = na
    int   uT   = na
    if body >= legM * atr
        for n = 1 to maxB
            bool  allSmall = true
            float bHi = high[1]
            float bLo = low[1]
            for k = 1 to n
                if body[k] > baseR * rng[k]
                    allSmall := false
                bHi := math.max(bHi, high[k])
                bLo := math.min(bLo, low[k])
            if not allSmall
                break
            if body[n + 1] >= legM * atr[n + 1]
                if bHi - bLo < minH * atr
                    float mid = (bHi + bLo) / 2
                    bHi := mid + minH * atr / 2
                    bLo := mid - minH * atr / 2
                if close < open and close[n + 1] < open[n + 1] and close < bLo
                    dTop := bHi
                    dBot := bLo
                    dT   := time[n]
                else if close > open and close[n + 1] > open[n + 1] and close > bHi
                    uTop := bHi
                    uBot := bLo
                    uT   := time[n]
                break

    [rTop[1], rBot[1], rT[1], sTop[1], sBot[1], sT[1], dTop[1], dBot[1], dT[1], uTop[1], uBot[1], uT[1], close[1]]

[d1RTop, d1RBot, d1RT, d1STop, d1SBot, d1ST, d1DTop, d1DBot, d1DT, d1UTop, d1UBot, d1UT, d1C] = request.security(syminfo.tickerid, "D", htfScan(pivLen, legMult, baseRatio, maxBase, minZoneAtr), lookahead = barmerge.lookahead_on)
[h4RTop, h4RBot, h4RT, h4STop, h4SBot, h4ST, h4DTop, h4DBot, h4DT, h4UTop, h4UBot, h4UT, h4C] = request.security(syminfo.tickerid, "240", htfScan(pivLen, legMult, baseRatio, maxBase, minZoneAtr), lookahead = barmerge.lookahead_on)

d1Ok = useD1 and timeframe.in_seconds() <= 86400
h4Ok = useH4 and timeframe.in_seconds() <= 14400

// ─────────────────────────────────────────────────────────────────────────────
// Zones
// ─────────────────────────────────────────────────────────────────────────────
type Zone
    box    bx
    float  top
    float  bot
    int    role            // 1 = buy zone (support / RBR / broken resistance), -1 = sell zone
    string tf
    string kind
    string id
    bool   broken     = false
    int    state      = 0     // 0 FRESH (untouched), 1 IN PLAY (first approach), 2 TESTED (no pattern), 3 VALID (pattern formed)
    int    firstTouch = na

var array<Zone>      zones = array.new<Zone>()
var map<string, int> seen  = map.new<string, int>()

zoneName(Zone z) => z.kind + (z.broken ? " · BRK" : "")

styleZone(Zone z) =>
    color base = z.broken ? colBrk : z.role == 1 ? colSup : colRes
    color c    = z.state == 2 ? color.new(base, math.min(100, color.t(base) + 12)) : base
    box.set_bgcolor(z.bx, c)
    box.set_border_color(z.bx, color.new(base, z.state == 2 ? 70 : 30))
    box.set_border_width(z.bx, z.state == 3 ? 2 : 1)
    box.set_border_style(z.bx, z.state == 2 ? line.style_dotted : line.style_solid)
    string st = z.state == 0 ? "FRESH" : z.state == 1 ? "IN PLAY" : z.state == 2 ? "TESTED" : "✓ VALID"
    box.set_text(z.bx, showZoneText ? zoneName(z) + " · " + st : "")
    box.set_text_color(z.bx, color.new(base, z.state == 2 ? 50 : 0))
    true

addZone(float top, float bot, int t, int role, string tf, string kind, string id) =>
    bool skip = false
    if mergeOverlap
        for z in zones
            if z.tf == tf and z.role == role and not z.broken and z.state <= 1 and top >= z.bot and bot <= z.top
                skip := true
                break
    if not skip
        Zone nz = Zone.new(box.new(t, top, time, bot, xloc = xloc.bar_time, border_width = 1,
             text_size = size.small, text_halign = text.align_right, text_valign = text.align_top),
             top, bot, role, tf, kind, id)
        styleZone(nz)
        array.push(zones, nz)
        int cnt = 0
        for z in zones
            if z.tf == tf
                cnt += 1
        if cnt > maxZones
            for i = 0 to array.size(zones) - 1
                Zone oz = array.get(zones, i)
                if oz.tf == tf
                    box.delete(oz.bx)
                    array.remove(zones, i)
                    break
    true

// Candidate levels: in confluence mode SNR swings and DBD/RBR bases are remembered
// (not drawn) and a zone is only marked where an SNR level overlaps a DBD/RBR base.
type Cand
    float  top
    float  bot
    int    t
    int    role
    string tf
    string kind

var array<Cand> snrPool = array.new<Cand>()
var array<Cand> sdPool  = array.new<Cand>()

isNew(string key, int t) =>
    int  last  = map.contains(seen, key) ? map.get(seen, key) : 0
    bool fresh = not na(t) and t != last
    if fresh
        map.put(seen, key, t)
    fresh

capPool(array<Cand> pool, string tf, int maxN) =>
    int cnt = 0
    for c in pool
        if c.tf == tf
            cnt += 1
    if cnt > maxN
        for i = 0 to array.size(pool) - 1
            if array.get(pool, i).tf == tf
                array.remove(pool, i)
                break
    true

// SNR level + DBD/RBR base -> one zone covering both; colour/direction from the DBD (sell) or RBR (buy)
addConfluence(Cand s, Cand d) =>
    addZone(math.max(s.top, d.top), math.min(s.bot, d.bot), math.min(s.t, d.t), d.role, d.tf,
         "H4 SNR + " + d.tf + " " + d.kind, d.tf + d.kind + str.tostring(d.t))

onSNR(string key, float top, float bot, int t, int role, string tf, string kind) =>
    if not na(top) and not na(bot) and isNew(key, t)
        if allZones
            addZone(top, bot, t, role, tf, tf + " " + kind, key + str.tostring(t))
        else
            Cand s = Cand.new(top, bot, t, role, tf, kind)
            array.push(snrPool, s)
            capPool(snrPool, tf, snrMemory)
            if array.size(sdPool) > 0
                for i = array.size(sdPool) - 1 to 0
                    Cand d = array.get(sdPool, i)
                    if top >= d.bot and bot <= d.top
                        addConfluence(s, d)
                        array.remove(sdPool, i)
    true

onSD(string key, float top, float bot, int t, int role, string tf, string kind) =>
    if not na(top) and not na(bot) and isNew(key, t)
        if allZones
            addZone(top, bot, t, role, tf, tf + " " + kind, key + str.tostring(t))
        else
            Cand d = Cand.new(top, bot, t, role, tf, kind)
            bool matched = false
            if array.size(snrPool) > 0
                for i = array.size(snrPool) - 1 to 0
                    Cand s = array.get(snrPool, i)
                    if top >= s.bot and bot <= s.top
                        addConfluence(s, d)
                        matched := true
                        break
            if not matched
                array.push(sdPool, d)
                capPool(sdPool, tf, snrMemory)
    true

if d1Ok
    onSD("D1D", d1DTop, d1DBot, d1DT, -1, "D1", "DBD")
    onSD("D1U", d1UTop, d1UBot, d1UT,  1, "D1", "RBR")
if h4Ok
    onSNR("H4R", h4RTop, h4RBot, h4RT, -1, "H4", "RES")
    onSNR("H4S", h4STop, h4SBot, h4ST,  1, "H4", "SUP")
    onSD("H4D", h4DTop, h4DBot, h4DT, -1, "H4", "DBD")
    onSD("H4U", h4UTop, h4UBot, h4UT,  1, "H4", "RBR")

// A DBD/RBR base still waiting for an SNR match is dropped once a D1/H4 close goes through it
if array.size(sdPool) > 0
    for i = array.size(sdPool) - 1 to 0
        Cand  d = array.get(sdPool, i)
        float c = d.tf == "D1" ? d1C : h4C
        if not na(c) and ((d.role == -1 and c > d.top) or (d.role == 1 and c < d.bot))
            array.remove(sdPool, i)

// Breakouts: a D1/H4 close through a zone turns it grey, flips its role and makes it
// fresh again (its first retest can give an entry). A grey zone closed back through is removed.
if array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        Zone  z = array.get(zones, i)
        float c = z.tf == "D1" ? d1C : h4C
        if not na(c)
            if not z.broken
                if (z.role == -1 and c > z.top) or (z.role == 1 and c < z.bot)
                    z.broken     := true
                    z.role       := -z.role
                    z.state      := 0
                    z.firstTouch := na
                    styleZone(z)
            else if (z.role == 1 and c < z.bot) or (z.role == -1 and c > z.top)
                if keepDead
                    box.set_right(z.bx, time)
                    box.set_bgcolor(z.bx, color.new(color.gray, 92))
                    box.set_border_color(z.bx, color.new(color.gray, 80))
                    box.set_border_style(z.bx, line.style_dotted)
                    box.set_text(z.bx, "")
                else
                    box.delete(z.bx)
                array.remove(zones, i)

// Pattern check: both peaks inside the zone, and the first peak formed on the zone's
// FIRST approach (within freshWin bars of first touch). Every matching zone becomes VALID.
validateZones(float a, float b, int role, float tol, int i1) =>
    string names = ""
    for z in zones
        if z.state == 1 and z.role == role and (allowBrk or not z.broken) and i1 >= z.firstTouch and i1 <= z.firstTouch + freshWin
            float lo = z.bot - tol
            float hi = z.top + tol
            if a >= lo and a <= hi and b >= lo and b <= hi
                z.state := 3
                styleZone(z)
                names := names == "" ? zoneName(z) : names + " + " + zoneName(z)
    names

// ─────────────────────────────────────────────────────────────────────────────
// Trades (risk management)
// ─────────────────────────────────────────────────────────────────────────────
type Trade
    int   dir
    float entry
    float sl
    float tp
    int   startBar
    box   riskBx
    box   rewBx
    bool  open = true

var array<Trade> trades = array.new<Trade>()
var int wins   = 0
var int losses = 0

pt = ptOverride > 0 ? ptOverride : syminfo.mintick

int openCount = 0
for t in trades
    if t.open and bar_index > t.startBar
        bool hitSL = t.dir == 1 ? low <= t.sl : high >= t.sl
        bool hitTP = t.dir == 1 ? high >= t.tp : low <= t.tp
        if hitSL or hitTP
            t.open := false
            bool win = hitTP and not hitSL     // both in one candle -> counted as SL (conservative)
            if win
                wins += 1
            else
                losses += 1
            box.set_right(t.riskBx, bar_index)
            box.set_right(t.rewBx, bar_index)
            label.new(bar_index, win ? t.tp : t.sl, win ? "TP ✓" : "SL ✗", style = label.style_label_left,
                 color = win ? color.new(color.green, 0) : color.new(color.red, 0), textcolor = color.white, size = size.small)
        else
            box.set_right(t.riskBx, bar_index + 1)
            box.set_right(t.rewBx, bar_index + 1)
    if t.open
        openCount += 1

if array.size(trades) > 100 and not array.get(trades, 0).open
    array.shift(trades)

// ─────────────────────────────────────────────────────────────────────────────
// M30 double top / double bottom
// ─────────────────────────────────────────────────────────────────────────────
isM30 = timeframe.period == "30"
atrM  = ta.atr(14)
ph    = ta.pivothigh(high, pL, pR)
pl    = ta.pivotlow(low, pL, pR)

var float  lastPH   = na
var int    lastPHi  = na
var float  lastPL   = na
var int    lastPLi  = na
var int    pendDir  = 0
var float  pendNeck = na
var float  pendInv  = na
var int    pendExp  = na
var string pendZone = ""

drawPattern(int i1, float p1, int iN, float neck, int i2, float p2, int dir) =>
    color c = dir == -1 ? color.red : color.blue
    line.new(i1, p1, iN, neck, color = c, width = 2)
    line.new(iN, neck, i2, p2, color = c, width = 2)
    line.new(i1, neck, bar_index, neck, color = color.new(c, 40), style = line.style_dashed)
    label.new(i2, p2, dir == -1 ? "DT" : "DB", style = dir == -1 ? label.style_label_down : label.style_label_up,
         color = color.new(color.white, 100), textcolor = c, size = size.small)
    true

int    sig     = 0
string sigZone = ""

// Zone freshness: FRESH until price first reaches it (-> IN PLAY). If no M30 pattern forms on
// that first approach, the zone is marked TESTED and is ignored from then on.
float zTol = zoneTolAtr * atrM
if array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        Zone z = array.get(zones, i)
        if z.state == 0
            if (z.role == -1 and high >= z.bot - zTol) or (z.role == 1 and low <= z.top + zTol)
                z.state      := 1
                z.firstTouch := bar_index
                styleZone(z)
        else if z.state == 1 and bar_index > z.firstTouch + freshWin + maxGap + pR
            z.state := 2
            if hideTested
                box.delete(z.bx)
                array.remove(zones, i)
            else
                styleZone(z)

if isM30 and barstate.isconfirmed
    // Neckline-break trigger for a pattern found earlier
    if pendDir != 0
        bool failed = pendDir == -1 ? high > pendInv : low < pendInv
        if failed or bar_index > pendExp
            pendDir := 0
        else if (pendDir == -1 and close < pendNeck) or (pendDir == 1 and close > pendNeck)
            sig     := pendDir
            sigZone := pendZone
            pendDir := 0

    // Double top -> SELL (both peaks inside a sell zone)
    if not na(ph)
        int   i2 = bar_index - pR
        float p2 = ph
        if not na(lastPH)
            int   gap = i2 - lastPHi
            float p1  = lastPH
            if gap >= minGap and gap <= maxGap and math.abs(p2 - p1) <= eqTolAtr * atrM
                float neck    = low[pR + 1]
                int   neckOff = pR + 1
                float maxMid  = high[pR + 1]
                for k = pR + 1 to pR + gap - 1
                    if low[k] < neck
                        neck    := low[k]
                        neckOff := k
                    maxMid := math.max(maxMid, high[k])
                float top2 = math.max(p1, p2)
                if maxMid <= top2 and math.min(p1, p2) - neck >= minDepthAtr * atrM
                    string zn = validateZones(p1, p2, -1, zTol, lastPHi)
                    if zn != ""
                        drawPattern(lastPHi, p1, bar_index - neckOff, neck, i2, p2, -1)
                        if trigger == "Second peak confirmed"
                            sig     := -1
                            sigZone := zn
                        else
                            pendDir  := -1
                            pendNeck := neck
                            pendInv  := top2
                            pendExp  := bar_index + neckExpiry
                            pendZone := zn
        lastPH  := p2
        lastPHi := i2

    // Double bottom -> BUY (both lows inside a buy zone)
    if not na(pl)
        int   j2 = bar_index - pR
        float q2 = pl
        if not na(lastPL)
            int   gap = j2 - lastPLi
            float q1  = lastPL
            if gap >= minGap and gap <= maxGap and math.abs(q2 - q1) <= eqTolAtr * atrM
                float neck    = high[pR + 1]
                int   neckOff = pR + 1
                float minMid  = low[pR + 1]
                for k = pR + 1 to pR + gap - 1
                    if high[k] > neck
                        neck    := high[k]
                        neckOff := k
                    minMid := math.min(minMid, low[k])
                float bot2 = math.min(q1, q2)
                if minMid >= bot2 and neck - math.max(q1, q2) >= minDepthAtr * atrM
                    string zn = validateZones(q1, q2, 1, zTol, lastPLi)
                    if zn != ""
                        drawPattern(lastPLi, q1, bar_index - neckOff, neck, j2, q2, 1)
                        if trigger == "Second peak confirmed"
                            sig     := 1
                            sigZone := zn
                        else
                            pendDir  := 1
                            pendNeck := neck
                            pendInv  := bot2
                            pendExp  := bar_index + neckExpiry
                            pendZone := zn
        lastPL  := q2
        lastPLi := j2

// ─────────────────────────────────────────────────────────────────────────────
// Entry: SL / TP boxes, labels, alerts
// ─────────────────────────────────────────────────────────────────────────────
bool buyFired  = false
bool sellFired = false

if sig != 0 and not (oneTrade and openCount > 0)
    float entry = close
    float sl    = entry - sig * slPts * pt
    float tp    = entry + sig * tpPts * pt
    box rb = box.new(bar_index, math.max(entry, sl), bar_index + 1, math.min(entry, sl),
         border_color = color.new(color.red, 50), bgcolor = color.new(color.red, 85),
         text = "SL " + str.tostring(sl, format.mintick), text_color = color.new(color.red, 0),
         text_size = size.small, text_halign = text.align_left)
    box wb = box.new(bar_index, math.max(entry, tp), bar_index + 1, math.min(entry, tp),
         border_color = color.new(color.green, 50), bgcolor = color.new(color.green, 85),
         text = "TP " + str.tostring(tp, format.mintick), text_color = color.new(color.green, 0),
         text_size = size.small, text_halign = text.align_left)
    array.push(trades, Trade.new(sig, entry, sl, tp, bar_index, rb, wb))
    string side = sig == 1 ? "BUY" : "SELL"
    label.new(bar_index, sig == 1 ? low : high,
         side + " · " + sigZone + "\nEntry " + str.tostring(entry, format.mintick) +
         "\nSL " + str.tostring(sl, format.mintick) + "\nTP " + str.tostring(tp, format.mintick),
         style = sig == 1 ? label.style_label_up : label.style_label_down,
         color = sig == 1 ? color.blue : color.red, textcolor = color.white, size = size.small)
    buyFired  := sig == 1
    sellFired := sig == -1
    alert(syminfo.ticker + " " + side + " (" + (sig == 1 ? "double bottom" : "double top") + " in " + sigZone + " zone)" +
         " | Entry " + str.tostring(entry, format.mintick) + " | SL " + str.tostring(sl, format.mintick) +
         " | TP " + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)

plotshape(buyFired, "Buy signal", shape.triangleup, location.belowbar, color.blue, size = size.tiny)
plotshape(sellFired, "Sell signal", shape.triangledown, location.abovebar, color.red, size = size.tiny)

alertcondition(buyFired, "KZ Buy", "Double bottom in buy zone — BUY {{ticker}} @ {{close}}")
alertcondition(sellFired, "KZ Sell", "Double top in sell zone — SELL {{ticker}} @ {{close}}")

// Keep live zones extended to the current bar
if barstate.islast
    int ext = time + 10 * timeframe.in_seconds() * 1000
    for z in zones
        box.set_right(z.bx, ext)

// ─────────────────────────────────────────────────────────────────────────────
// Stats table
// ─────────────────────────────────────────────────────────────────────────────
var table tb = table.new(position.top_right, 2, 9, bgcolor = color.new(color.black, 20),
     border_color = color.new(color.gray, 70), border_width = 1)

if barstate.islast and showStats
    int total = wins + losses
    color tc  = color.white
    table.cell(tb, 0, 0, "KZ Pattern Entry", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 0, "", text_color = tc, text_size = size.small)
    table.cell(tb, 0, 1, "Pattern TF", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 1, isM30 ? "M30 ✓" : "Switch chart to M30", text_color = isM30 ? color.lime : color.orange, text_size = size.small)
    table.cell(tb, 0, 2, "Zones", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 2, allZones ? "Red RES/DBD · Blue SUP/RBR · Grey BRK" : "Red SNR+DBD · Blue SNR+RBR · Grey BRK", text_color = tc, text_size = size.small)
    int nFresh = 0
    int nPlay  = 0
    for z in zones
        if z.state == 0
            nFresh += 1
        else if z.state == 1
            nPlay += 1
    table.cell(tb, 0, 7, "Fresh / in play", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 7, str.tostring(nFresh) + " / " + str.tostring(nPlay), text_color = tc, text_size = size.small)
    table.cell(tb, 0, 3, "SL / TP", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 3, str.tostring(slPts) + " / " + str.tostring(tpPts) + " pts  (" +
         str.tostring(slPts * pt, format.mintick) + " / " + str.tostring(tpPts * pt, format.mintick) + ")",
         text_color = tc, text_size = size.small)
    table.cell(tb, 0, 4, "Trades", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 4, str.tostring(total) + "  (open " + str.tostring(openCount) + ")", text_color = tc, text_size = size.small)
    table.cell(tb, 0, 5, "Wins / Losses", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 5, str.tostring(wins) + " / " + str.tostring(losses), text_color = tc, text_size = size.small)
    table.cell(tb, 0, 6, "Win rate", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 6, total > 0 ? str.tostring(100.0 * wins / total, "#.0") + "%" : "–", text_color = tc, text_size = size.small)
