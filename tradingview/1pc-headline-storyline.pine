// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//@version=6
//
// 1PC Headline & Storyline Indicator
//   Headline  = the H4 / H1 / M30 key zone (supply & demand: SNR with DBD / RBR)
//   Storyline = what price does when it comes back to that zone (M / W on M15 or M30 -> PREPARE -> ENTRY)
//
// Flow
//   1. Fresh key zones (rectangles) on H4, H1 and M30 (H4 solid border, H1 dashed, M30 dotted):
//        SNR (DBD/RBR)  a swing level that price left with a DBD or RBR (red supply / blue demand)
//        base (DBD/RBR) the base itself on M30 / H1 (grey), e.g. "M30 base (DBD)"
//        breakout       an H4 / H1 swing level (or any zone) that a candle of its timeframe closed
//                       through, coloured by its new role, e.g. "H4 breakout"
//      Only the nearest zones to current price are shown; a zone is removed once price has come
//      back to it and moved away again. Where zones overlap, the higher timeframe wins:
//        SNR + DBD   swing high -> drop -> base (shallow bounce) -> second drop below the base
//                    -> red zone at the swing high (resistance / sell zone)
//        SNR + RBR   swing low -> rally -> base (shallow pullback) -> second rally above the base
//                    -> blue zone at the swing low (support / buy zone)
//        Breakout    a close through a zone on its own timeframe makes it a breakout zone and flips its role
//                    (broken resistance -> support, broken support -> resistance); its retest is fresh.
//   2. Entry (M15 or M30 chart), on FRESH zones only. When price reaches a zone for the first time:
//        smart zone entry  follow the extreme inside the zone; when a candle closes back through
//                          the extreme candle, PREPARE a limit at 50% of that rejection move,
//                          inside the zone, with a 0-100 setup score
//        M / W pattern     a double top in a sell zone / double bottom in a buy zone; PREPARE a
//                          limit at the neckline once it breaks
//      ENTRY when the limit fills; the zone becomes VALID. A zone whose first approach ends without
//      an entry is TESTED and removed.
//   3. Risk: fixed stop loss / take profit in points (default 600 / 1000).
//   4. Optional AI second opinion: with "Send alerts as JSON" on, the alert webhook goes to the
//      1PC AI signal service (tradingview/ai-signal-service), where Claude reviews each setup and
//      answers with its own entry price inside the zone.
//
indicator("1PC Headline & Storyline Indicator", shorttitle = "1PC H&S", overlay = true, scale = scale.right,
     max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

// ─────────────────────────────────────────────────────────────────────────────
// Inputs
// ─────────────────────────────────────────────────────────────────────────────
grpZ = "1 · H4 / H1 / M30 key zones (SNR with DBD / RBR)"
useH4        = input.bool(true, "H4", inline = "tf", group = grpZ)
useH1        = input.bool(true, "H1", inline = "tf", group = grpZ)
useM30       = input.bool(true, "M30 zones", inline = "tf", group = grpZ)
swLen        = input.int(3, "Swing strength (bars each side)", minval = 1, maxval = 10, group = grpZ)
m30Right     = input.int(1, "M30 swing confirmation (candles to the right)", minval = 1, maxval = 10, group = grpZ,
     tooltip = "M30 bases are short, so an M30 swing low/high is confirmed after this many candles (H4 and H1 use the swing strength on both sides).")
minMoveAtr   = input.float(2.0, "Min first drop / rally (× zone TF ATR)", minval = 0.5, step = 0.25, group = grpZ,
     tooltip = "Size of the first leg away from the swing level, e.g. the drop from the swing high in a DBD.")
maxRetr      = input.float(0.8, "Max base bounce (fraction of first leg)", minval = 0.1, maxval = 1.0, step = 0.05, group = grpZ,
     tooltip = "The base may retrace at most this much of the first leg. Deeper retracements are not a base.")
maxBaseBars  = input.int(50, "Max base length (bars of the zone TF)", minval = 2, maxval = 200, group = grpZ)
minZoneAtr   = input.float(1.0, "Min zone height (× zone TF ATR)", minval = 0.0, step = 0.1, group = grpZ,
     tooltip = "A zone runs from the swing wick to the candle body, and is made at least this tall.")
nearCount    = input.int(0, "Nearest zones to current price, per timeframe (above / below)", minval = 0, maxval = 10, group = grpZ,
     tooltip = "Keeps the chart around the current market price: on each of H4, H1 and M30, only this many zones above price and this many below are shown (a zone price is inside is always shown). 0 = show all zones.")
maxAgeDays   = input.int(4, "Only show zones from the last (trading days)", minval = 1, maxval = 365, group = grpZ,
     tooltip = "A zone is removed once the swing it starts at is older than this many trading days (Saturdays and Sundays don't count).")
perType      = input.int(6, "Max zones per type and TF (newest kept)", minval = 1, maxval = 20, group = grpZ,
     tooltip = "At most this many red (SNR + DBD) and this many blue (SNR + RBR) zones on each timeframe; older ones are removed first.")
mergeOverlap = input.bool(true, "Merge duplicates (same kind, same timeframe)", group = grpZ,
     tooltip = "A new zone that overlaps a zone of the same kind on the same timeframe is not drawn twice; a newer breakout replaces the older one, and an SND zone replaces the plain SNR level at the same swing.")
keepDead     = input.bool(false, "Keep invalidated zones on chart", group = grpZ)
hideTested   = input.bool(true, "Only fresh zones (remove a zone once it has been tested)", group = grpZ,
     tooltip = "A zone is removed once price has come back to it and then moved away again (or once it gave its entry and price moved away). A breakout (grey) zone is fresh again until its retest.")

showBases       = input.bool(true, "Mark DBD / RBR bases", group = grpZ,
     tooltip = "Also draws the base itself (the sideways part between the two drops or rallies) as a grey zone, e.g. 'M30 base (DBD)'.")
showLevels      = input.bool(true, "Mark SNR levels (swing highs / lows)", group = grpZ,
     tooltip = "Every swing high (resistance) and swing low (support) on H4, H1 and M30 that price reacted from by at least the reaction below.")
snrReact        = input.float(1.0, "SNR level: min reaction (× ATR)", minval = 0.0, step = 0.25, group = grpZ)
showLevelBreaks = input.bool(true, "Mark breakouts", group = grpZ,
     tooltip = "When a candle closes through an H4, H1 or M30 swing high or low (SNR), the level is marked as a breakout zone, e.g. 'H4 breakout'.")
hideLowerTf     = input.bool(false, "Hide lower-TF zones under higher-TF zones", group = grpZ,
     tooltip = "Off = every timeframe's zones are drawn. On = an H1 / M30 zone that overlaps an H4 zone (or an M30 zone under an H1 zone) is hidden.")

grpC = "Zone colours"
colRes       = input.color(color.new(color.red, 85), "Resistance / supply", group = grpC)
colSup       = input.color(color.new(color.blue, 85), "Support / demand", group = grpC)
colBase      = input.color(color.new(color.gray, 80), "DBD / RBR base", group = grpC)
brkRoleColor = input.bool(true, "Colour breakouts by their new role (red = now resistance, blue = now support)", group = grpC)
colBrk       = input.color(color.new(color.gray, 75), "Breakout (when not coloured by role)", group = grpC)
showZoneText = input.bool(true, "Show zone labels", group = grpC)
showStatus   = input.bool(false, "Add status to labels (fresh / in play / valid)", group = grpC)

grpP = "2 · Entry on M1 / M5 / M15 / M30 (M = sell, W = buy)"
showEntries  = input.bool(true, "Show entries (patterns, signals, SL/TP)", group = grpP,
     tooltip = "Off = zones only. On = smart zone entries and M / W patterns on M1, M5, M15 or M30 charts, with signals.")
pL           = input.int(3, "Pattern pivot left bars", minval = 1, group = grpP)
pR           = input.int(2, "Pattern pivot right bars", minval = 1, group = grpP)
minGap       = input.int(2, "Min bars between the two tops", minval = 2, group = grpP)
maxGap       = input.int(40, "Max bars between the two tops", minval = 3, maxval = 300, group = grpP)
eqTolAtr     = input.float(0.5, "2nd top may be higher than the 1st by (× ATR)", minval = 0.0, step = 0.05, group = grpP,
     tooltip = "M: the second top can be lower than the first, or higher by at most this much. W: the same for bottoms.")
recoverPct   = input.float(0.5, "2nd top must climb back at least (of the dip)", minval = 0.1, maxval = 1.0, step = 0.05, group = grpP,
     tooltip = "M: from the neckline, the second top must climb back at least this fraction of the first top's height above the neckline.")
minDepthAtr  = input.float(0.75, "Min height of 1st top above neckline (× ATR)", minval = 0.0, step = 0.05, group = grpP)
zoneTolAtr   = input.float(0.25, "Zone touch tolerance (× ATR)", minval = 0.0, step = 0.05, group = grpP)
leaveAtr     = input.float(1.0, "Fresh zone: approach ends when price moves away (× zone TF ATR)", minval = 0.25, step = 0.25, group = grpP,
     tooltip = "A zone only counts on its first approach. The approach starts when price first reaches the zone and ends when price moves this far away from it. Both tops of the pattern must form during that approach. If none forms, the zone is marked TESTED and gives no more signals.")
trigger      = input.string("Neckline retest", "Entry", options = ["Neckline retest", "Neckline break", "Second top"], group = grpP,
     tooltip = "Neckline retest: PREPARE signal when a candle closes through the neckline, ENTRY when price comes back to the neckline (limit entry at the neckline).")
neckExpiry   = input.int(20, "Neckline break must happen within (bars)", minval = 1, group = grpP)
retestExpiry = input.int(16, "Retest must happen within (bars after the break)", minval = 1, group = grpP)
retestTolAtr = input.float(0.15, "Retest tolerance (× ATR)", minval = 0.0, step = 0.05, group = grpP,
     tooltip = "The retest counts if price gets this close to the neckline.")
allowBrk    = input.bool(true, "Allow entries at breakout zones", group = grpP)
entryMode   = input.string("Smart zone entry + M/W", "Entry method", options = ["Smart zone entry + M/W", "Smart zone entry only", "M/W pattern only"], group = grpP,
     tooltip = "Smart zone entry: when price reaches a fresh zone, the indicator reads the reaction (the extreme inside the zone, the rejection wick and the candle that closes back through the extreme candle) and gives an exact limit price inside the zone. M/W: the double top / double bottom with neckline break and retest.")
smartFib    = input.float(0.5, "Smart entry: retracement of the rejection move", minval = 0.236, maxval = 0.786, step = 0.05, group = grpP,
     tooltip = "After the rejection, the limit price is placed at this retracement of the move from the extreme to the rejection candle's low (high for buys), kept inside the zone.")
smartExpiry = input.int(16, "Smart entry: rejection must come within (bars)", minval = 2, group = grpP)

grpA = "4 · AI second opinion (webhook)"
aiJson      = input.bool(false, "Send alerts as JSON for the AI service", group = grpA,
     tooltip = "Turn on when the alert's webhook points at the 1PC AI signal service. Every alert message becomes JSON with the setup, the zone and the last candles, and Claude replies with its own entry price on the service's page.")
aiCandles   = input.int(40, "Candles to send to the AI", minval = 10, maxval = 80, group = grpA)

grpL = "5 · Live signal at current price"
showLive    = input.bool(true, "Show the live signal at current price", group = grpL,
     tooltip = "At the right edge of the chart: the trade you're in, the limit order waiting for a fill, or the plan at the nearest zone above (sell) and below (buy) with exact entry, SL and TP. Updates on every tick.")
liveEntry   = input.string("Zone 50%", "Live plan entry price", options = ["Zone 50%", "Zone edge (first touch)"], group = grpL,
     tooltip = "Where the plan puts the limit before price has reached the zone: the middle of the zone, or its near edge. Once price reacts inside the zone, the smart entry replaces it with the exact rejection-based price.")
showHistory = input.bool(false, "Keep past signals on the chart", group = grpL,
     tooltip = "Off = only the latest signal is drawn, so the chart shows what matters at current price.")

grpR = "3 · Risk management"
slPts      = input.int(600, "Stop loss (points)", minval = 1, group = grpR)
tpPts      = input.int(1000, "Take profit (points)", minval = 1, group = grpR)
ptOverride = input.float(0.0, "Point size override (0 = auto)", minval = 0.0, step = 0.00001, group = grpR,
     tooltip = "Auto: 1 point = 0.01 on gold (XAU / GOLD), so 600 points = $6 like on MT5, even when the TradingView feed quotes 3 decimals; on other symbols 1 point = the symbol's smallest price step (EURUSD: 0.00001).")
oneTrade   = input.bool(true, "One trade at a time", group = grpR)
showStats  = input.bool(true, "Show stats table", group = grpR)

// ─────────────────────────────────────────────────────────────────────────────
// Zone scan (runs on H4 and on H1 through request.security)
//
//   SNR + DBD: swing high H0 -> first drop to swing low L1 (>= minMove × ATR)
//              -> base: price bounces but stays below H0 and retraces <= maxRetr of the drop
//              -> second drop: an H4 close below L1  => resistance zone at H0
//   SNR + RBR: mirror image                           => support zone at the swing low
//
// Values are returned with a [1] offset and requested with lookahead_on, so only closed H4 / H1
// candles are used: no repainting.
// ─────────────────────────────────────────────────────────────────────────────
// Remove element i from six parallel arrays (one structure candidate)
pop6(array<float> a, array<float> b, array<int> c, array<float> d, array<int> e, array<float> f, int i) =>
    array.remove(a, i)
    array.remove(b, i)
    array.remove(c, i)
    array.remove(d, i)
    array.remove(e, i)
    array.remove(f, i)
    true

// fast = M30 mode: the first leg is measured from the extreme of the last 20 candles, a weak close
// through the base only extends it (the second leg needs a candle body of at least 0.5 × ATR), and
// the newest base wins. levels = also track breakouts of plain swing levels.
zoneScan(int len, int rgt, float minMove, float retr, int maxBase, float minH, bool fast, bool levels, float react) =>
    float atr   = ta.atr(14)
    float ph    = ta.pivothigh(high, len, rgt)
    float pl    = ta.pivotlow(low, len, rgt)
    float hhLen = ta.highest(high, rgt)
    float llLen = ta.lowest(low, rgt)

    // Top of the current up-leg (highest swing high since the last swing low) and bottom of the
    // current down-leg (lowest swing low since the last swing high). A DBD is measured from the
    // top of the whole leg, not from a small swing high part-way down the drop (and vice versa).
    var float legHiP = na
    var float legHiB = na
    var int   legHiT = na
    var int   legHiI = na
    var float legLoP = na
    var float legLoB = na
    var int   legLoT = na
    var int   legLoI = na

    // DBDs in progress (several at once): swing high H0 (+ body, time) -> swing low L1 (+ bar), base high so far
    var array<float> dH0   = array.new<float>()
    var array<float> dH0B  = array.new<float>()
    var array<int>   dH0T  = array.new<int>()
    var array<float> dL1   = array.new<float>()
    var array<int>   dL1I  = array.new<int>()
    var array<float> dBase = array.new<float>()
    // RBRs in progress: swing low L0 (+ body, time) -> swing high H1 (+ bar), base low so far
    var array<float> uL0   = array.new<float>()
    var array<float> uL0B  = array.new<float>()
    var array<int>   uL0T  = array.new<int>()
    var array<float> uH1   = array.new<float>()
    var array<int>   uH1I  = array.new<int>()
    var array<float> uBase = array.new<float>()
    // Plain swing levels (SNR) waiting to be broken: 1 = swing high (resistance), -1 = swing low (support)
    var array<float> lvTop = array.new<float>()
    var array<float> lvBot = array.new<float>()
    var array<int>   lvT   = array.new<int>()
    var array<int>   lvI   = array.new<int>()
    var array<int>   lvDir = array.new<int>()

    float resTop = na    // SNR + DBD: zone at the swing high the drop started from
    float resBot = na
    int   resT   = na
    float supTop = na    // SNR + RBR: zone at the swing low the rally started from
    float supBot = na
    int   supT   = na
    float dbTop  = na    // DBD base: the sideways part between the two drops
    float dbBot  = na
    int   dbT    = na
    float rbTop  = na    // RBR base: the sideways part between the two rallies
    float rbBot  = na
    int   rbT    = na
    float bkTop  = na    // breakout: a swing level closed through on this timeframe
    float bkBot  = na
    int   bkT    = na
    int   bkRole = 0     // its new role: 1 = now support, -1 = now resistance
    float hiTop  = na    // plain SNR: a swing high confirmed on this bar (resistance)
    float hiBot  = na
    int   hiT    = na
    float loTop  = na    // plain SNR: a swing low confirmed on this bar (support)
    float loBot  = na
    int   loT    = na

    // Progress DBDs: second drop (close below L1) confirms; new high above H0, too-deep bounce or too-long base cancels
    if array.size(dL1) > 0
        for i = array.size(dL1) - 1 to 0
            float h0   = array.get(dH0, i)
            float l1   = array.get(dL1, i)
            bool  done = false
            if high > h0 or bar_index - array.get(dL1I, i) > maxBase
                done := true
            else if close < l1 and (not fast or open - close >= 0.5 * atr)
                if not fast or na(resT)
                    resTop := h0
                    resBot := math.min(array.get(dH0B, i), h0 - minH * atr)
                    resT   := array.get(dH0T, i)
                    float bh = array.get(dBase, i)
                    float bm = (bh + l1) / 2
                    dbTop := math.max(bh, bm + minH * atr / 2)
                    dbBot := math.min(l1, bm - minH * atr / 2)
                    dbT   := time[bar_index - array.get(dL1I, i)]
                done := true
            else
                float bs = math.max(array.get(dBase, i), high)
                array.set(dBase, i, bs)
                if fast
                    l1 := math.min(l1, low)
                    array.set(dL1, i, l1)
                if bs - l1 > retr * (h0 - l1)
                    done := true
            if done
                pop6(dH0, dH0B, dH0T, dL1, dL1I, dBase, i)

    // Progress RBRs: second rally (close above H1) confirms
    if array.size(uH1) > 0
        for i = array.size(uH1) - 1 to 0
            float l0   = array.get(uL0, i)
            float h1   = array.get(uH1, i)
            bool  done = false
            if low < l0 or bar_index - array.get(uH1I, i) > maxBase
                done := true
            else if close > h1 and (not fast or close - open >= 0.5 * atr)
                if not fast or na(supT)
                    supBot := l0
                    supTop := math.max(array.get(uL0B, i), l0 + minH * atr)
                    supT   := array.get(uL0T, i)
                    float bl = array.get(uBase, i)
                    float bm = (bl + h1) / 2
                    rbTop := math.max(h1, bm + minH * atr / 2)
                    rbBot := math.min(bl, bm - minH * atr / 2)
                    rbT   := time[bar_index - array.get(uH1I, i)]
                done := true
            else
                float bs = math.min(array.get(uBase, i), low)
                array.set(uBase, i, bs)
                if fast
                    h1 := math.max(h1, high)
                    array.set(uH1, i, h1)
                if h1 - bs > retr * (h1 - l0)
                    done := true
            if done
                pop6(uL0, uL0B, uL0T, uH1, uH1I, uBase, i)

    // Breakouts of plain swing levels: a close through the level flips its role
    if levels and array.size(lvTop) > 0
        for i = array.size(lvTop) - 1 to 0
            int  dir  = array.get(lvDir, i)
            bool gone = bar_index - array.get(lvI, i) > 4 * maxBase
            if (dir == 1 and close > array.get(lvTop, i)) or (dir == -1 and close < array.get(lvBot, i))
                if na(bkT)
                    bkTop  := array.get(lvTop, i)
                    bkBot  := array.get(lvBot, i)
                    bkT    := array.get(lvT, i)
                    bkRole := dir
                gone := true
            if gone
                array.remove(lvTop, i)
                array.remove(lvBot, i)
                array.remove(lvT, i)
                array.remove(lvI, i)
                array.remove(lvDir, i)

    // New swing low that ends a big drop -> DBD candidate. The drop starts at the top of the leg
    // (fast mode: at the highest high of the last 20 candles before the swing low).
    if not na(pl)
        int   iL  = bar_index - rgt
        float oP  = legHiP
        float oB  = legHiB
        int   oT  = legHiT
        bool  oOk = not na(legHiI) and legHiI < iL
        if fast
            int ko = rgt + 1
            for k = rgt + 1 to rgt + 20
                if high[k] > high[ko]
                    ko := k
            oP  := high[ko]
            oB  := math.max(open[ko], close[ko])
            oT  := time[ko]
            oOk := true
        if oOk and oP - pl >= minMove * atr and hhLen - pl <= retr * (oP - pl)
            int k = array.indexof(dH0T, oT)
            if k >= 0
                pop6(dH0, dH0B, dH0T, dL1, dL1I, dBase, k)
            array.push(dH0, oP)
            array.push(dH0B, oB)
            array.push(dH0T, oT)
            array.push(dL1, pl)
            array.push(dL1I, iL)
            array.push(dBase, hhLen)
            if array.size(dL1) > 5
                pop6(dH0, dH0B, dH0T, dL1, dL1I, dBase, 0)
        legHiP := na
        legHiB := na
        legHiT := na
        legHiI := na
        if na(legLoP) or pl < legLoP
            legLoP := pl
            legLoB := math.min(open[rgt], close[rgt])
            legLoT := time[rgt]
            legLoI := iL
        // plain SNR support, when price reacted from it by at least react × ATR
        if hhLen - pl >= react * atr
            loBot := pl
            loTop := math.max(math.min(open[rgt], close[rgt]), pl + minH * atr)
            loT   := time[rgt]
        // remember the swing low as a support level (wick to body, at least minH × ATR tall)
        array.push(lvBot, pl)
        array.push(lvTop, math.max(math.min(open[rgt], close[rgt]), pl + minH * atr))
        array.push(lvT, time[rgt])
        array.push(lvI, iL)
        array.push(lvDir, -1)

    // New swing high that ends a big rally -> RBR candidate (fast mode: the rally starts at the
    // lowest low of the last 20 candles before the swing high)
    if not na(ph)
        int   iH  = bar_index - rgt
        float oP  = legLoP
        float oB  = legLoB
        int   oT  = legLoT
        bool  oOk = not na(legLoI) and legLoI < iH
        if fast
            int ko = rgt + 1
            for k = rgt + 1 to rgt + 20
                if low[k] < low[ko]
                    ko := k
            oP  := low[ko]
            oB  := math.min(open[ko], close[ko])
            oT  := time[ko]
            oOk := true
        if oOk and ph - oP >= minMove * atr and ph - llLen <= retr * (ph - oP)
            int k = array.indexof(uL0T, oT)
            if k >= 0
                pop6(uL0, uL0B, uL0T, uH1, uH1I, uBase, k)
            array.push(uL0, oP)
            array.push(uL0B, oB)
            array.push(uL0T, oT)
            array.push(uH1, ph)
            array.push(uH1I, iH)
            array.push(uBase, llLen)
            if array.size(uH1) > 5
                pop6(uL0, uL0B, uL0T, uH1, uH1I, uBase, 0)
        legLoP := na
        legLoB := na
        legLoT := na
        legLoI := na
        if na(legHiP) or ph > legHiP
            legHiP := ph
            legHiB := math.max(open[rgt], close[rgt])
            legHiT := time[rgt]
            legHiI := iH
        // plain SNR resistance
        if ph - llLen >= react * atr
            hiTop := ph
            hiBot := math.min(math.max(open[rgt], close[rgt]), ph - minH * atr)
            hiT   := time[rgt]
        // remember the swing high as a resistance level
        array.push(lvTop, ph)
        array.push(lvBot, math.min(math.max(open[rgt], close[rgt]), ph - minH * atr))
        array.push(lvT, time[rgt])
        array.push(lvI, iH)
        array.push(lvDir, 1)

    if array.size(lvTop) > 16
        array.shift(lvTop)
        array.shift(lvBot)
        array.shift(lvT)
        array.shift(lvI)
        array.shift(lvDir)

    [resTop[1], resBot[1], resT[1], supTop[1], supBot[1], supT[1], dbTop[1], dbBot[1], dbT[1], rbTop[1], rbBot[1], rbT[1], bkTop[1], bkBot[1], bkT[1], bkRole[1], hiTop[1], hiBot[1], hiT[1], loTop[1], loBot[1], loT[1], close[1], atr[1]]

[rTop, rBot, rT, sTop, sBot, sT, dTop, dBot, dT, uTop, uBot, uT, bTop, bBot, bT, bRole, xhTop, xhBot, xhT, xlTop, xlBot, xlT, h4C, h4Atr] = request.security(syminfo.tickerid, "240", zoneScan(swLen, swLen, minMoveAtr, maxRetr, maxBaseBars, minZoneAtr, false, true, snrReact), lookahead = barmerge.lookahead_on)
[r1Top, r1Bot, r1T, s1Top, s1Bot, s1T, d1Top, d1Bot, d1T, u1Top, u1Bot, u1T, b1Top, b1Bot, b1T, b1Role, x1hTop, x1hBot, x1hT, x1lTop, x1lBot, x1lT, h1C, h1Atr] = request.security(syminfo.tickerid, "60", zoneScan(swLen, swLen, minMoveAtr, maxRetr, maxBaseBars, minZoneAtr, false, true, snrReact), lookahead = barmerge.lookahead_on)
[rmTop, rmBot, rmT, smTop, smBot, smT, dmTop, dmBot, dmT, umTop, umBot, umT, bmTop, bmBot, bmT, bmRole, xmhTop, xmhBot, xmhT, xmlTop, xmlBot, xmlT, m30C, m30Atr] = request.security(syminfo.tickerid, "30", zoneScan(swLen, m30Right, minMoveAtr, maxRetr, maxBaseBars, minZoneAtr, true, true, snrReact), lookahead = barmerge.lookahead_on)

h4Ok  = useH4 and timeframe.in_seconds() <= 14400
h1Ok  = useH1 and timeframe.in_seconds() <= 3600
m30Ok = useM30 and timeframe.in_seconds() <= 1800

// ─────────────────────────────────────────────────────────────────────────────
// Zones
// ─────────────────────────────────────────────────────────────────────────────
type Zone
    box    bx
    float  top
    float  bot
    int    role            // 1 = buy zone (support / demand / broken resistance), -1 = sell zone
    string kind
    int    t0                 // time of the candle the zone starts at (left edge)
    string tf                 // "H4", "H1" or "M30"
    bool   isBase     = false // DBD / RBR base zone
    bool   broken     = false // breakout zone
    int    tAge       = na    // age is counted from here (zone start, or the breakout)
    int    cat        = 0     // 0 SND (SNR with DBD / RBR), 1 base, 2 plain SNR level, 3 breakout
    line   mid        = na    // dashed midline of a breakout zone
    bool   armed      = false // price has moved clear of the zone once since it formed
    int    state      = 0     // 0 FRESH (untouched), 1 IN PLAY (first approach), 2 TESTED (no pattern), 3 VALID (pattern formed)
    int    firstTouch = na
    int    leaveBar   = na    // bar where price moved away after the first approach

var array<Zone> zones = array.new<Zone>()
var map<string, int> seen = map.new<string, int>()

// close / ATR of the zone's own timeframe (closed candles), and its rank (higher TF wins)
tfClose(Zone z) => z.tf == "M30" ? m30C : z.tf == "H1" ? h1C : h4C
tfAtr(Zone z)   => z.tf == "M30" ? m30Atr : z.tf == "H1" ? h1Atr : h4Atr
tfRank(string tf) => tf == "H4" ? 3 : tf == "H1" ? 2 : 1

zoneName(Zone z) => z.broken ? z.tf + " breakout" : z.kind

zoneColor(Zone z) =>
    z.broken ? (brkRoleColor ? (z.role == 1 ? colSup : colRes) : colBrk) : z.isBase ? colBase : z.role == 1 ? colSup : colRes

styleZone(Zone z) =>
    color base = zoneColor(z)
    color c    = color.new(base, math.min(100, color.t(base) + (z.state == 2 ? 12 : 0)))
    box.set_bgcolor(z.bx, c)
    box.set_border_color(z.bx, color.new(base, z.state == 2 ? 70 : 20))
    box.set_border_width(z.bx, z.state == 3 ? 2 : 1)
    box.set_border_style(z.bx, z.tf == "M30" ? line.style_dotted : z.tf == "H1" ? line.style_dashed : line.style_solid)
    string st = z.state == 0 ? "fresh" : z.state == 1 ? "in play" : z.state == 2 ? "tested" : "✓ valid"
    box.set_text(z.bx, showZoneText ? zoneName(z) + (showStatus ? " · " + st : "") : "")
    color tcol = z.isBase and not z.broken ? (z.role == 1 ? colSup : colRes) : base
    box.set_text_color(z.bx, color.new(tcol, z.state == 2 ? 50 : 0))
    if z.broken
        float m = (z.top + z.bot) / 2
        if na(z.mid)
            z.mid := line.new(z.t0, m, time, m, xloc = xloc.bar_time, style = line.style_dashed, force_overlay = true)
        line.set_color(z.mid, color.new(base, 10))
    true

killZone(Zone z) =>
    box.delete(z.bx)
    if not na(z.mid)
        line.delete(z.mid)
    true

// zone category (a broken zone counts as a breakout)
zCat(Zone z) => z.broken ? 3 : z.cat
// overlap of at least 30% of the smaller zone's height
zOverlap(float top, float bot, Zone z) => math.min(top, z.top) - math.max(bot, z.bot) > 0.3 * math.min(top - bot, z.top - z.bot)

// cat: 0 SND, 1 base, 2 plain SNR level, 3 breakout
addZone(float top, float bot, int t, int role, string kind, string tf, int cat) =>
    bool brk  = cat == 3
    int  rn   = tfRank(tf)
    bool skip = false
    if mergeOverlap
        for z in zones
            bool ov = zOverlap(top, bot, z) and z.state <= 1
            int  zc = zCat(z)
            if ov and z.role == role
                // the same kind of zone is already there on this timeframe (a plain SNR level also
                // counts as covered by an SND zone at the same swing); a newer breakout replaces the older one
                if z.tf == tf and not brk and (zc == cat or (cat == 2 and zc == 0))
                    skip := true
                if hideLowerTf and tfRank(z.tf) > rn
                    skip := true
            // the original zone is still there and will turn into this breakout zone itself
            if ov and brk and not z.broken and z.role == -role and z.tf == tf
                skip := true
            if skip
                break
    if not skip
        if mergeOverlap and array.size(zones) > 0
            for i = array.size(zones) - 1 to 0
                Zone oz = array.get(zones, i)
                int  oc = zCat(oz)
                bool same = oz.tf == tf and (oc == cat or (cat == 0 and oc == 2))
                if oz.role == role and zOverlap(top, bot, oz) and (same or (hideLowerTf and tfRank(oz.tf) < rn))
                    killZone(oz)
                    array.remove(zones, i)
        Zone nz = Zone.new(box.new(t, top, time, bot, xloc = xloc.bar_time, border_width = 1, force_overlay = true,
             text_size = size.normal, text_valign = text.align_center,
             text_halign = tf == "H4" ? text.align_center : tf == "H1" ? text.align_right : text.align_left),
             top, bot, role, kind, t, tf, cat == 1, brk, brk ? time : t)
        nz.cat := cat
        styleZone(nz)
        array.push(zones, nz)
        int cnt = 0
        for z in zones
            if z.kind == kind
                cnt += 1
        if cnt > perType
            for i = 0 to array.size(zones) - 1
                Zone oz = array.get(zones, i)
                if oz.kind == kind
                    killZone(oz)
                    array.remove(zones, i)
                    break
    true

// add a zone once (the same value repeats on every chart bar until the next higher-TF bar)
addOnce(string key, float top, float bot, int t, int role, string kind, string tf, int cat) =>
    int last = map.contains(seen, key) ? map.get(seen, key) : 0
    if not na(t) and not na(top) and not na(bot) and t != last
        map.put(seen, key, t)
        addZone(top, bot, t, role, kind, tf, cat)
    true

// breakouts first, then SND zones, bases and plain SNR levels (an SND zone replaces the level at its swing)
if h4Ok
    if showLevelBreaks and bRole != 0
        addOnce("H4b", bTop, bBot, bT, bRole, "H4 SNR", "H4", 3)
    addOnce("H4r", rTop, rBot, rT, -1, "H4 SNR (DBD)", "H4", 0)
    addOnce("H4s", sTop, sBot, sT, 1, "H4 SNR (RBR)", "H4", 0)
    if showBases
        addOnce("H4d", dTop, dBot, dT, -1, "H4 base (DBD)", "H4", 1)
        addOnce("H4u", uTop, uBot, uT, 1, "H4 base (RBR)", "H4", 1)
    if showLevels
        addOnce("H4h", xhTop, xhBot, xhT, -1, "H4 resistance", "H4", 2)
        addOnce("H4l", xlTop, xlBot, xlT, 1, "H4 support", "H4", 2)
if h1Ok
    if showLevelBreaks and b1Role != 0
        addOnce("H1b", b1Top, b1Bot, b1T, b1Role, "H1 SNR", "H1", 3)
    addOnce("H1r", r1Top, r1Bot, r1T, -1, "H1 SNR (DBD)", "H1", 0)
    addOnce("H1s", s1Top, s1Bot, s1T, 1, "H1 SNR (RBR)", "H1", 0)
    if showBases
        addOnce("H1d", d1Top, d1Bot, d1T, -1, "H1 base (DBD)", "H1", 1)
        addOnce("H1u", u1Top, u1Bot, u1T, 1, "H1 base (RBR)", "H1", 1)
    if showLevels
        addOnce("H1h", x1hTop, x1hBot, x1hT, -1, "H1 resistance", "H1", 2)
        addOnce("H1l", x1lTop, x1lBot, x1lT, 1, "H1 support", "H1", 2)
if m30Ok
    if showLevelBreaks and bmRole != 0
        addOnce("M30b", bmTop, bmBot, bmT, bmRole, "M30 SNR", "M30", 3)
    addOnce("M30r", rmTop, rmBot, rmT, -1, "M30 SNR (DBD)", "M30", 0)
    addOnce("M30s", smTop, smBot, smT, 1, "M30 SNR (RBR)", "M30", 0)
    if showBases
        addOnce("M30d", dmTop, dmBot, dmT, -1, "M30 base (DBD)", "M30", 1)
        addOnce("M30u", umTop, umBot, umT, 1, "M30 base (RBR)", "M30", 1)
    if showLevels
        addOnce("M30h", xmhTop, xmhBot, xmhT, -1, "M30 resistance", "M30", 2)
        addOnce("M30l", xmlTop, xmlBot, xmlT, 1, "M30 support", "M30", 2)

// Age in trading days between two times (weekends are not counted)
tradeDays(int t0, int t1) =>
    float d = (t1 - t0) / 86400000.0
    d - 2 * math.floor(d / 7) - (dayofweek(t1) < dayofweek(t0) ? 2 : 0)

// Only recent zones: drop zones older than maxAgeDays trading days (breakouts count from the break)
if array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        Zone z = array.get(zones, i)
        if tradeDays(z.tAge, time) > maxAgeDays
            killZone(z)
            array.remove(zones, i)

// Breakouts: a close through a zone on its own timeframe (H4, H1 or M30) turns it into a breakout
// zone, flips its role and makes it fresh again (its first retest can give an entry). A breakout
// zone that is closed back through is removed.
if array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        Zone  z  = array.get(zones, i)
        float zc = tfClose(z)
        if na(zc)
            continue
        if not z.broken
            if (z.role == -1 and zc > z.top) or (z.role == 1 and zc < z.bot)
                z.broken     := true
                z.role       := -z.role
                z.state      := 0
                z.firstTouch := na
                z.leaveBar   := na
                z.armed      := false
                z.tAge       := time
                styleZone(z)
        else if (z.role == 1 and zc < z.bot) or (z.role == -1 and zc > z.top)
            if keepDead
                box.set_right(z.bx, time)
                box.set_bgcolor(z.bx, color.new(color.gray, 92))
                box.set_border_color(z.bx, color.new(color.gray, 80))
                box.set_border_style(z.bx, line.style_dotted)
                box.set_text(z.bx, "")
                if not na(z.mid)
                    line.set_x2(z.mid, time)
            else
                killZone(z)
            array.remove(zones, i)

// Pattern check: both tops inside the zone and both formed during the zone's FIRST approach
// (after first touch, before price moved away). The zone only becomes VALID when a trade
// triggers; a pattern that fails leaves the zone in play for the next one.
findZone(float a, float b, int role, float tol, int i1, int i2) =>
    Zone found = na
    for z in zones
        if z.state == 1 and z.role == role and (allowBrk or not z.broken) and i1 >= z.firstTouch and (na(z.leaveBar) or i2 <= z.leaveBar)
            float lo = z.bot - tol
            float hi = z.top + tol
            if a >= lo and a <= hi and b >= lo and b <= hi
                found := z
                break
    found

markValid(Zone z) =>
    if not na(z)
        z.state := 3
        styleZone(z)
    true

// ─────────────────────────────────────────────────────────────────────────────
// Trades (risk management)
// ─────────────────────────────────────────────────────────────────────────────
type Trade
    int   dir
    float entry
    float sl
    float tp
    int   startBar
    box   riskBx
    box   rewBx
    bool  open = true

var array<Trade> trades = array.new<Trade>()

// Drawings of past signals (removed when a new signal starts, unless "Keep past signals" is on)
var array<label> sigL  = array.new<label>()
var array<line>  sigLn = array.new<line>()
var array<box>   sigB  = array.new<box>()
clearHistory() =>
    while array.size(sigL) > 0
        label.delete(array.pop(sigL))
    while array.size(sigLn) > 0
        line.delete(array.pop(sigLn))
    while array.size(sigB) > 0
        box.delete(array.pop(sigB))
    true
var int wins   = 0
var int losses = 0

isGold = str.contains(str.upper(syminfo.ticker), "XAU") or str.contains(str.upper(syminfo.ticker), "GOLD") or str.startswith(str.upper(syminfo.ticker), "GC")
pt = ptOverride > 0 ? ptOverride : isGold ? 0.01 : syminfo.mintick

int openCount = 0
for t in trades
    if t.open and bar_index > t.startBar
        bool hitSL = t.dir == 1 ? low <= t.sl : high >= t.sl
        bool hitTP = t.dir == 1 ? high >= t.tp : low <= t.tp
        if hitSL or hitTP
            t.open := false
            bool win = hitTP and not hitSL     // both in one candle -> counted as SL (conservative)
            if win
                wins += 1
            else
                losses += 1
            box.set_right(t.riskBx, bar_index)
            box.set_right(t.rewBx, bar_index)
            array.push(sigL, label.new(bar_index, win ? t.tp : t.sl, win ? "TP ✓" : "SL ✗", style = label.style_label_left,
                 color = win ? color.new(color.green, 0) : color.new(color.red, 0), textcolor = color.white, size = size.small, force_overlay = true))
        else
            box.set_right(t.riskBx, bar_index + 1)
            box.set_right(t.rewBx, bar_index + 1)
    if t.open
        openCount += 1

if array.size(trades) > 100 and not array.get(trades, 0).open
    array.shift(trades)

// ─────────────────────────────────────────────────────────────────────────────
// M15 / M30 double top (M) / double bottom (W)
// ─────────────────────────────────────────────────────────────────────────────
isPatTF = timeframe.in_seconds() <= 1800   // signals on M1, M5, M15 and M30 charts
atrM  = ta.atr(14)
ph    = ta.pivothigh(high, pL, pR)
pl    = ta.pivotlow(low, pL, pR)

var float  lastPH   = na
var int    lastPHi  = na
var float  lastPL   = na
var int    lastPLi  = na
// Pattern waiting for its neckline break (stage 1) or neckline retest (stage 2)
var int    pendDir   = 0
var int    pendStage = 0
var float  pendNeck  = na
var float  pendInv   = na
var int    pendExp   = na
var int    pendBrkI  = na
var string pendZone  = ""
var Zone   pendZ     = na
var string pendKind  = ""       // "smart" or "pattern"
var float  pendScore = na
// Smart zone entry waiting for the rejection candle
var int    smDir     = 0
var Zone   smZ       = na
var float  smExt     = na       // extreme reached inside the zone (high for sells, low for buys)
var float  smExOther = na       // low (sells) / high (buys) of the candle that made the extreme
var float  smWick    = 0.0      // rejection wick of that candle, as a share of its range
var int    smStart   = na

drawPattern(int i1, float p1, int iN, float neck, int i2, float p2, int dir) =>
    color c = dir == -1 ? color.red : color.blue
    if not showHistory and openCount == 0
        clearHistory()
    array.push(sigLn, line.new(i1, p1, iN, neck, color = c, width = 2, force_overlay = true))
    array.push(sigLn, line.new(iN, neck, i2, p2, color = c, width = 2, force_overlay = true))
    array.push(sigLn, line.new(i1, neck, bar_index, neck, color = color.new(c, 40), style = line.style_dashed, force_overlay = true))
    array.push(sigL, label.new(i2, p2, dir == -1 ? "DT" : "DB", style = dir == -1 ? label.style_label_down : label.style_label_up,
         color = color.new(color.white, 100), textcolor = c, size = size.small, force_overlay = true))
    true

int    sig      = 0
string sigZone  = ""
string sigKind  = ""     // "smart" or "pattern"
float  entryPx  = na
int    setupDir = 0      // PREPARE signal fired on this bar (limit price known, waiting for the fill)
Zone   newTouch = na     // zone that price reached for the first time on this bar

// Zone freshness (always tracked): FRESH until price first reaches it (-> IN PLAY). The first
// approach ends when price moves leaveAtr × the zone TF's ATR away from the zone. A zone that had
// no entry by then is TESTED; with "Only fresh zones" on, tested zones (and zones that already gave
// their entry, once price has moved away) are removed from the chart.
float zTol = zoneTolAtr * atrM
if array.size(zones) > 0
    for i = array.size(zones) - 1 to 0
        Zone  z     = array.get(zones, i)
        float leave = leaveAtr * nz(tfAtr(z), 3 * atrM)
        if not z.armed
            // touches only count once price has moved clear of the zone after it formed
            if (z.role == -1 and high < z.bot - zTol) or (z.role == 1 and low > z.top + zTol)
                z.armed := true
        else if z.state == 0
            if (z.role == -1 and high >= z.bot - zTol) or (z.role == 1 and low <= z.top + zTol)
                z.state      := 1
                z.firstTouch := bar_index
                styleZone(z)
                if na(newTouch)
                    newTouch := z
        else if (z.state == 1 or z.state == 3) and na(z.leaveBar)
            if (z.role == -1 and low < z.bot - leave) or (z.role == 1 and high > z.top + leave)
                z.leaveBar := bar_index
        else if (z.state == 1 or z.state == 3) and bar_index > z.leaveBar + pR
            if z.state == 1
                z.state := 2
            if hideTested
                killZone(z)
                array.remove(zones, i)
            else
                styleZone(z)

float rTol = retestTolAtr * atrM

useSmart = entryMode != "M/W pattern only"
useMW    = entryMode != "Smart zone entry only"

// rejection wick of the current candle as a share of its range (upper wick for sells, lower for buys)
candleWick(int dir) =>
    float r = high - low
    r > 0 ? (dir == -1 ? high - math.max(open, close) : math.min(open, close) - low) / r : 0.0

// Setup score 0-100: zone timeframe, zone type, rejection wick, strength of the rejection candle,
// first touch, and another timeframe's zone in the same place
smartScore(Zone z, float wick, float bodyAtr) =>
    float sc = (z.tf == "H4" ? 30 : z.tf == "H1" ? 22 : 15) + (z.broken ? 20 : z.cat == 1 ? 14 : z.cat == 2 ? 16 : 18) + 10
    sc += wick >= 0.5 ? 15 : wick >= 0.3 ? 8 : 0
    sc += bodyAtr >= 0.6 ? 15 : bodyAtr >= 0.3 ? 8 : 0
    for o in zones
        if o.tf != z.tf and o.role == z.role and o.top >= z.bot and o.bot <= z.top
            sc += 10
            break
    math.min(100.0, sc)

if showEntries and isPatTF and barstate.isconfirmed
    // Stage 1: wait for a close through the neckline. Stage 2: wait for the retest of the neckline.
    if pendDir != 0
        bool failed = pendDir == -1 ? close > pendInv : close < pendInv
        if pendStage == 1
            if failed or bar_index > pendExp
                pendDir := 0
            else if (pendDir == -1 and close < pendNeck) or (pendDir == 1 and close > pendNeck)
                if trigger == "Neckline break"
                    sig     := pendDir
                    sigZone := pendZone
                    sigKind := pendKind
                    entryPx := close
                    pendDir := 0
                    markValid(pendZ)
                else
                    pendStage := 2
                    pendBrkI  := bar_index
                    pendExp   := bar_index + retestExpiry
                    setupDir  := pendDir
        else
            bool ranAway = pendDir == -1 ? low <= pendNeck - tpPts * pt : high >= pendNeck + tpPts * pt
            if failed or ranAway or bar_index > pendExp
                pendDir := 0
            else if bar_index > pendBrkI and ((pendDir == -1 and high >= pendNeck - rTol) or (pendDir == 1 and low <= pendNeck + rTol))
                sig     := pendDir
                sigZone := pendZone
                sigKind := pendKind
                entryPx := pendDir == -1 ? math.min(pendNeck, high) : math.max(pendNeck, low)
                pendDir := 0
                markValid(pendZ)

    // Smart zone entry. Step 1: price reaches a fresh zone -> follow the extreme it makes inside
    // the zone. Step 2: a candle closes back through the extreme candle (below its low for sells,
    // above its high for buys) -> limit price at smartFib of that rejection move, inside the zone.
    if useSmart and smDir == 0 and pendDir == 0 and not na(newTouch)
        smZ       := newTouch
        smDir     := newTouch.role == -1 ? -1 : 1
        smExt     := smDir == -1 ? high : low
        smExOther := smDir == -1 ? low : high
        smWick    := candleWick(smDir)
        smStart   := bar_index
    else if smDir != 0
        bool smBroke = smDir == -1 ? close > smZ.top + zTol : close < smZ.bot - zTol
        if smBroke or bar_index - smStart > smartExpiry or pendDir != 0
            smDir := 0
        else
            if (smDir == -1 and high > smExt) or (smDir == 1 and low < smExt)
                smExt     := smDir == -1 ? high : low
                smExOther := smDir == -1 ? low : high
                smWick    := candleWick(smDir)
            else if (smDir == -1 and close < open and close < smExOther) or (smDir == 1 and close > open and close > smExOther)
                float mv = smDir == -1 ? smExt - low : high - smExt
                float e  = smDir == -1 ? smExt - smartFib * mv : smExt + smartFib * mv
                e := math.max(smZ.bot, math.min(smZ.top, e))
                if (smDir == -1 and e <= close) or (smDir == 1 and e >= close)
                    e := close
                pendZ     := smZ
                pendDir   := smDir
                pendNeck  := e
                pendInv   := smDir == -1 ? smZ.top + zTol : smZ.bot - zTol
                pendZone  := zoneName(smZ)
                pendStage := 2
                pendBrkI  := bar_index
                pendExp   := bar_index + retestExpiry
                pendKind  := "smart"
                pendScore := smartScore(smZ, smWick, math.abs(close - open) / atrM)
                setupDir  := smDir
                smDir     := 0

    // Double top -> SELL (both peaks inside a sell zone)
    if not na(ph)
        int   i2 = bar_index - pR
        float p2 = ph
        if not na(lastPH)
            int   gap = i2 - lastPHi
            float p1  = lastPH
            if gap >= minGap and gap <= maxGap and p2 <= p1 + eqTolAtr * atrM
                float neck    = low[pR + 1]
                int   neckOff = pR + 1
                float maxMid  = high[pR + 1]
                for k = pR + 1 to pR + gap - 1
                    if low[k] < neck
                        neck    := low[k]
                        neckOff := k
                    maxMid := math.max(maxMid, high[k])
                float top2 = math.max(p1, p2)
                if maxMid <= top2 and p1 - neck >= minDepthAtr * atrM and p2 - neck >= recoverPct * (p1 - neck)
                    Zone zf = useMW and pendDir == 0 ? findZone(p1, p2, -1, zTol, lastPHi, i2) : na
                    if not na(zf)
                        string zn = zoneName(zf)
                        drawPattern(lastPHi, p1, bar_index - neckOff, neck, i2, p2, -1)
                        // the neckline may already be broken in the pR candles after the 2nd top
                        bool brk = false
                        for k = 0 to pR - 1
                            if close[k] < neck
                                brk := true
                        if trigger == "Second top" or (brk and trigger == "Neckline break")
                            sig     := -1
                            sigZone := zn
                            sigKind := "pattern"
                            entryPx := close
                            markValid(zf)
                        else
                            pendZ     := zf
                            pendKind  := "pattern"
                            pendScore := na
                            pendDir   := -1
                            pendNeck  := neck
                            pendInv   := top2
                            pendZone  := zn
                            pendStage := brk ? 2 : 1
                            pendBrkI  := bar_index
                            pendExp   := bar_index + (brk ? retestExpiry : neckExpiry)
                            if brk
                                setupDir := -1
        lastPH  := p2
        lastPHi := i2

    // Double bottom -> BUY (both lows inside a buy zone)
    if not na(pl)
        int   j2 = bar_index - pR
        float q2 = pl
        if not na(lastPL)
            int   gap = j2 - lastPLi
            float q1  = lastPL
            if gap >= minGap and gap <= maxGap and q2 >= q1 - eqTolAtr * atrM
                float neck    = high[pR + 1]
                int   neckOff = pR + 1
                float minMid  = low[pR + 1]
                for k = pR + 1 to pR + gap - 1
                    if high[k] > neck
                        neck    := high[k]
                        neckOff := k
                    minMid := math.min(minMid, low[k])
                float bot2 = math.min(q1, q2)
                if minMid >= bot2 and neck - q1 >= minDepthAtr * atrM and neck - q2 >= recoverPct * (neck - q1)
                    Zone zf = useMW and pendDir == 0 ? findZone(q1, q2, 1, zTol, lastPLi, j2) : na
                    if not na(zf)
                        string zn = zoneName(zf)
                        drawPattern(lastPLi, q1, bar_index - neckOff, neck, j2, q2, 1)
                        bool brk = false
                        for k = 0 to pR - 1
                            if close[k] > neck
                                brk := true
                        if trigger == "Second top" or (brk and trigger == "Neckline break")
                            sig     := 1
                            sigZone := zn
                            sigKind := "pattern"
                            entryPx := close
                            markValid(zf)
                        else
                            pendZ     := zf
                            pendKind  := "pattern"
                            pendScore := na
                            pendDir   := 1
                            pendNeck  := neck
                            pendInv   := bot2
                            pendZone  := zn
                            pendStage := brk ? 2 : 1
                            pendBrkI  := bar_index
                            pendExp   := bar_index + (brk ? retestExpiry : neckExpiry)
                            if brk
                                setupDir := 1
        lastPL  := q2
        lastPLi := j2

// ─────────────────────────────────────────────────────────────────────────────
// Entry: SL / TP boxes, labels, alerts
// ─────────────────────────────────────────────────────────────────────────────
bool buyFired   = false
bool sellFired  = false
bool prepBuy    = setupDir == 1
bool prepSell   = setupDir == -1

// ── JSON helpers for the AI webhook ──
jNum(float x) => na(x) ? "null" : str.tostring(x, format.mintick)
jCandles(int n) =>
    string out = "["
    for i = n - 1 to 0
        out += "[" + str.tostring(time[i]) + "," + jNum(open[i]) + "," + jNum(high[i]) + "," + jNum(low[i]) + "," + jNum(close[i]) + "]" + (i > 0 ? "," : "")
    out + "]"
jZone(Zone z) =>
    na(z) ? "null" : "{\"name\":\"" + zoneName(z) + "\",\"tf\":\"" + z.tf + "\",\"top\":" + jNum(z.top) + ",\"bottom\":" + jNum(z.bot) +
         ",\"role\":\"" + (z.role == -1 ? "resistance" : "support") + "\",\"breakout\":" + (z.broken ? "true" : "false") +
         ",\"base\":" + (z.isBase ? "true" : "false") + "}"
jSetup(string ev, string side, string kind, float entry, float sl, float tp, float score, Zone z) =>
    float za = na(z) ? na : tfAtr(z)
    "{\"event\":\"" + ev + "\",\"source\":\"1PC Headline & Storyline\",\"symbol\":\"" + syminfo.ticker + "\",\"chart_tf\":\"" + timeframe.period +
         "\",\"side\":\"" + side + "\",\"method\":\"" + kind + "\",\"entry\":" + jNum(entry) + ",\"sl\":" + jNum(sl) + ",\"tp\":" + jNum(tp) +
         ",\"score\":" + (na(score) ? "null" : str.tostring(score, "#")) + ",\"zone\":" + jZone(z) + ",\"atr\":" + jNum(atrM) +
         ",\"zone_tf_atr\":" + jNum(za) + ",\"point\":" + str.tostring(pt) + ",\"sl_points\":" + str.tostring(slPts) +
         ",\"tp_points\":" + str.tostring(tpPts) + ",\"time\":" + str.tostring(time) + ",\"candles\":" + jCandles(aiCandles) + "}"

var int    nPrepare  = 0
var string lastSig   = "none yet"

// PREPARE: the limit price is known (smart zone entry, or M / W neckline broken) - place the order
if setupDir != 0
    float  lim   = pendNeck
    float  psl   = lim - setupDir * slPts * pt
    float  ptp   = lim + setupDir * tpPts * pt
    string pside = setupDir == 1 ? "BUY" : "SELL"
    bool   smart = pendKind == "smart"
    string scTxt = na(pendScore) ? "" : " · score " + str.tostring(pendScore, "#")
    if smart and not showHistory and openCount == 0
        clearHistory()
    array.push(sigL, label.new(bar_index, lim, (smart ? "SMART " : "PREPARE ") + pside + " LIMIT\n" + str.tostring(lim, format.mintick) + scTxt,
         style = label.style_label_left, color = color.new(color.orange, 0), textcolor = color.white, size = size.small, force_overlay = true))
    string how = smart ? "smart zone entry" : (setupDir == 1 ? "W / double bottom, neckline broken" : "M / double top, neckline broken")
    nPrepare += 1
    lastSig := pside + " limit " + str.tostring(lim, format.mintick) + " · " + str.format_time(time, "dd MMM HH:mm", syminfo.timezone)
    alert(aiJson ? jSetup("prepare", str.lower(pside), pendKind, lim, psl, ptp, pendScore, pendZ) :
         "1PC PREPARE " + pside + " " + syminfo.ticker + " (" + how + " in " + pendZone + " zone" + scTxt + ") | " + pside + " LIMIT " +
         str.tostring(lim, format.mintick) + " | SL " + str.tostring(psl, format.mintick) + " | TP " + str.tostring(ptp, format.mintick),
         alert.freq_once_per_bar_close)

if sig != 0 and not (oneTrade and openCount > 0)
    float entry = nz(entryPx, close)
    float sl    = entry - sig * slPts * pt
    float tp    = entry + sig * tpPts * pt
    box rb = box.new(bar_index, math.max(entry, sl), bar_index + 1, math.min(entry, sl),
         border_color = color.new(color.red, 50), bgcolor = color.new(color.red, 85),
         text = "SL " + str.tostring(sl, format.mintick), text_color = color.new(color.red, 0),
         text_size = size.small, text_halign = text.align_left, force_overlay = true)
    box wb = box.new(bar_index, math.max(entry, tp), bar_index + 1, math.min(entry, tp),
         border_color = color.new(color.green, 50), bgcolor = color.new(color.green, 85),
         text = "TP " + str.tostring(tp, format.mintick), text_color = color.new(color.green, 0),
         text_size = size.small, text_halign = text.align_left, force_overlay = true)
    array.push(trades, Trade.new(sig, entry, sl, tp, bar_index, rb, wb))
    array.push(sigB, rb)
    array.push(sigB, wb)
    string side = sig == 1 ? "BUY" : "SELL"
    array.push(sigL, label.new(bar_index, entry,
         side + " · " + sigZone + "\nEntry " + str.tostring(entry, format.mintick) +
         "\nSL " + str.tostring(sl, format.mintick) + "\nTP " + str.tostring(tp, format.mintick),
         style = sig == 1 ? label.style_label_up : label.style_label_down,
         color = sig == 1 ? color.blue : color.red, textcolor = color.white, size = size.small, force_overlay = true))
    buyFired  := sig == 1
    sellFired := sig == -1
    string how = sigKind == "smart" ? "smart zone entry" : (sig == 1 ? "W / double bottom" : "M / double top")
    alert(aiJson ? jSetup("entry", str.lower(side), sigKind, entry, sl, tp, float(na), pendZ) :
         "1PC ENTRY " + side + " " + syminfo.ticker + " (" + how + " in " + sigZone + " zone) | Entry " + str.tostring(entry, format.mintick) +
         " | SL " + str.tostring(sl, format.mintick) + " | TP " + str.tostring(tp, format.mintick), alert.freq_once_per_bar_close)

plotshape(buyFired, "Buy signal", shape.triangleup, location.belowbar, color.blue, size = size.tiny, force_overlay = true)
plotshape(sellFired, "Sell signal", shape.triangledown, location.abovebar, color.red, size = size.tiny, force_overlay = true)

alertcondition(prepBuy, "1PC Prepare Buy", "PREPARE BUY {{ticker}}: buy limit set inside a buy zone")
alertcondition(prepSell, "1PC Prepare Sell", "PREPARE SELL {{ticker}}: sell limit set inside a sell zone")
alertcondition(buyFired, "1PC Entry Buy", "ENTRY BUY {{ticker}}: buy limit filled")
alertcondition(sellFired, "1PC Entry Sell", "ENTRY SELL {{ticker}}: sell limit filled")

// Keep live zones extended past the current bar
if barstate.islast
    int ext = time + 40 * timeframe.in_seconds() * 1000
    for z in zones
        box.set_right(z.bx, ext)
        if not na(z.mid)
            line.set_x2(z.mid, ext)

hideZone(Zone z) =>
    color none = color.new(color.white, 100)
    box.set_bgcolor(z.bx, none)
    box.set_border_color(z.bx, none)
    box.set_text_color(z.bx, none)
    if not na(z.mid)
        line.set_color(z.mid, none)
    true

// Only the zones around the current market price: on each timeframe (H4, H1, M30) the nearest
// nearCount zones above and below price (plus any zone price is inside). The others stay
// tracked but are hidden.
nearLimits(string tf) =>
    array<float> up = array.new<float>()
    array<float> dn = array.new<float>()
    for z in zones
        if z.tf == tf
            if z.bot > close
                array.push(up, z.bot - close)
            else if z.top < close
                array.push(dn, close - z.top)
    array.sort(up, order.ascending)
    array.sort(dn, order.ascending)
    [array.size(up) >= nearCount ? array.get(up, nearCount - 1) : 1e10, array.size(dn) >= nearCount ? array.get(dn, nearCount - 1) : 1e10]

if barstate.islast and nearCount > 0 and array.size(zones) > 0
    [lim4u, lim4d] = nearLimits("H4")
    [lim1u, lim1d] = nearLimits("H1")
    [limMu, limMd] = nearLimits("M30")
    for z in zones
        float upLim = z.tf == "H4" ? lim4u : z.tf == "H1" ? lim1u : limMu
        float dnLim = z.tf == "H4" ? lim4d : z.tf == "H1" ? lim1d : limMd
        bool inside = z.bot <= close and z.top >= close
        bool near   = inside or (z.bot > close and z.bot - close <= upLim) or (z.top < close and close - z.top <= dnLim)
        if near
            styleZone(z)
        else
            hideZone(z)

// ─────────────────────────────────────────────────────────────────────────────
// Live signal at current price (redrawn on every tick of the last bar)
// ─────────────────────────────────────────────────────────────────────────────
var array<line>  liveLn = array.new<line>()
var array<label> liveLb = array.new<label>()
string liveTxt = ""

liveLevel(float px, string txt, color c, int w) =>
    array.push(liveLn, line.new(bar_index, px, bar_index + 12, px, color = c, width = w, style = line.style_dashed, force_overlay = true))
    array.push(liveLb, label.new(bar_index + 12, px, txt, style = label.style_label_left, color = c, textcolor = color.white,
         size = size.normal, force_overlay = true))
    true

riskTxt(int dir, float e) =>
    "SL " + str.tostring(e - dir * slPts * pt, format.mintick) + " · TP " + str.tostring(e + dir * tpPts * pt, format.mintick)

if barstate.islast and showLive
    while array.size(liveLn) > 0
        line.delete(array.pop(liveLn))
    while array.size(liveLb) > 0
        label.delete(array.pop(liveLb))
    Trade openT = na
    for t in trades
        if t.open
            openT := t
    if not na(openT)
        string sd = openT.dir == 1 ? "BUY" : "SELL"
        float  pnl = (close - openT.entry) * openT.dir / pt
        liveTxt := "IN TRADE " + sd + " @ " + str.tostring(openT.entry, format.mintick) + " · " + riskTxt(openT.dir, openT.entry) +
             " · " + (pnl >= 0 ? "+" : "") + str.tostring(pnl, "#") + " pts"
        liveLevel(openT.entry, liveTxt, openT.dir == 1 ? color.blue : color.red, 2)
    else if pendDir != 0
        string sd = pendDir == 1 ? "BUY" : "SELL"
        liveTxt := "ACTIVE " + sd + " LIMIT " + str.tostring(pendNeck, format.mintick) + " · " + riskTxt(pendDir, pendNeck) +
             (na(pendScore) ? "" : " · score " + str.tostring(pendScore, "#")) + " · " + pendZone
        liveLevel(pendNeck, liveTxt, color.orange, 2)
    else
        // the plan at the nearest zone above (sell) and below (buy) current price
        Zone up = na
        Zone dn = na
        for z in zones
            if z.role == -1 and z.top >= close and (na(up) or z.bot < up.bot)
                up := z
            if z.role == 1 and z.bot <= close and (na(dn) or z.top > dn.top)
                dn := z
        string parts = ""
        if not na(up)
            float e   = liveEntry == "Zone 50%" ? (up.top + up.bot) / 2 : up.bot
            bool  now = close >= e
            e := now ? close : e
            string tx = (now ? "SELL NOW " : "SELL LIMIT ") + str.tostring(e, format.mintick) + " · " + riskTxt(-1, e) + " · " + zoneName(up) +
                 (now ? "" : " · " + str.tostring((e - close) / pt, "#") + " pts away") + (smDir == -1 ? " · waiting for rejection" : "")
            liveLevel(e, tx, color.new(color.red, 0), 1)
            parts := tx
        if not na(dn)
            float e   = liveEntry == "Zone 50%" ? (dn.top + dn.bot) / 2 : dn.top
            bool  now = close <= e
            e := now ? close : e
            string tx = (now ? "BUY NOW " : "BUY LIMIT ") + str.tostring(e, format.mintick) + " · " + riskTxt(1, e) + " · " + zoneName(dn) +
                 (now ? "" : " · " + str.tostring((close - e) / pt, "#") + " pts away") + (smDir == 1 ? " · waiting for rejection" : "")
            liveLevel(e, tx, color.new(color.blue, 0), 1)
            parts := parts == "" ? tx : parts + "\n" + tx
        liveTxt := parts == "" ? "no fresh zone near price" : parts

// ─────────────────────────────────────────────────────────────────────────────
// Stats table
// ─────────────────────────────────────────────────────────────────────────────
var table tb = table.new(position.top_right, 2, 11, bgcolor = color.new(color.black, 20),
     border_color = color.new(color.gray, 70), border_width = 1)

if barstate.islast and showStats
    int total = wins + losses
    color tc  = color.white
    table.cell(tb, 0, 0, "1PC Headline & Storyline", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 0, "", text_color = tc, text_size = size.small)
    table.cell(tb, 0, 1, "Pattern TF", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 1, isPatTF ? "M" + timeframe.period + " ✓" : "Signals need a chart of 30m or lower (M1, M5, M15, M30)", text_color = isPatTF ? color.lime : color.orange, text_size = size.small)
    table.cell(tb, 0, 2, "Zones", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 2, "H4 solid · H1 dashed · M30 dotted · Red supply · Blue demand · Grey base", text_color = tc, text_size = size.small)
    int nFresh = 0
    int nPlay  = 0
    for z in zones
        if z.state == 0
            nFresh += 1
        else if z.state == 1
            nPlay += 1
    table.cell(tb, 0, 7, "Fresh / in play", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 7, str.tostring(nFresh) + " / " + str.tostring(nPlay), text_color = tc, text_size = size.small)
    table.cell(tb, 0, 3, "SL / TP", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 3, str.tostring(slPts) + " / " + str.tostring(tpPts) + " pts  (" +
         str.tostring(slPts * pt, format.mintick) + " / " + str.tostring(tpPts * pt, format.mintick) + ")",
         text_color = tc, text_size = size.small)
    table.cell(tb, 0, 4, "Trades", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 4, str.tostring(total) + "  (open " + str.tostring(openCount) + ")", text_color = tc, text_size = size.small)
    table.cell(tb, 0, 5, "Wins / Losses", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 5, str.tostring(wins) + " / " + str.tostring(losses), text_color = tc, text_size = size.small)
    string now = not showEntries ? "entries switched off" : not isPatTF ? "signals need a 30m chart or lower" :
         pendDir != 0 ? (pendDir == 1 ? "BUY" : "SELL") + " limit " + str.tostring(pendNeck, format.mintick) + " waiting for fill" :
         smDir != 0 ? "price in " + zoneName(smZ) + ", waiting for rejection candle" : "waiting for price to reach a fresh zone"
    table.cell(tb, 0, 8, "Signals (PREPARE)", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 8, str.tostring(nPrepare) + " · last: " + lastSig, text_color = tc, text_size = size.small)
    table.cell(tb, 0, 9, "Now", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 9, showLive and liveTxt != "" ? liveTxt : now, text_color = color.yellow, text_size = size.small)
    table.cell(tb, 0, 6, "Win rate", text_color = tc, text_size = size.small)
    table.cell(tb, 1, 6, total > 0 ? str.tostring(100.0 * wins / total, "#.0") + "%" : "–", text_color = tc, text_size = size.small)
