//@version=6
// ════════════════════════════════════════════════════════════════════════════
//  88 Sharingan: multi-timeframe setup assistant (built for XAUUSD)
//
//  Direction (Daily / H4) → Key zone (H4 / H1) → LTF confirmation
//  (M30 / M15 / M5 / M1) → Entry.          Core rule: no confirmation, no entry.
//
//  Non-repainting design
//  • Every decision uses CLOSED candles only. Other timeframes are requested as
//    expr[1] with lookahead_on (the standard non-repainting idiom) and the
//    chart's own candle is read as [1]. A signal is therefore evaluated on the
//    first tick after the confirmation candle closes, is drawn on that closed
//    candle, and never changes afterwards.
//  • Swing points (pivots) are only used once they are confirmed, i.e. N bars
//    after the swing. Nothing is back-dated: signals are stamped on the candle
//    whose close completed the confirmation.
//  • Confirmation timeframes lower than the chart timeframe are disabled
//    (shown as N/A). Use an M1 chart for all four, M5 for M5/M15/M30.
//    The chart timeframe must be H1 or lower.
//
//  This is a chart-reading aid. It applies fixed, objective rules and cannot
//  reproduce discretionary judgement.
// ════════════════════════════════════════════════════════════════════════════
indicator("88 Sharingan", shorttitle = "88 Sharingan", overlay = true, max_boxes_count = 200, max_lines_count = 300, max_labels_count = 400, max_polylines_count = 60, max_bars_back = 100)

// ─────────────────────────────── INPUTS ─────────────────────────────────────
const string G_DIR  = "1 · Direction (Daily / H4 / H1)"
const string G_ZONE = "2 · Key zones (H4 / H1)"
const string G_SET  = "3 · Setup rules"
const string G_LTF  = "4 · Confirmation timeframes"
const string G_BO   = "4A · Breakout"
const string G_CP   = "4B · Chart patterns"
const string G_PA   = "4C · Price-action filter (optional)"
const string G_DISP = "5 · Display"
const string G_AL   = "6 · Alerts"

int    dLen          = input.int(2, "Daily swing length (bars each side)", minval = 1, maxval = 10, group = G_DIR, tooltip = "A swing high/low needs this many lower highs / higher lows on BOTH sides. It is only known this many Daily candles after the swing.")
int    h4Len         = input.int(3, "H4 swing length", minval = 1, maxval = 10, group = G_DIR)
int    h1Len         = input.int(3, "H1 swing length", minval = 1, maxval = 10, group = G_DIR)
int    breaksForBias = input.int(2, "Structure breaks needed for bias", minval = 1, maxval = 2, group = G_DIR, tooltip = "BOS = candle CLOSE beyond the latest unbroken confirmed swing (wicks don't count).\n2 = bias is the direction of the last two breaks if they agree; one break against the trend (CHoCH) makes the bias Neutral until the next break.\n1 = bias is simply the last break.")
string alignMode     = input.string("Relaxed", "Daily / H4 alignment", options = ["Relaxed", "Strict"], group = G_DIR, tooltip = "Relaxed: H4 must be directional and Daily must not be opposite (Daily neutral allowed).\nStrict: Daily and H4 must both point the same way.\nDaily and H4 in opposite directions = MIXED = no signals, in both modes.")
string h1Mode        = input.string("Display only", "H1 alignment", options = ["Display only", "H1 not opposite", "H1 must agree"], group = G_DIR)
bool   showBOS       = input.bool(false, "Mark H4 structure breaks (BOS)", group = G_DIR)

bool   showH4Z       = input.bool(true, "Show H4 zones", group = G_ZONE, inline = "zs")
bool   showH1Z       = input.bool(true, "Show H1 zones", group = G_ZONE, inline = "zs")
string zoneSrc       = input.string("H4 or H1", "Zones that can arm a setup", options = ["H4 or H1", "H1 inside H4", "H4 only"], group = G_ZONE, tooltip = "H1 inside H4 = only H1 zones that overlap an active H4 zone on the same side (strict refinement).")
bool   useSR         = input.bool(true, "Support / resistance zones (swing candles)", group = G_ZONE)
bool   useSD         = input.bool(true, "Supply / demand zones (base + impulse)", group = G_ZONE)
bool   flipZones     = input.bool(true, "Flip a broken zone once (S→R / R→S)", group = G_ZONE, tooltip = "A zone is BROKEN when a candle of its own timeframe CLOSES beyond it. A wick beyond it that closes back inside is a SWEEP and the zone stays.")
int    maxZones      = input.int(3, "Max zones per side per timeframe", minval = 1, maxval = 10, group = G_ZONE)
float  zMinThk       = input.float(0.10, "Min zone height (× zone-TF ATR)", minval = 0.0, step = 0.05, group = G_ZONE)
float  zMaxThk       = input.float(1.00, "Max S/R zone height (× ATR)", minval = 0.1, step = 0.1, group = G_ZONE)
float  zMaxSD        = input.float(1.50, "Max S/D zone height (× ATR)", minval = 0.1, step = 0.1, group = G_ZONE)
float  impBodyATR    = input.float(1.00, "Impulse candle: min body (× ATR)", minval = 0.1, step = 0.1, group = G_ZONE)
float  impBodyPct    = input.float(60.0, "Impulse candle: min body % of range", minval = 0.0, maxval = 100.0, group = G_ZONE)
int    baseMax       = input.int(3, "Base: max candles", minval = 1, maxval = 6, group = G_ZONE, tooltip = "BASE = 1..N consecutive candles immediately before an impulse / breakout candle, where each candle has body ≤ X% of its range OR range ≤ Y × ATR. Used for supply/demand zones and for the breakout retest area.")
float  baseBodyPct   = input.float(50.0, "Base candle: max body % of range", minval = 0.0, maxval = 100.0, group = G_ZONE)
float  baseRangeATR  = input.float(0.50, "Base candle: or range ≤ (× ATR)", minval = 0.0, step = 0.05, group = G_ZONE)
bool   showSweeps    = input.bool(true, "Mark H4/H1 zone breakouts and sweeps", group = G_ZONE)
bool   showReact     = input.bool(true, "Mark H4/H1 engulfing / rejection at zones", group = G_ZONE, tooltip = "Display only. These never set the direction.")

float  touchTol      = input.float(0.10, "Zone touch tolerance (× H1 ATR)", minval = 0.0, step = 0.05, group = G_SET)
float  maxDist       = input.float(1.00, "Max distance from zone (× H1 ATR)", minval = 0.1, step = 0.1, group = G_SET, tooltip = "The confirmation candle must close within this distance of the zone's near edge. If price closes further away before confirming, the setup resets (no chasing) and price must return to a zone.")
int    expiryH       = input.int(24, "Setup expiry (hours since last zone touch, 0 = off)", minval = 0, group = G_SET)
bool   showArmed     = input.bool(true, "Label armed (developing) setups", group = G_SET)

bool   useM30        = input.bool(true, "M30", group = G_LTF, inline = "ltf")
bool   useM15        = input.bool(true, "M15", group = G_LTF, inline = "ltf")
bool   useM5         = input.bool(true, "M5", group = G_LTF, inline = "ltf")
bool   useM1         = input.bool(true, "M1", group = G_LTF, inline = "ltf")
int    ltfLen        = input.int(3, "LTF swing length (bars each side)", minval = 1, maxval = 10, group = G_LTF, tooltip = "Swing sensitivity for breakout levels and chart patterns on M30/M15/M5/M1. A swing is confirmed (and usable) this many bars after it forms.")

bool   useBO         = input.bool(true, "Use breakout confirmation", group = G_BO)
string boMode        = input.string("Breakout close", "Entry mode", options = ["Breakout close", "Retest + reaction", "Either"], group = G_BO, tooltip = "Breakout close: confirm on the candle that CLOSES beyond the latest confirmed local swing.\nRetest + reaction: after that breakout, price returns to the broken level / base area and a candle closes in the trade direction back beyond the level.\nEither: whichever qualifies first while the setup is armed.")
float  boBufATR      = input.float(0.0, "Close beyond level by at least (× ATR)", minval = 0.0, step = 0.05, group = G_BO)
string retestRef     = input.string("Level + base", "Retest area", options = ["Level + base", "Level only"], group = G_BO, tooltip = "Level + base: from the broken level to the base's near body edge (± tolerance). Fails on a close beyond the base's far wick.\nLevel only: broken level ± tolerance. Fails on a close X × ATR back through the level.")
float  rtTolATR      = input.float(0.25, "Retest tolerance (× ATR)", minval = 0.0, step = 0.05, group = G_BO)
int    rtMaxBars     = input.int(20, "Retest window (bars)", minval = 1, group = G_BO)
float  invATR        = input.float(1.00, "Level-only failure distance (× ATR)", minval = 0.1, step = 0.1, group = G_BO)

bool   usePat        = input.bool(true, "Use chart-pattern confirmation", group = G_CP)
string patMode       = input.string("Neckline close", "Confirmation", options = ["Neckline close", "Neckline retest", "Either"], group = G_CP, tooltip = "Developing = the pattern's last swing is confirmed and the neckline is not broken yet.\nConfirmed = a candle CLOSES beyond the neckline (or, in retest mode, price retests the neckline and a candle closes away from it).")
float  patTolATR     = input.float(0.50, "Tops / bottoms / shoulders similarity (× ATR)", minval = 0.0, step = 0.05, group = G_CP)
float  patMinHATR    = input.float(1.00, "Min pattern height (× ATR)", minval = 0.0, step = 0.1, group = G_CP)
float  headMinATR    = input.float(0.30, "H&S: head beyond shoulders by (× ATR)", minval = 0.0, step = 0.05, group = G_CP)
int    patMaxLen     = input.int(60, "Max pattern length (bars)", minval = 5, group = G_CP)
bool   showDevPat    = input.bool(true, "Show developing patterns", group = G_CP)
string showPatDraw   = input.string("Signals only", "Keep confirmed pattern drawings", options = ["Signals only", "All confirmed", "None"], group = G_CP)

bool   usePA         = input.bool(false, "Require price-action filter", group = G_PA, tooltip = "OFF by default until the definitions are approved. When ON, a breakout or pattern confirmation also needs an engulfing or rejection candle (same timeframe, last N bars) whose wick reached within the max distance of the zone. Price action never triggers an entry on its own.")
int    paLook        = input.int(3, "PA candle within last N bars", minval = 1, group = G_PA)
float  engRatio      = input.float(1.00, "Engulfing: body ≥ × previous body", minval = 0.1, step = 0.1, group = G_PA)
float  engMinBody    = input.float(50.0, "Engulfing: min body % of range", minval = 0.0, maxval = 100.0, group = G_PA)
float  wickBody      = input.float(2.00, "Rejection: wick ≥ × body", minval = 0.5, step = 0.25, group = G_PA)
float  wickRange     = input.float(50.0, "Rejection: wick ≥ % of range", minval = 0.0, maxval = 100.0, group = G_PA)
float  paMinRng      = input.float(0.30, "PA candle: min range (× ATR)", minval = 0.0, step = 0.05, group = G_PA)

bool   showSignals   = input.bool(true, "Show BUY / SELL labels", group = G_DISP)
bool   showDash      = input.bool(true, "Show dashboard", group = G_DISP)
string dashPos       = input.string("Top right", "Dashboard position", options = ["Top right", "Top left", "Bottom right", "Bottom left"], group = G_DISP)
string dashSize      = input.string("Small", "Dashboard text", options = ["Tiny", "Small", "Normal"], group = G_DISP)
color  colBull       = input.color(#26a69a, "Bullish", group = G_DISP, inline = "col")
color  colBear       = input.color(#ef5350, "Bearish", group = G_DISP, inline = "col")
color  colNeu        = input.color(#9e9e9e, "Neutral", group = G_DISP, inline = "col")

bool   alBuy         = input.bool(true, "BUY signals", group = G_AL, inline = "al1")
bool   alSell        = input.bool(true, "SELL signals", group = G_AL, inline = "al1")
bool   alArm         = input.bool(false, "Setup armed", group = G_AL, inline = "al2")
bool   alDev         = input.bool(false, "Developing pattern", group = G_AL, inline = "al2")

// ─────────────────────────────── TYPES ──────────────────────────────────────
type Zone
    int    id
    float  top
    float  bot
    int    side          // +1 = support / demand (buy side), -1 = resistance / supply (sell side)
    string kind
    string tf
    int    t0
    bool   flipped = false
    box    bx

type Setup
    int    dir
    int    state = 0     // 0 idle, 1 armed, 2 consumed (signal given)
    int    zid   = 0
    float  ztop  = na
    float  zbot  = na
    string zname = ""
    int    armT  = 0

type LTF
    string name
    int    sec
    bool   enabled
    bool   isNew
    int    t
    float  c
    int    bo
    float  boLvl
    int    boT
    int    rt
    int    rtPend
    float  rtLvl
    int    rtLvlT
    int    cpDev
    int    cpType
    int    cpState
    int    cpC
    int    cpR
    float  neck
    int    t1
    int    t2
    int    t3
    int    t4
    int    t5
    float  p1
    float  p2
    float  p3
    float  p4
    float  p5
    bool   paB
    float  paBLow
    bool   paS
    float  paSHigh

type PatDraw
    polyline pl
    line     nk
    label    lb
    string   base      = ""
    int      ptype     = 0
    bool     active    = false
    bool     confirmed = false
    bool     used      = false
    float    lastNeck  = na
    int      lastT     = na
    array<chart.point> pts

// ─────────────────────────────── STATE ──────────────────────────────────────
var array<Zone>    zH4      = array.new<Zone>()
var array<Zone>    zH1      = array.new<Zone>()
var array<int>     zSeq     = array.new<int>(1, 0)
var Setup          sB       = Setup.new(1)
var Setup          sS       = Setup.new(-1)
var array<PatDraw> pds      = array.new<PatDraw>()
var array<PatDraw> keptPats = array.new<PatDraw>()
var array<string>  lastEv   = array.new<string>(4, "")
var string         lastSig  = "—"
if pds.size() == 0
    for k = 0 to 3
        pds.push(PatDraw.new())

// ════════════════════ ENGINES (run inside request.security) ═════════════════

// Price-action candle definitions (objective, thresholds adjustable).
f_pa(float atr) =>
    float rng   = high - low
    float body  = math.abs(close - open)
    float pBody = math.abs(close[1] - open[1])
    float upW   = high - math.max(open, close)
    float loW   = math.min(open, close) - low
    bool  big   = rng >= paMinRng * atr
    bool  bEng  = big and close > open and close[1] < open[1] and close >= open[1] and open <= close[1] and body >= engRatio * pBody and body >= engMinBody / 100.0 * rng
    bool  sEng  = big and close < open and close[1] > open[1] and close <= open[1] and open >= close[1] and body >= engRatio * pBody and body >= engMinBody / 100.0 * rng
    bool  bRej  = big and loW >= wickBody * math.max(body, syminfo.mintick) and loW >= wickRange / 100.0 * rng
    bool  sRej  = big and upW >= wickBody * math.max(body, syminfo.mintick) and upW >= wickRange / 100.0 * rng
    [bEng, sEng, bRej, sRej]

// Market structure: confirmed pivots + candle-close BOS + bias from the last breaks.
f_struct(simple int len) =>
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low, len, len)
    var float swH  = na
    var int   swHT = na
    var float swL  = na
    var int   swLT = na
    var int   b1   = 0
    var int   b2   = 0
    if not na(ph)
        swH  := ph
        swHT := time[len]
    if not na(pl)
        swL  := pl
        swLT := time[len]
    int   brk  = 0
    float bLvl = na
    int   bT   = na
    if not na(swH) and close > swH
        brk  := 1
        bLvl := swH
        bT   := swHT
        swH  := na
    else if not na(swL) and close < swL
        brk  := -1
        bLvl := swL
        bT   := swLT
        swL  := na
    if brk != 0
        b2 := b1
        b1 := brk
    int bias = breaksForBias == 1 ? b1 : (b1 == b2 ? b1 : 0)
    [bias, brk, bLvl, bT, ph, pl]

// Daily: bias of the last CLOSED Daily candle.
f_dly(simple int len) =>
    [bias, brk, bLvl, bT, ph, pl] = f_struct(len)
    bias[1]

// H4 / H1: structure + new zones + candle info, all for the last CLOSED candle.
f_htf(simple int len) =>
    float atr = ta.atr(14)
    [bias, brk, bLvl, bT, ph, pl] = f_struct(len)
    // Support / resistance zone = wick-to-body area of the confirmed swing candle.
    float rTop = na
    float rBot = na
    int   rT   = na
    float sTop = na
    float sBot = na
    int   sT   = na
    if not na(ph)
        float bodyTop = math.max(open[len], close[len])
        float thick   = math.max(math.min(ph - bodyTop, zMaxThk * atr), zMinThk * atr)
        rTop := ph
        rBot := ph - thick
        rT   := time[len]
    if not na(pl)
        float bodyBot = math.min(open[len], close[len])
        float thick   = math.max(math.min(bodyBot - pl, zMaxThk * atr), zMinThk * atr)
        sBot := pl
        sTop := pl + thick
        sT   := time[len]
    // Supply / demand zone = base (1..baseMax indecision candles) + impulse candle.
    float dTop = na
    float dBot = na
    int   dT   = na
    float yTop = na
    float yBot = na
    int   yT   = na
    float rng  = high - low
    float body = math.abs(close - open)
    bool  impB = close > open and body >= impBodyATR * atr and body >= impBodyPct / 100.0 * rng
    bool  impS = close < open and body >= impBodyATR * atr and body >= impBodyPct / 100.0 * rng
    if impB or impS
        int n = 0
        for i = 1 to baseMax
            float r = high[i] - low[i]
            if math.abs(close[i] - open[i]) <= baseBodyPct / 100.0 * r or r <= baseRangeATR * atr
                n += 1
            else
                break
        if n > 0
            float bHi  = high[1]
            float bLo  = low[1]
            float bbHi = math.max(open[1], close[1])
            float bbLo = math.min(open[1], close[1])
            for i = 1 to n
                bHi  := math.max(bHi, high[i])
                bLo  := math.min(bLo, low[i])
                bbHi := math.max(bbHi, math.max(open[i], close[i]))
                bbLo := math.min(bbLo, math.min(open[i], close[i]))
            if impB and close > bHi and bbHi - bLo <= zMaxSD * atr
                dTop := math.max(bbHi, bLo + zMinThk * atr)
                dBot := bLo
                dT   := time[n]
            if impS and close < bLo and bHi - bbLo <= zMaxSD * atr
                yTop := bHi
                yBot := math.min(bbLo, bHi - zMinThk * atr)
                yT   := time[n]
    [bE, sE, bR, sR] = f_pa(atr)
    [bias[1], brk[1], bLvl[1], bT[1], rTop[1], rBot[1], rT[1], sTop[1], sBot[1], sT[1], dTop[1], dBot[1], dT[1], yTop[1], yBot[1], yT[1], high[1], low[1], close[1], time[1], atr[1], bE[1], sE[1], bR[1], sR[1]]

// Zig-zag of confirmed alternating swings (keeps the last 7).
f_zzAdd(array<float> p, array<int> t, array<int> b, array<int> d, int dir, float price, int tm, int bi) =>
    bool changed = false
    int  sz = p.size()
    if sz > 0 and d.get(sz - 1) == dir
        float last = p.get(sz - 1)
        if (dir == 1 and price > last) or (dir == -1 and price < last)
            p.set(sz - 1, price)
            t.set(sz - 1, tm)
            b.set(sz - 1, bi)
            changed := true
    else
        p.push(price)
        t.push(tm)
        b.push(bi)
        d.push(dir)
        if p.size() > 7
            p.shift()
            t.shift()
            b.shift()
            d.shift()
        changed := true
    changed

// Lower-timeframe confirmation engine (M30 / M15 / M5 / M1). Same rules on every TF.
f_ltf(simple int len) =>
    float atr = ta.atr(14)
    float ph  = ta.pivothigh(high, len, len)
    float pl  = ta.pivotlow(low, len, len)

    // ── A. Breakout: candle CLOSE beyond the latest confirmed local swing ──
    var float lvH  = na
    var int   lvHT = na
    var float lvL  = na
    var int   lvLT = na
    if not na(ph)
        lvH  := ph
        lvHT := time[len]
    if not na(pl)
        lvL  := pl
        lvLT := time[len]
    int   boSig = 0
    float boLvl = na
    int   boT   = na
    float buf   = boBufATR * atr
    if not na(lvH) and close > lvH + buf
        boSig := 1
        boLvl := lvH
        boT   := lvHT
        lvH   := na
    else if not na(lvL) and close < lvL - buf
        boSig := -1
        boLvl := lvL
        boT   := lvLT
        lvL   := na

    // Retest sequence (part of the breakout entry, not a separate category).
    var int   rtDir   = 0
    var float rtLvl   = na
    var int   rtLvlT  = na
    var float rtUp    = na
    var float rtLo    = na
    var float rtInv   = na
    var int   rtAge   = 0
    var bool  rtTouch = false
    int rtSig = 0
    if rtDir != 0
        rtAge += 1
        if rtDir == 1
            if close < rtInv or rtAge > rtMaxBars
                rtDir := 0
            else
                if low <= rtUp
                    rtTouch := true
                if rtTouch and close > open and close > rtLvl
                    rtSig := 1
                    rtDir := 0
        else
            if close > rtInv or rtAge > rtMaxBars
                rtDir := 0
            else
                if high >= rtLo
                    rtTouch := true
                if rtTouch and close < open and close < rtLvl
                    rtSig := -1
                    rtDir := 0
    if boSig != 0
        int n = 0
        for i = 1 to baseMax
            float r = high[i] - low[i]
            if math.abs(close[i] - open[i]) <= baseBodyPct / 100.0 * r or r <= baseRangeATR * atr
                n += 1
            else
                break
        float prox = boLvl
        float inv  = na
        if n > 0 and retestRef == "Level + base"
            float bHi  = high[1]
            float bLo  = low[1]
            float bbHi = math.max(open[1], close[1])
            float bbLo = math.min(open[1], close[1])
            for i = 1 to n
                bHi  := math.max(bHi, high[i])
                bLo  := math.min(bLo, low[i])
                bbHi := math.max(bbHi, math.max(open[i], close[i]))
                bbLo := math.min(bbLo, math.min(open[i], close[i]))
            prox := boSig == 1 ? bbHi : bbLo
            inv  := boSig == 1 ? bLo : bHi
        float tol = rtTolATR * atr
        rtDir   := boSig
        rtLvl   := boLvl
        rtLvlT  := boT
        rtAge   := 0
        rtTouch := false
        rtUp    := math.max(boLvl, prox) + tol
        rtLo    := math.min(boLvl, prox) - tol
        if boSig == 1
            rtInv := na(inv) ? boLvl - invATR * atr : math.min(inv, rtLo)
        else
            rtInv := na(inv) ? boLvl + invATR * atr : math.max(inv, rtUp)

    // ── B. Chart patterns from confirmed swings ──
    var array<float> zP = array.new<float>()
    var array<int>   zT = array.new<int>()
    var array<int>   zB = array.new<int>()
    var array<int>   zD = array.new<int>()
    bool zChg = false
    if not na(ph)
        bool c1 = f_zzAdd(zP, zT, zB, zD, 1, ph, time[len], bar_index - len)
        zChg := zChg or c1
    if not na(pl)
        bool c2 = f_zzAdd(zP, zT, zB, zD, -1, pl, time[len], bar_index - len)
        zChg := zChg or c2

    var int   cpType  = 0     // +1 DB, +2 inverse H&S, -1 DT, -2 H&S
    var int   cpState = 0     // 0 none, 1 developing, 2 neckline broken (awaiting retest)
    var int   nX1     = na
    var float nY1     = na
    var int   nX2     = na
    var float nY2     = na
    var float cpExt   = na
    var int   cpLastB = na
    var int   cpBrkB  = na
    var bool  cpTouch = false
    int   cpDev = 0
    int   t1 = na
    int   t2 = na
    int   t3 = na
    int   t4 = na
    int   t5 = na
    float p1 = na
    float p2 = na
    float p3 = na
    float p4 = na
    float p5 = na
    if zChg
        int   sz    = zP.size()
        int   found = 0
        float tolP  = patTolATR * atr
        if sz >= 5
            int   dl    = zD.get(sz - 1)
            float lsP   = zP.get(sz - 5)
            float n1P   = zP.get(sz - 4)
            float hdP   = zP.get(sz - 3)
            float n2P   = zP.get(sz - 2)
            float rsP   = zP.get(sz - 1)
            bool  lenOK = zB.get(sz - 1) - zB.get(sz - 5) <= patMaxLen
            if lenOK and dl == 1 and hdP - math.max(lsP, rsP) >= headMinATR * atr and math.abs(lsP - rsP) <= tolP and math.min(lsP, rsP) - math.max(n1P, n2P) >= 0.5 * patMinHATR * atr
                found := -2
            else if lenOK and dl == -1 and math.min(lsP, rsP) - hdP >= headMinATR * atr and math.abs(lsP - rsP) <= tolP and math.min(n1P, n2P) - math.max(lsP, rsP) >= 0.5 * patMinHATR * atr
                found := 2
            if found != 0
                nX1   := zB.get(sz - 4)
                nY1   := n1P
                nX2   := zB.get(sz - 2)
                nY2   := n2P
                cpExt := hdP
                t1 := zT.get(sz - 5)
                t2 := zT.get(sz - 4)
                t3 := zT.get(sz - 3)
                t4 := zT.get(sz - 2)
                t5 := zT.get(sz - 1)
                p1 := lsP
                p2 := n1P
                p3 := hdP
                p4 := n2P
                p5 := rsP
        if found == 0 and sz >= 3
            int   dl    = zD.get(sz - 1)
            float aP    = zP.get(sz - 3)
            float mP    = zP.get(sz - 2)
            float bP    = zP.get(sz - 1)
            bool  lenOK = zB.get(sz - 1) - zB.get(sz - 3) <= patMaxLen
            if lenOK and dl == 1 and math.abs(aP - bP) <= tolP and math.min(aP, bP) - mP >= patMinHATR * atr
                found := -1
                cpExt := math.max(aP, bP)
            else if lenOK and dl == -1 and math.abs(aP - bP) <= tolP and mP - math.max(aP, bP) >= patMinHATR * atr
                found := 1
                cpExt := math.min(aP, bP)
            if found != 0
                nX1 := zB.get(sz - 2)
                nY1 := mP
                nX2 := nX1 + 1
                nY2 := mP
                t3 := zT.get(sz - 3)
                t4 := zT.get(sz - 2)
                t5 := zT.get(sz - 1)
                p3 := aP
                p4 := mP
                p5 := bP
        if found != 0
            cpType  := found
            cpState := 1
            cpDev   := found
            cpLastB := zB.get(sz - 1)
            cpTouch := false
        else if cpState == 1 and zB.get(sz - 1) != cpLastB and ((cpType < 0 and zD.get(sz - 1) == 1) or (cpType > 0 and zD.get(sz - 1) == -1))
            // a new top (bearish pattern) / bottom (bullish pattern) replaced the pattern
            cpState := 0

    float neck = cpState != 0 ? nY1 + (nY2 - nY1) * (bar_index - nX1) / (nX2 - nX1) : na
    int cpSigC = 0
    int cpSigR = 0
    if cpState == 1
        bool bear = cpType < 0
        if (bear and close > cpExt) or (not bear and close < cpExt) or bar_index - cpLastB > patMaxLen
            cpState := 0
        else if (bear and close < neck) or (not bear and close > neck)
            cpSigC  := cpType
            cpState := 2
            cpBrkB  := bar_index
            cpTouch := false
    else if cpState == 2
        bool  bear = cpType < 0
        float tolR = rtTolATR * atr
        if bar_index - cpBrkB > rtMaxBars or (bear and close > neck + tolR) or (not bear and close < neck - tolR)
            cpState := 0
        else
            if (bear and high >= neck - tolR) or (not bear and low <= neck + tolR)
                cpTouch := true
            if cpTouch and ((bear and close < open and close < neck) or (not bear and close > open and close > neck))
                cpSigR  := cpType
                cpState := 0

    // ── C. Price action (optional filter) ──
    [bE, sE, bR, sR] = f_pa(atr)
    var int   paBB = na
    var float paBL = na
    var int   paSB = na
    var float paSH = na
    if bE or bR
        paBB := bar_index
        paBL := low
    if sE or sR
        paSB := bar_index
        paSH := high
    bool paBOK = not na(paBB) and bar_index - paBB < paLook
    bool paSOK = not na(paSB) and bar_index - paSB < paLook

    [time[1], close[1], boSig[1], boLvl[1], boT[1], rtSig[1], rtDir[1], rtLvl[1], rtLvlT[1], cpDev[1], cpType[1], cpState[1], cpSigC[1], cpSigR[1], neck[1], t1[1], t2[1], t3[1], t4[1], t5[1], p1[1], p2[1], p3[1], p4[1], p5[1], paBOK[1], paBL[1], paSOK[1], paSH[1]]

// ═══════════════════════════ CHART-SIDE HELPERS ═════════════════════════════
f_zoneBg(int side, string tf) =>
    color.new(side == 1 ? colBull : colBear, tf == "H4" ? 82 : 91)

f_zoneBorder(int side, string tf) =>
    color.new(side == 1 ? colBull : colBear, tf == "H4" ? 35 : 60)

f_zoneText(Zone z) =>
    z.tf + " " + z.kind

f_overlaps(array<Zone> arr, int side, float top, float bot) =>
    bool hit = false
    for z in arr
        if z.side == side and top >= z.bot and bot <= z.top
            hit := true
    hit

f_addZone(array<Zone> arr, float top, float bot, int side, string kind, string tf, int t0, bool show) =>
    if not na(top) and not na(bot) and not na(t0) and top > bot
        if not f_overlaps(arr, side, top, bot)
            int nid = zSeq.get(0) + 1
            zSeq.set(0, nid)
            Zone z = Zone.new(nid, top, bot, side, kind, tf, t0)
            if show
                z.bx := box.new(t0, top, t0 + 1, bot, xloc = xloc.bar_time, border_color = f_zoneBorder(side, tf), border_style = tf == "H4" ? line.style_solid : line.style_dashed, bgcolor = f_zoneBg(side, tf), text = f_zoneText(z), text_size = size.tiny, text_color = f_zoneBorder(side, tf), text_halign = text.align_right, text_valign = text.align_center)
            arr.push(z)
            int cnt = 0
            for zz in arr
                if zz.side == side
                    cnt += 1
            if cnt > maxZones
                for k = 0 to arr.size() - 1
                    Zone old = arr.get(k)
                    if old.side == side
                        if not na(old.bx)
                            box.delete(old.bx)
                        arr.remove(k)
                        break
    0

f_addTxt(string a, string b) =>
    a == "" ? b : a + " · " + b

// Process one newly CLOSED H4/H1 candle: breaks/sweeps, reactions, new zones.
f_htfBarUpdate(array<Zone> arr, string tf, bool show, float h, float l, float c, int t, float rTop, float rBot, int rT, float sTop, float sBot, int sT, float dTop, float dBot, int dT, float yTop, float yBot, int yT, bool bE, bool sE, bool bR, bool sR) =>
    string upTxt = ""
    string dnTxt = ""
    bool   swDn  = false
    bool   swUp  = false
    bool   boUp  = false
    bool   boDn  = false
    int i = arr.size() - 1
    while i >= 0
        Zone z = arr.get(i)
        bool brkDn = z.side == 1 and c < z.bot
        bool brkUp = z.side == -1 and c > z.top
        if brkDn or brkUp
            boDn := boDn or brkDn
            boUp := boUp or brkUp
            if flipZones and not z.flipped
                z.flipped := true
                z.side    := brkDn ? -1 : 1
                z.kind    := brkDn ? "S→R flip" : "R→S flip"
                if not na(z.bx)
                    box.set_bgcolor(z.bx, f_zoneBg(z.side, tf))
                    box.set_border_color(z.bx, f_zoneBorder(z.side, tf))
                    box.set_text(z.bx, f_zoneText(z))
                    box.set_text_color(z.bx, f_zoneBorder(z.side, tf))
            else
                if not na(z.bx)
                    box.delete(z.bx)
                arr.remove(i)
        else
            if z.side == 1 and l < z.bot
                swDn := true
            if z.side == -1 and h > z.top
                swUp := true
        i -= 1
    if showSweeps
        if boUp
            upTxt := f_addTxt(upTxt, "BO▲")
        if boDn
            dnTxt := f_addTxt(dnTxt, "BO▼")
        if swUp
            upTxt := f_addTxt(upTxt, "sweep")
        if swDn
            dnTxt := f_addTxt(dnTxt, "sweep")
    if showReact and (bE or bR or sE or sR)
        bool tB = false
        bool tS = false
        for z in arr
            if z.side == 1 and l <= z.top and h >= z.bot
                tB := true
            if z.side == -1 and h >= z.bot and l <= z.top
                tS := true
        if tB and (bE or bR)
            dnTxt := f_addTxt(dnTxt, bE ? "Eng▲" : "Rej▲")
        if tS and (sE or sR)
            upTxt := f_addTxt(upTxt, sE ? "Eng▼" : "Rej▼")
    if show and upTxt != ""
        label.new(t, h, tf + " " + upTxt, xloc.bar_time, yloc.price, color(na), label.style_label_down, colNeu, size.tiny)
    if show and dnTxt != ""
        label.new(t, l, tf + " " + dnTxt, xloc.bar_time, yloc.price, color(na), label.style_label_up, colNeu, size.tiny)
    if useSR
        f_addZone(arr, rTop, rBot, -1, "Resistance", tf, rT, show)
        f_addZone(arr, sTop, sBot, 1, "Support", tf, sT, show)
    if useSD
        f_addZone(arr, dTop, dBot, 1, "Demand", tf, dT, show)
        f_addZone(arr, yTop, yBot, -1, "Supply", tf, yT, show)
    0

f_findZone(int id) =>
    Zone res = na
    for z in zH4
        if z.id == id
            res := z
    for z in zH1
        if z.id == id
            res := z
    res

f_scanTouch(array<Zone> arr, int dir, float hi, float lo, float tol, bool needH4) =>
    Zone best = na
    for z in arr
        bool ok = z.side == dir and lo <= z.top + tol and hi >= z.bot - tol
        if ok and needH4
            ok := f_overlaps(zH4, dir, z.top, z.bot)
        if ok
            if na(best)
                best := z
            else if (dir == 1 and z.top > best.top) or (dir == -1 and z.bot < best.bot)
                best := z
    best

f_touchZone(int dir, float hi, float lo, float tol) =>
    Zone r = na
    if zoneSrc == "H1 inside H4"
        r := f_scanTouch(zH1, dir, hi, lo, tol, true)
    else
        r := f_scanTouch(zH4, dir, hi, lo, tol, false)
        if na(r) and zoneSrc == "H4 or H1"
            r := f_scanTouch(zH1, dir, hi, lo, tol, false)
    r

// Arm / refresh / invalidate a setup. Returns 1 = newly armed, -1 = armed setup reset.
f_setupTouch(Setup s, int gate, float hi, float lo, int t, float tol) =>
    int ev = 0
    if gate != s.dir
        if s.state == 1
            ev := -1
        s.state := 0
    else
        if s.state != 0
            Zone cz = f_findZone(s.zid)
            if na(cz) or cz.side != s.dir
                if s.state == 1
                    ev := -1
                s.state := 0
        Zone tz = f_touchZone(s.dir, hi, lo, tol)
        if not na(tz)
            if s.state == 0 or (s.state == 2 and tz.id != s.zid)
                s.state := 1
                ev := 1
            if s.state == 1
                s.zid   := tz.id
                s.ztop  := tz.top
                s.zbot  := tz.bot
                s.zname := tz.tf + " " + tz.kind
                s.armT  := t
    ev

// After confirmations: reset when price ran away from the zone (no chasing) or the setup expired.
f_setupPost(Setup s, float c, int t, float atrR) =>
    int ev = 0
    if s.state != 0
        float away    = s.dir == 1 ? c - s.ztop : s.zbot - c
        bool  expired = s.state == 1 and expiryH > 0 and t - s.armT > expiryH * 3600000
        if away > maxDist * atrR or expired
            if s.state == 1
                ev := -1
            s.state := 0
    ev

f_patName(int code) =>
    code == 1 ? "Double Bottom" : code == 2 ? "Inverse H&S" : code == -1 ? "Double Top" : code == -2 ? "H&S" : ""

f_patShort(int code) =>
    code == 1 ? "DB" : code == 2 ? "iH&S" : code == -1 ? "DT" : code == -2 ? "H&S" : "?"

f_patCol(int code) =>
    code > 0 ? colBull : colBear

// Does this LTF confirm the armed setup on the candle that just closed?
f_confirm(LTF x, Setup s, float atrR) =>
    string txt     = ""
    bool   usedPat = false
    if x.isNew and s.state == 1
        int   dir  = s.dir
        float away = dir == 1 ? x.c - s.ztop : s.zbot - x.c
        bool  near = away <= maxDist * atrR
        bool  paOK = true
        if usePA
            paOK := dir == 1 ? (x.paB and x.paBLow <= s.ztop + maxDist * atrR) : (x.paS and x.paSHigh >= s.zbot - maxDist * atrR)
        if near and paOK
            if useBO and boMode != "Retest + reaction" and x.bo == dir
                txt := "Breakout"
            if useBO and boMode != "Breakout close" and x.rt == dir
                txt := txt == "" ? "Breakout retest" : txt + " + retest"
            if usePat
                int  cp   = 0
                bool isRt = false
                if patMode != "Neckline retest" and x.cpC * dir > 0
                    cp := x.cpC
                else if patMode != "Neckline close" and x.cpR * dir > 0
                    cp   := x.cpR
                    isRt := true
                if cp != 0
                    string pn = f_patName(cp) + (isRt ? " retest" : "")
                    txt     := txt == "" ? pn : txt + " + " + pn
                    usedPat := true
            if txt != "" and usePA
                txt += " (PA)"
    [txt, usedPat]

f_join(string acc, string tfName, string add) =>
    add == "" ? acc : (acc == "" ? tfName + " " + add : acc + " | " + tfName + " " + add)

f_boLine(LTF x, int dir, string txt, int tEnd) =>
    if str.contains(txt, "Breakout")
        bool  fromRt = not (useBO and boMode != "Retest + reaction" and x.bo == dir)
        float lvl    = fromRt ? x.rtLvl : x.boLvl
        int   t0     = fromRt ? x.rtLvlT : x.boT
        if not na(lvl) and not na(t0)
            color cl = dir == 1 ? colBull : colBear
            line.new(t0, lvl, tEnd, lvl, xloc.bar_time, extend.none, cl, line.style_dotted, 1)
            label.new(t0, lvl, x.name + (fromRt ? " BO+RT" : " BO"), xloc.bar_time, yloc.price, color(na), dir == 1 ? label.style_label_down : label.style_label_up, cl, size.tiny)
    0

f_patFinish(PatDraw d, bool keep) =>
    if keep and not na(d.pl)
        color cl = f_patCol(d.ptype)
        polyline.delete(d.pl)
        d.pl := polyline.new(d.pts, false, false, xloc.bar_time, cl, line_style = line.style_solid, line_width = 2)
        if not na(d.nk)
            line.set_extend(d.nk, extend.none)
            if not na(d.lastNeck) and not na(d.lastT)
                line.set_xy2(d.nk, d.lastT, d.lastNeck)
            line.set_color(d.nk, cl)
            line.set_style(d.nk, line.style_solid)
        if not na(d.lb)
            label.set_textcolor(d.lb, cl)
        keptPats.push(d.copy())
        if keptPats.size() > 20
            PatDraw old = keptPats.shift()
            if not na(old.pl)
                polyline.delete(old.pl)
            if not na(old.nk)
                line.delete(old.nk)
            if not na(old.lb)
                label.delete(old.lb)
    else
        if not na(d.pl)
            polyline.delete(d.pl)
        if not na(d.nk)
            line.delete(d.nk)
        if not na(d.lb)
            label.delete(d.lb)
    d.pl        := na
    d.nk        := na
    d.lb        := na
    d.active    := false
    d.confirmed := false
    d.used      := false
    0

f_keepPat(PatDraw d) =>
    showPatDraw != "None" and (d.used or (d.confirmed and showPatDraw == "All confirmed"))

f_patDraw(LTF x, PatDraw d, bool usedNow) =>
    if x.isNew
        if x.cpDev != 0
            if d.active
                f_patFinish(d, f_keepPat(d))
            bool five = math.abs(x.cpDev) == 2
            array<chart.point> pts = array.new<chart.point>()
            if five
                pts.push(chart.point.from_time(x.t1, x.p1))
                pts.push(chart.point.from_time(x.t2, x.p2))
            pts.push(chart.point.from_time(x.t3, x.p3))
            pts.push(chart.point.from_time(x.t4, x.p4))
            pts.push(chart.point.from_time(x.t5, x.p5))
            color cl = color.new(f_patCol(x.cpDev), showDevPat ? 25 : 100)
            d.pts       := pts
            d.pl        := polyline.new(pts, false, false, xloc.bar_time, cl, line_style = line.style_dashed, line_width = 1)
            d.nk        := line.new(five ? x.t2 : x.t4, five ? x.p2 : x.p4, five ? x.t4 : x.t5, x.p4, xloc.bar_time, extend.right, cl, line.style_dashed, 1)
            d.base      := f_patShort(x.cpDev) + " " + x.name
            d.lb        := label.new(x.t5, x.p5, d.base + " ?", xloc.bar_time, yloc.price, color(na), x.cpDev < 0 ? label.style_label_down : label.style_label_up, cl, size.tiny)
            d.ptype     := x.cpDev
            d.active    := true
            d.confirmed := false
            d.used      := false
        if d.active
            if not na(x.neck)
                d.lastNeck := x.neck
                d.lastT    := x.t
            if x.cpC != 0 or x.cpR != 0
                d.confirmed := true
                label.set_text(d.lb, d.base + " ✓")
            if usedNow
                d.used := true
            if x.cpState == 0
                f_patFinish(d, f_keepPat(d))
    0

f_evText(LTF x) =>
    string e = ""
    if x.bo != 0
        e := f_addTxt(e, x.bo == 1 ? "BO▲" : "BO▼")
    if x.rt != 0
        e := f_addTxt(e, x.rt == 1 ? "RT▲" : "RT▼")
    if x.cpC != 0
        e := f_addTxt(e, f_patShort(x.cpC) + " ✓")
    if x.cpR != 0
        e := f_addTxt(e, f_patShort(x.cpR) + " RT ✓")
    e

f_ltfStatus(LTF x, bool use, bool avail, string lastE) =>
    string s = ""
    if not use
        s := "Off"
    else if not avail
        s := "N/A (below chart TF)"
    else
        if x.cpState == 1
            s := f_patShort(x.cpType) + " forming"
        else if x.cpState == 2
            s := f_patShort(x.cpType) + " neck broken, retest?"
        if x.rtPend != 0
            s := f_addTxt(s, (x.rtPend == 1 ? "BO▲" : "BO▼") + " awaiting retest")
        if s == ""
            s := "watching"
        if lastE != ""
            s := s + " | last " + lastE
    s

f_biasTxt(int b) =>
    b == 1 ? "Bullish ▲" : b == -1 ? "Bearish ▼" : "Neutral"

f_biasCol(int b) =>
    b == 1 ? colBull : b == -1 ? colBear : colNeu

f_pos(string p) =>
    p == "Top left" ? position.top_left : p == "Bottom right" ? position.bottom_right : p == "Bottom left" ? position.bottom_left : position.top_right

f_ts(string s) =>
    s == "Tiny" ? size.tiny : s == "Normal" ? size.normal : size.small

// ═════════════════════════════ DATA REQUESTS ════════════════════════════════
int  chartSec = timeframe.in_seconds(timeframe.period)
bool chartOK  = chartSec <= 3600
bool avM30    = chartSec <= 1800
bool avM15    = chartSec <= 900
bool avM5     = chartSec <= 300
bool avM1     = chartSec <= 60
bool onM30    = useM30 and avM30 and chartOK
bool onM15    = useM15 and avM15 and chartOK
bool onM5     = useM5 and avM5 and chartOK
bool onM1     = useM1 and avM1 and chartOK

// Unused / unavailable timeframes request the chart TF instead (never a lower TF).
string tfD   = chartOK ? "D" : timeframe.period
string tfH4  = chartOK ? "240" : timeframe.period
string tfH1  = chartOK ? "60" : timeframe.period
string tfM30 = onM30 ? "30" : timeframe.period
string tfM15 = onM15 ? "15" : timeframe.period
string tfM5  = onM5 ? "5" : timeframe.period
string tfM1  = onM1 ? "1" : timeframe.period

int dBias = request.security(syminfo.tickerid, tfD, f_dly(dLen), lookahead = barmerge.lookahead_on)

[h4Bias, h4Brk, h4BrkLvl, h4BrkT, h4RTop, h4RBot, h4RT, h4STop, h4SBot, h4ST, h4DTop, h4DBot, h4DT, h4YTop, h4YBot, h4YT, h4H, h4L, h4C, h4T, h4Atr, h4BE, h4SE, h4BR, h4SR] = request.security(syminfo.tickerid, tfH4, f_htf(h4Len), lookahead = barmerge.lookahead_on)
[h1Bias, h1Brk, h1BrkLvl, h1BrkT, h1RTop, h1RBot, h1RT, h1STop, h1SBot, h1ST, h1DTop, h1DBot, h1DT, h1YTop, h1YBot, h1YT, h1H, h1L, h1C, h1T, h1Atr, h1BE, h1SE, h1BR, h1SR] = request.security(syminfo.tickerid, tfH1, f_htf(h1Len), lookahead = barmerge.lookahead_on)

[a30t, a30c, a30bo, a30bl, a30bt, a30rt, a30rp, a30rl, a30rlt, a30dv, a30ty, a30st, a30cc, a30cr, a30nk, a30t1, a30t2, a30t3, a30t4, a30t5, a30p1, a30p2, a30p3, a30p4, a30p5, a30pb, a30pbl, a30ps, a30psh] = request.security(syminfo.tickerid, tfM30, f_ltf(ltfLen), lookahead = barmerge.lookahead_on)
[a15t, a15c, a15bo, a15bl, a15bt, a15rt, a15rp, a15rl, a15rlt, a15dv, a15ty, a15st, a15cc, a15cr, a15nk, a15t1, a15t2, a15t3, a15t4, a15t5, a15p1, a15p2, a15p3, a15p4, a15p5, a15pb, a15pbl, a15ps, a15psh] = request.security(syminfo.tickerid, tfM15, f_ltf(ltfLen), lookahead = barmerge.lookahead_on)
[a05t, a05c, a05bo, a05bl, a05bt, a05rt, a05rp, a05rl, a05rlt, a05dv, a05ty, a05st, a05cc, a05cr, a05nk, a05t1, a05t2, a05t3, a05t4, a05t5, a05p1, a05p2, a05p3, a05p4, a05p5, a05pb, a05pbl, a05ps, a05psh] = request.security(syminfo.tickerid, tfM5, f_ltf(ltfLen), lookahead = barmerge.lookahead_on)
[a01t, a01c, a01bo, a01bl, a01bt, a01rt, a01rp, a01rl, a01rlt, a01dv, a01ty, a01st, a01cc, a01cr, a01nk, a01t1, a01t2, a01t3, a01t4, a01t5, a01p1, a01p2, a01p3, a01p4, a01p5, a01pb, a01pbl, a01ps, a01psh] = request.security(syminfo.tickerid, tfM1, f_ltf(ltfLen), lookahead = barmerge.lookahead_on)

// ═══════════════════════════════ MAIN LOGIC ═════════════════════════════════
float chartAtr = ta.atr(14)
float atrR     = nz(h1Atr, nz(chartAtr[1], 0.0))      // distance yardstick: ATR(14) of the last closed H1 candle
bool  run      = chartOK and bar_index > 0 and atrR > 0

// The chart candle that just CLOSED.
float cH = high[1]
float cL = low[1]
float cC = close[1]
int   cT = time[1]

// ── 1. Direction ──
int dB  = nz(dBias)
int h4B = nz(h4Bias)
int h1B = nz(h1Bias)
int alignedDH4 = 0
if alignMode == "Strict"
    alignedDH4 := dB == h4B and h4B != 0 ? h4B : 0
else
    alignedDH4 := h4B != 0 and dB != -h4B ? h4B : 0
bool mixedDH4 = dB != 0 and h4B != 0 and dB != h4B
int  gate     = alignedDH4
if gate != 0 and h1Mode == "H1 must agree" and h1B != gate
    gate := 0
if gate != 0 and h1Mode == "H1 not opposite" and h1B == -gate
    gate := 0

// ── 2. Zones: update once per newly closed H4 / H1 candle ──
bool h4New = not na(h4T) and h4T != nz(h4T[1])
bool h1New = not na(h1T) and h1T != nz(h1T[1])
if run and h4New
    f_htfBarUpdate(zH4, "H4", showH4Z, h4H, h4L, h4C, h4T, h4RTop, h4RBot, h4RT, h4STop, h4SBot, h4ST, h4DTop, h4DBot, h4DT, h4YTop, h4YBot, h4YT, h4BE, h4SE, h4BR, h4SR)
    if showBOS and nz(h4Brk) != 0 and not na(h4BrkT) and not na(h4BrkLvl)
        color bc = h4Brk == 1 ? colBull : colBear
        line.new(h4BrkT, h4BrkLvl, h4T, h4BrkLvl, xloc.bar_time, extend.none, bc, line.style_dashed, 1)
        label.new(h4T, h4BrkLvl, h4Brk == 1 ? "H4 BOS▲" : "H4 BOS▼", xloc.bar_time, yloc.price, color(na), h4Brk == 1 ? label.style_label_down : label.style_label_up, bc, size.tiny)
if run and h1New
    f_htfBarUpdate(zH1, "H1", showH1Z, h1H, h1L, h1C, h1T, h1RTop, h1RBot, h1RT, h1STop, h1SBot, h1ST, h1DTop, h1DBot, h1DT, h1YTop, h1YBot, h1YT, h1BE, h1SE, h1BR, h1SR)

// ── 3. Setups: price reaches a relevant zone while direction is aligned ──
int evB = 0
int evS = 0
if run
    evB := f_setupTouch(sB, gate, cH, cL, cT, touchTol * atrR)
    evS := f_setupTouch(sS, gate, cH, cL, cT, touchTol * atrR)

// ── 4. Lower-timeframe confirmation ──
bool n30 = run and onM30 and not na(a30t) and a30t != nz(a30t[1])
bool n15 = run and onM15 and not na(a15t) and a15t != nz(a15t[1])
bool n05 = run and onM5 and not na(a05t) and a05t != nz(a05t[1])
bool n01 = run and onM1 and not na(a01t) and a01t != nz(a01t[1])

LTF L30 = LTF.new("M30", 1800, onM30, n30, a30t, a30c, nz(a30bo), a30bl, a30bt, nz(a30rt), nz(a30rp), a30rl, a30rlt, nz(a30dv), nz(a30ty), nz(a30st), nz(a30cc), nz(a30cr), a30nk, a30t1, a30t2, a30t3, a30t4, a30t5, a30p1, a30p2, a30p3, a30p4, a30p5, a30pb, a30pbl, a30ps, a30psh)
LTF L15 = LTF.new("M15", 900, onM15, n15, a15t, a15c, nz(a15bo), a15bl, a15bt, nz(a15rt), nz(a15rp), a15rl, a15rlt, nz(a15dv), nz(a15ty), nz(a15st), nz(a15cc), nz(a15cr), a15nk, a15t1, a15t2, a15t3, a15t4, a15t5, a15p1, a15p2, a15p3, a15p4, a15p5, a15pb, a15pbl, a15ps, a15psh)
LTF L05 = LTF.new("M5", 300, onM5, n05, a05t, a05c, nz(a05bo), a05bl, a05bt, nz(a05rt), nz(a05rp), a05rl, a05rlt, nz(a05dv), nz(a05ty), nz(a05st), nz(a05cc), nz(a05cr), a05nk, a05t1, a05t2, a05t3, a05t4, a05t5, a05p1, a05p2, a05p3, a05p4, a05p5, a05pb, a05pbl, a05ps, a05psh)
LTF L01 = LTF.new("M1", 60, onM1, n01, a01t, a01c, nz(a01bo), a01bl, a01bt, nz(a01rt), nz(a01rp), a01rl, a01rlt, nz(a01dv), nz(a01ty), nz(a01st), nz(a01cc), nz(a01cr), a01nk, a01t1, a01t2, a01t3, a01t4, a01t5, a01p1, a01p2, a01p3, a01p4, a01p5, a01pb, a01pbl, a01ps, a01psh)

[bt30, bu30] = f_confirm(L30, sB, atrR)
[bt15, bu15] = f_confirm(L15, sB, atrR)
[bt05, bu05] = f_confirm(L05, sB, atrR)
[bt01, bu01] = f_confirm(L01, sB, atrR)
[st30, su30] = f_confirm(L30, sS, atrR)
[st15, su15] = f_confirm(L15, sS, atrR)
[st05, su05] = f_confirm(L05, sS, atrR)
[st01, su01] = f_confirm(L01, sS, atrR)

string buyTxt  = f_join(f_join(f_join(f_join("", "M30", bt30), "M15", bt15), "M5", bt05), "M1", bt01)
string sellTxt = f_join(f_join(f_join(f_join("", "M30", st30), "M15", st15), "M5", st05), "M1", st01)
bool   buyNow  = run and buyTxt != ""
bool   sellNow = run and sellTxt != ""

// ── 5. Signals (one per setup) ──
string buyZone  = sB.zname + " " + str.tostring(sB.zbot, format.mintick) + "–" + str.tostring(sB.ztop, format.mintick)
string sellZone = sS.zname + " " + str.tostring(sS.zbot, format.mintick) + "–" + str.tostring(sS.ztop, format.mintick)
string ctx      = "D " + f_biasTxt(dB) + " | H4 " + f_biasTxt(h4B) + " | H1 " + f_biasTxt(h1B)
string sigTime  = run ? str.format_time(cT + chartSec * 1000, "dd MMM HH:mm", syminfo.timezone) : ""

if buyNow
    sB.state := 2
    lastSig  := "BUY · " + buyTxt + " · " + sigTime
    if showSignals
        label.new(cT, cL, "BUY\n" + buyTxt + "\n@ " + sB.zname, xloc.bar_time, yloc.price, colBull, label.style_label_up, color.white, size.small, tooltip = "Zone: " + buyZone + "\n" + ctx)
        f_boLine(L30, 1, bt30, cT)
        f_boLine(L15, 1, bt15, cT)
        f_boLine(L05, 1, bt05, cT)
        f_boLine(L01, 1, bt01, cT)
if sellNow
    sS.state := 2
    lastSig  := "SELL · " + sellTxt + " · " + sigTime
    if showSignals
        label.new(cT, cH, "SELL\n" + sellTxt + "\n@ " + sS.zname, xloc.bar_time, yloc.price, colBear, label.style_label_down, color.white, size.small, tooltip = "Zone: " + sellZone + "\n" + ctx)
        f_boLine(L30, -1, st30, cT)
        f_boLine(L15, -1, st15, cT)
        f_boLine(L05, -1, st05, cT)
        f_boLine(L01, -1, st01, cT)

if showArmed and evB == 1
    label.new(cT, cL, "buy setup · " + sB.zname, xloc.bar_time, yloc.price, color(na), label.style_label_up, color.new(colBull, 20), size.tiny)
if showArmed and evS == 1
    label.new(cT, cH, "sell setup · " + sS.zname, xloc.bar_time, yloc.price, color(na), label.style_label_down, color.new(colBear, 20), size.tiny)

// No chasing / expiry, evaluated after the confirmation check.
if run
    f_setupPost(sB, cC, cT, atrR)
    f_setupPost(sS, cC, cT, atrR)

// ── 6. Pattern drawings & per-TF event log ──
if usePat
    f_patDraw(L30, pds.get(0), (buyNow and bu30) or (sellNow and su30))
    f_patDraw(L15, pds.get(1), (buyNow and bu15) or (sellNow and su15))
    f_patDraw(L05, pds.get(2), (buyNow and bu05) or (sellNow and su05))
    f_patDraw(L01, pds.get(3), (buyNow and bu01) or (sellNow and su01))

array<LTF> ltfs = array.new<LTF>()
ltfs.push(L30)
ltfs.push(L15)
ltfs.push(L05)
ltfs.push(L01)
string devTxt = ""
for [i, x] in ltfs
    if x.isNew
        string e = f_evText(x)
        if e != ""
            lastEv.set(i, e + " " + str.format_time(x.t + x.sec * 1000, "HH:mm", syminfo.timezone))
        if x.cpDev != 0
            devTxt := f_addTxt(devTxt, x.name + " " + f_patName(x.cpDev))

// ── 7. Alerts ──
if buyNow and alBuy
    alert("88 Sharingan BUY " + syminfo.ticker + " | " + buyTxt + " | zone " + buyZone + " | " + ctx + " | close " + str.tostring(cC, format.mintick), alert.freq_once_per_bar)
if sellNow and alSell
    alert("88 Sharingan SELL " + syminfo.ticker + " | " + sellTxt + " | zone " + sellZone + " | " + ctx + " | close " + str.tostring(cC, format.mintick), alert.freq_once_per_bar)
if alArm and evB == 1
    alert("88 Sharingan: BUY setup armed on " + syminfo.ticker + " at " + buyZone + " (waiting for LTF confirmation)", alert.freq_once_per_bar)
if alArm and evS == 1
    alert("88 Sharingan: SELL setup armed on " + syminfo.ticker + " at " + sellZone + " (waiting for LTF confirmation)", alert.freq_once_per_bar)
if alDev and devTxt != ""
    alert("88 Sharingan: developing pattern on " + syminfo.ticker + ": " + devTxt, alert.freq_once_per_bar)

alertcondition(buyNow, "88 Sharingan BUY", "88 Sharingan BUY on {{ticker}} at {{close}}. Use an 'Any alert() function call' alert for the confirmation type and timeframe.")
alertcondition(sellNow, "88 Sharingan SELL", "88 Sharingan SELL on {{ticker}} at {{close}}. Use an 'Any alert() function call' alert for the confirmation type and timeframe.")

// ── 8. Zone boxes run to the current bar; dashboard ──
var table dash = table.new(f_pos(dashPos), 2, 11, bgcolor = color.new(#0e0f13, 10), frame_color = color.new(#c62828, 20), frame_width = 1, border_color = color.new(#787b86, 75), border_width = 1)

f_row(int r, string k, string v, color vc) =>
    string ts = f_ts(dashSize)
    table.cell(dash, 0, r, k, text_color = color.new(#d1d4dc, 0), text_size = ts, text_halign = text.align_left)
    table.cell(dash, 1, r, v, text_color = vc, text_size = ts, text_halign = text.align_left)

if barstate.islast
    for z in zH4
        if not na(z.bx)
            box.set_right(z.bx, time)
    for z in zH1
        if not na(z.bx)
            box.set_right(z.bx, time)
    if showDash
        table.clear(dash, 0, 0, 1, 10)
        f_row(0, "88 SHARINGAN", syminfo.ticker + " · " + timeframe.period, #e53935)
        if not chartOK
            f_row(1, "Chart TF", "Use H1 or lower (M1 / M5 recommended)", color.orange)
        else
            string alTxt = alignedDH4 == 1 ? "Aligned ▲ (buys only)" : alignedDH4 == -1 ? "Aligned ▼ (sells only)" : mixedDH4 ? "MIXED (no trade)" : "Not aligned (no trade)"
            color  alCol = alignedDH4 == 1 ? colBull : alignedDH4 == -1 ? colBear : mixedDH4 ? color.orange : colNeu
            string h1Rel = alignedDH4 == 0 ? "" : h1B == alignedDH4 ? " · agrees" : h1B == -alignedDH4 ? " · opposite" : " · neutral"
            string h1Blk = alignedDH4 != 0 and gate == 0 ? " (blocks)" : ""
            string stTxt = ""
            color  stCol = colNeu
            if gate == 0
                stTxt := "Blocked: no HTF direction"
            else
                Setup s = gate == 1 ? sB : sS
                string side = gate == 1 ? "BUY" : "SELL"
                if s.state == 0
                    stTxt := "Waiting for " + (gate == 1 ? "support / demand" : "resistance / supply") + " zone"
                else if s.state == 1
                    stTxt := side + " armed @ " + s.zname + " " + str.tostring(s.zbot, format.mintick) + "–" + str.tostring(s.ztop, format.mintick)
                    stCol := gate == 1 ? colBull : colBear
                else
                    stTxt := side + " signal given, waiting for reset"
            f_row(1, "Daily", f_biasTxt(dB), f_biasCol(dB))
            f_row(2, "H4", f_biasTxt(h4B), f_biasCol(h4B))
            f_row(3, "D / H4", alTxt, alCol)
            f_row(4, "H1", f_biasTxt(h1B) + h1Rel + h1Blk, f_biasCol(h1B))
            f_row(5, "Setup", stTxt, stCol)
            f_row(6, "M30", f_ltfStatus(L30, useM30, avM30, lastEv.get(0)), #d1d4dc)
            f_row(7, "M15", f_ltfStatus(L15, useM15, avM15, lastEv.get(1)), #d1d4dc)
            f_row(8, "M5", f_ltfStatus(L05, useM5, avM5, lastEv.get(2)), #d1d4dc)
            f_row(9, "M1", f_ltfStatus(L01, useM1, avM1, lastEv.get(3)), #d1d4dc)
            f_row(10, "Last signal", lastSig, lastSig == "—" ? colNeu : str.startswith(lastSig, "BUY") ? colBull : colBear)
