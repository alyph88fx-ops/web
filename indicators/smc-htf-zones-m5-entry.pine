// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//
// SMC HTF Zones + M5 CHoCH Entry
// ─────────────────────────────────────────────────────────────────────────────
//  1. Smart Money Concepts: structure, order blocks, fair value gaps
//  2. H1 and H4 only: FVG that sits on / next to an order block (high-potential zone)
//  3. M5 BOS (break of structure)
//  4. M5 FVG near order block
//  5. Entry signal when an M5 CHoCH appears (A+ when it comes from an H1/H4 zone with the H4/H1 trend)
//     Default: fires live at CMP (current market price) the moment price breaks the M5 CHoCH level
//  Only recent price action is drawn; zones far from the current price are hidden.
//
//  Use it on the M5 chart (or M1 for a closer look). For education only – not financial advice.
// ─────────────────────────────────────────────────────────────────────────────

//@version=6
indicator("SMC HTF Zones + M5 CHoCH Entry", shorttitle = "SMC Zones M5", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

// ═════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═════════════════════════════════════════════════════════════════════════════
grpT = "Timeframes"
tfH4   = input.timeframe("240", "Zone TF 1 (H4)", group = grpT)
tfH1   = input.timeframe("60", "Zone TF 2 (H1)", group = grpT)
tfM5   = input.timeframe("5", "Entry TF (M5)", group = grpT)
htfLen = input.int(5, "H1 / H4 swing length", minval = 2, maxval = 30, group = grpT)
m5Len  = input.int(5, "M5 swing length", minval = 2, maxval = 30, group = grpT)

grpZ = "FVG near OB"
showH4    = input.bool(true, "Show H4 FVG + OB zones", group = grpZ)
showH1    = input.bool(true, "Show H1 FVG + OB zones", group = grpZ)
showM5Z   = input.bool(true, "Show M5 FVG + OB zones", group = grpZ)
showOBbox = input.bool(true, "Draw the order block with each FVG", group = grpZ)
fvgProx   = input.float(0.5, "Max distance FVG ↔ OB (× ATR)", minval = 0.0, step = 0.25, group = grpZ, tooltip = "0 = the FVG must touch the order block. Measured with the ATR of that timeframe.")
fvgMin    = input.float(0.05, "Min FVG size (× ATR)", minval = 0.0, step = 0.05, group = grpZ)
maxZones  = input.int(3, "Max zones per timeframe", minval = 1, maxval = 20, group = grpZ)

grpS = "M5 structure"
showBos   = input.bool(true, "Show M5 BOS", group = grpS)
showChoch = input.bool(true, "Show M5 CHoCH line", group = grpS)

grpE = "Entry signals (M5 CHoCH)"
sigTiming = input.string("Live at CMP", "Signal timing", options = ["Live at CMP", "M5 candle close"], group = grpE, tooltip = "Live at CMP: the signal fires the moment the current market price breaks the M5 CHoCH level, entry = that price. M5 candle close: waits for the M5 candle to close beyond the level (fewer false breaks, later entry).")
showTrig  = input.bool(true, "Show live CHoCH trigger levels", group = grpE)
entryMode = input.string("Zone reaction + trend (A+ only)", "Show entries", options = ["Zone reaction", "Zone reaction + trend (A+ only)", "Every M5 CHoCH"], group = grpE, tooltip = "Zone reaction: the M5 low (buy) / high (sell) that the CHoCH starts from must sit inside an H1/H4 zone of the same direction. Each zone gives one signal only. Every M5 CHoCH: no zone filter (many signals).")
zoneTol   = input.float(0.25, "Zone tolerance (× M5 ATR)", minval = 0.0, step = 0.05, group = grpE, tooltip = "How far the M5 low / high may poke outside the zone and still count.")
brkBuf    = input.float(0.1, "Break buffer (× M5 ATR)", minval = 0.0, step = 0.05, group = grpE, tooltip = "Price must clear the CHoCH level by this much, so a one-tick touch does not trigger.")
maxRisk   = input.float(3.0, "Max stop size (× M5 ATR, 0 = off)", minval = 0.0, step = 0.5, group = grpE, tooltip = "Skip the signal when the stop would be wider than this.")
coolBars  = input.int(10, "Min bars between signals (same side)", minval = 0, maxval = 500, group = grpE)
showRR    = input.bool(true, "Show entry / SL / TP", group = grpE)
showNow   = input.bool(true, "Show NOW call at CMP (latest bar)", group = grpE, tooltip = "A live box next to the current price: BUY NOW / SELL NOW, the open trade with its result so far, or WAIT with the price to watch.")
rr        = input.float(2.0, "Take profit (R multiple)", minval = 0.5, step = 0.5, group = grpE)

grpD = "Display"
histBars = input.int(300, "Draw only the last (bars)", minval = 20, maxval = 5000, group = grpD, tooltip = "Zones, structure and signals are only drawn on recent bars so the chart stays focused on current price.")
zoneDist = input.float(1.0, "Hide zones further than (% from price)", minval = 0.1, step = 0.1, group = grpD)
showDash = input.bool(true, "Show dashboard", group = grpD)
dashPos  = input.string("Top Right", "Dashboard position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grpD)
bullCol  = input.color(#089981, "Bullish", group = grpD)
bearCol  = input.color(#F23645, "Bearish", group = grpD)

int  barMs  = timeframe.in_seconds() * 1000
int  tapMem = 30   // dashboard: a zone tap counts as "recent" for this many bars
bool recent = bar_index >= last_bar_index - histBars

// ═════════════════════════════════════════════════════════════════════════════
// SMC ENGINE (runs on H4, H1 and M5 through request.security)
// ═════════════════════════════════════════════════════════════════════════════
f_gap(float aTop, float aBtm, float bTop, float bBtm) =>
    math.max(0.0, math.max(aBtm, bBtm) - math.min(aTop, bTop))

// Returns events of the requested timeframe. `shift` = 1 reads the last CLOSED bar (no repaint).
f_engine(simple int len, simple int shift) =>
    float a  = ta.atr(14)
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low, len, len)
    float rLo = ta.lowest(low, len + 1)
    float rHi = ta.highest(high, len + 1)

    var int   trend  = 0
    var float hiP    = na
    var int   hiI    = na
    var int   hiT    = na
    var bool  hiLive = false
    var float loP    = na
    var int   loI    = na
    var int   loT    = na
    var bool  loLive = false
    // latest live order block per side
    var float bTop = na
    var float bBtm = na
    var int   bT   = na
    var float sTop = na
    var float sBtm = na
    var int   sT   = na
    // extremes of the current leg (stop level for a live CHoCH entry)
    var float legLo = na
    var float legHi = na

    if not na(ph)
        hiP    := ph
        hiI    := bar_index - len
        hiT    := time[len]
        hiLive := true
    if not na(pl)
        loP    := pl
        loI    := bar_index - len
        loT    := time[len]
        loLive := true
    legLo := not na(ph) ? rLo : na(legLo) ? low : math.min(legLo, low)
    legHi := not na(pl) ? rHi : na(legHi) ? high : math.max(legHi, high)

    // order block mitigated → forget it
    if not na(bBtm) and close < bBtm
        bTop := na
        bBtm := na
        bT   := na
    if not na(sTop) and close > sTop
        sTop := na
        sBtm := na
        sT   := na

    int   brk    = 0     // 2 bull CHoCH, 1 bull BOS, -1 bear BOS, -2 bear CHoCH
    float brkLvl = na
    int   brkT   = na
    float slLvl  = na    // order block extreme = stop level for an entry
    int   zDir   = 0
    float zFTop  = na
    float zFBtm  = na
    int   zFT    = na

    if hiLive and close > hiP
        brk    := trend == -1 ? 2 : 1
        brkLvl := hiP
        brkT   := hiT
        trend  := 1
        hiLive := false
        // bullish OB: last bearish candle at the low of the move
        int span = math.max(1, math.min(bar_index - hiI, 200))
        int ext  = 1
        for k = 1 to span
            if low[k] < low[ext]
                ext := k
        int obK = ext
        int lim = math.min(ext + 3, bar_index)
        for j = ext to lim
            if close[j] < open[j]
                obK := j
                break
        bTop  := high[obK]
        bBtm  := math.min(low[obK], low[ext])
        bT    := time[obK]
        slLvl := bBtm
        // FVG left by the move away from the OB, closest to the OB and still open
        if obK >= 2 and not na(a)
            float minAfter = na
            for k = 0 to obK - 2
                float gT = low[k]
                float gB = high[k + 2]
                bool  filled = not na(minAfter) and minAfter <= gB
                if gT > gB and gT - gB >= fvgMin * a and not filled and f_gap(gT, gB, bTop, bBtm) <= fvgProx * a
                    zDir  := 1
                    zFTop := gT
                    zFBtm := gB
                    zFT   := time[k + 2]
                minAfter := na(minAfter) ? low[k] : math.min(minAfter, low[k])
    else if loLive and close < loP
        brk    := trend == 1 ? -2 : -1
        brkLvl := loP
        brkT   := loT
        trend  := -1
        loLive := false
        // bearish OB: last bullish candle at the high of the move
        int span = math.max(1, math.min(bar_index - loI, 200))
        int ext  = 1
        for k = 1 to span
            if high[k] > high[ext]
                ext := k
        int obK = ext
        int lim = math.min(ext + 3, bar_index)
        for j = ext to lim
            if close[j] > open[j]
                obK := j
                break
        sTop  := math.max(high[obK], high[ext])
        sBtm  := low[obK]
        sT    := time[obK]
        slLvl := sTop
        if obK >= 2 and not na(a)
            float maxAfter = na
            for k = 0 to obK - 2
                float gT = low[k + 2]
                float gB = high[k]
                bool  filled = not na(maxAfter) and maxAfter >= gT
                if gT > gB and gT - gB >= fvgMin * a and not filled and f_gap(gT, gB, sTop, sBtm) <= fvgProx * a
                    zDir  := -1
                    zFTop := gT
                    zFBtm := gB
                    zFT   := time[k + 2]
                maxAfter := na(maxAfter) ? high[k] : math.max(maxAfter, high[k])

    // a new FVG forming next to a live order block later on
    if zDir == 0 and not na(a)
        if low > high[2] and low - high[2] >= fvgMin * a and not na(bTop) and f_gap(low, high[2], bTop, bBtm) <= fvgProx * a
            zDir  := 1
            zFTop := low
            zFBtm := high[2]
            zFT   := time[2]
        else if high < low[2] and low[2] - high >= fvgMin * a and not na(sTop) and f_gap(low[2], high, sTop, sBtm) <= fvgProx * a
            zDir  := -1
            zFTop := low[2]
            zFBtm := high
            zFT   := time[2]

    float zOTop = zDir == 1 ? bTop : zDir == -1 ? sTop : na
    float zOBtm = zDir == 1 ? bBtm : zDir == -1 ? sBtm : na
    int   zOT   = zDir == 1 ? bT : zDir == -1 ? sT : na
    int   evT   = time
    // live CHoCH triggers: the level price must break to flip the trend
    float upLvl = trend == -1 and hiLive ? hiP : na
    float dnLvl = trend == 1 and loLive ? loP : na

    // trigger fields always read the previous bar, so they hold for the whole live bar
    [trend[shift], brk[shift], brkLvl[shift], brkT[shift], slLvl[shift], zDir[shift], zFTop[shift], zFBtm[shift], zFT[shift], zOTop[shift], zOBtm[shift], zOT[shift], evT[shift], upLvl[1], dnLvl[1], legLo[1], legHi[1], a[1]]

shH4 = timeframe.in_seconds(tfH4) > timeframe.in_seconds() ? 1 : 0
shH1 = timeframe.in_seconds(tfH1) > timeframe.in_seconds() ? 1 : 0
shM5 = timeframe.in_seconds(tfM5) > timeframe.in_seconds() ? 1 : 0

[h4Trend, h4Brk, h4BrkLvl, h4BrkT, h4Sl, h4ZDir, h4FTop, h4FBtm, h4FT, h4OTop, h4OBtm, h4OT, h4EvT, h4UpLvl, h4DnLvl, h4LegLo, h4LegHi, h4Atr] = request.security(syminfo.tickerid, tfH4, f_engine(htfLen, shH4), lookahead = shH4 == 1 ? barmerge.lookahead_on : barmerge.lookahead_off)
[h1Trend, h1Brk, h1BrkLvl, h1BrkT, h1Sl, h1ZDir, h1FTop, h1FBtm, h1FT, h1OTop, h1OBtm, h1OT, h1EvT, h1UpLvl, h1DnLvl, h1LegLo, h1LegHi, h1Atr] = request.security(syminfo.tickerid, tfH1, f_engine(htfLen, shH1), lookahead = shH1 == 1 ? barmerge.lookahead_on : barmerge.lookahead_off)
[m5Trend, m5Brk, m5BrkLvl, m5BrkT, m5Sl, m5ZDir, m5FTop, m5FBtm, m5FT, m5OTop, m5OBtm, m5OT, m5EvT, m5UpLvl, m5DnLvl, m5LegLo, m5LegHi, m5Atr] = request.security(syminfo.tickerid, tfM5, f_engine(m5Len, shM5), lookahead = shM5 == 1 ? barmerge.lookahead_on : barmerge.lookahead_off)

// When the chart is on the same timeframe, wait for the bar to close
bool okH4 = shH4 == 1 or barstate.isconfirmed
bool okH1 = shH1 == 1 or barstate.isconfirmed
bool okM5 = shM5 == 1 or barstate.isconfirmed

// ═════════════════════════════════════════════════════════════════════════════
// ZONES ON THE CHART (FVG + its OB)
// ═════════════════════════════════════════════════════════════════════════════
type HZone
    float top
    float btm
    int   dir
    int   id
    box   obBx
    box   fvgBx
    color col
    int   alpha
    bool  hidden = false
    bool  used   = false

method kill(HZone z) =>
    if not na(z.obBx)
        z.obBx.delete()
    if not na(z.fvgBx)
        z.fvgBx.delete()

f_addZone(array<HZone> list, string tf, int dir, float fTop, float fBtm, int fT, float oTop, float oBtm, int oT, int alpha) =>
    bool dup = false
    if list.size() > 0
        for z in list
            if z.id == fT and z.dir == dir
                dup := true
                break
    if not dup and not na(fTop) and not na(oTop)
        color c   = dir == 1 ? bullCol : bearCol
        int   rgt = time + 3 * barMs
        box   ob  = na
        if showOBbox
            ob := box.new(oT, oTop, rgt, oBtm, xloc = xloc.bar_time, border_color = color.new(c, 30), bgcolor = color.new(c, math.min(alpha + 8, 95)), text = tf + (dir == 1 ? " Bull OB" : " Bear OB"), text_color = c, text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_center)
        box fv = box.new(fT, fTop, rgt, fBtm, xloc = xloc.bar_time, border_color = color.new(c, 30), border_style = line.style_dotted, bgcolor = color.new(c, alpha), text = tf + " FVG ★", text_color = c, text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_center)
        list.unshift(HZone.new(top = math.max(fTop, oTop), btm = math.min(fBtm, oBtm), dir = dir, id = fT, obBx = ob, fvgBx = fv, col = c, alpha = alpha))
        if list.size() > maxZones
            list.pop().kill()

// Extend zones, remove broken ones; returns [bullish zone touched, bearish zone touched]
f_updZones(array<HZone> list) =>
    bool bt = false
    bool st = false
    if list.size() > 0
        for i = list.size() - 1 to 0
            HZone z = list.get(i)
            if z.dir == 1 ? close < z.btm : close > z.top
                z.kill()
                list.remove(i)
            else
                int rgt = time + 3 * barMs
                if not na(z.obBx)
                    z.obBx.set_right(rgt)
                if not na(z.fvgBx)
                    z.fvgBx.set_right(rgt)
                if low <= z.top and high >= z.btm
                    if z.dir == 1
                        bt := true
                    else
                        st := true
                // focus on current price: hide zones too far away
                if barstate.islast
                    bool far = f_gap(z.top, z.btm, close, close) > close * zoneDist / 100
                    if far != z.hidden
                        z.hidden := far
                        color ob = far ? #00000000 : color.new(z.col, math.min(z.alpha + 8, 95))
                        color fv = far ? #00000000 : color.new(z.col, z.alpha)
                        color bd = far ? #00000000 : color.new(z.col, 30)
                        color tx = far ? #00000000 : z.col
                        if not na(z.obBx)
                            z.obBx.set_bgcolor(ob)
                            z.obBx.set_border_color(bd)
                            z.obBx.set_text_color(tx)
                        if not na(z.fvgBx)
                            z.fvgBx.set_bgcolor(fv)
                            z.fvgBx.set_border_color(bd)
                            z.fvgBx.set_text_color(tx)
    [bt, st]

// First unused zone of this direction that contains the M5 swing extreme; returns its id or na
f_findZone(array<HZone> list, int dir, float ext, float tol) =>
    int id = na
    if list.size() > 0 and not na(ext)
        for z in list
            if z.dir == dir and not z.used and ext >= z.btm - tol and ext <= z.top + tol
                id := z.id
                break
    id

f_markUsed(array<HZone> list, int id) =>
    if list.size() > 0 and not na(id)
        for z in list
            if z.id == id
                z.used := true

var array<HZone> h4Zones = array.new<HZone>()
var array<HZone> h1Zones = array.new<HZone>()
var array<HZone> m5Zones = array.new<HZone>()

bool newH4Zone = recent and showH4 and okH4 and h4ZDir != 0 and h4EvT != h4EvT[1]
bool newH1Zone = recent and showH1 and okH1 and h1ZDir != 0 and h1EvT != h1EvT[1]
bool newM5Zone = recent and showM5Z and okM5 and m5ZDir != 0 and m5EvT != m5EvT[1]

if newH4Zone
    f_addZone(h4Zones, "H4", h4ZDir, h4FTop, h4FBtm, h4FT, h4OTop, h4OBtm, h4OT, 70)
if newH1Zone
    f_addZone(h1Zones, "H1", h1ZDir, h1FTop, h1FBtm, h1FT, h1OTop, h1OBtm, h1OT, 78)
if newM5Zone
    f_addZone(m5Zones, "M5", m5ZDir, m5FTop, m5FBtm, m5FT, m5OTop, m5OBtm, m5OT, 86)

[h4BullTap, h4BearTap] = f_updZones(h4Zones)
[h1BullTap, h1BearTap] = f_updZones(h1Zones)
[m5BullTap, m5BearTap] = f_updZones(m5Zones)

var int lastBullTap = na
var int lastBearTap = na
if h4BullTap or h1BullTap
    lastBullTap := bar_index
if h4BearTap or h1BearTap
    lastBearTap := bar_index
bool bullTapOk = not na(lastBullTap) and bar_index - lastBullTap <= tapMem
bool bearTapOk = not na(lastBearTap) and bar_index - lastBearTap <= tapMem

// ═════════════════════════════════════════════════════════════════════════════
// M5 STRUCTURE: BOS / CHoCH
// ═════════════════════════════════════════════════════════════════════════════
bool m5New = okM5 and m5Brk != 0 and m5EvT != m5EvT[1]
bool isCh  = math.abs(m5Brk) == 2

if recent and m5New and ((isCh and showChoch) or (not isCh and showBos)) and not na(m5BrkT)
    bool  bull = m5Brk > 0
    color c    = bull ? bullCol : bearCol
    line.new(m5BrkT, m5BrkLvl, m5EvT, m5BrkLvl, xloc = xloc.bar_time, color = c, style = isCh ? line.style_dashed : line.style_solid, width = 1)
    label.new(math.round((m5BrkT + m5EvT) / 2), m5BrkLvl, isCh ? "M5 CHoCH" : "M5 BOS", xloc = xloc.bar_time, color = #00000000, textcolor = c, style = bull ? label.style_label_down : label.style_label_up, size = size.small)

// ═════════════════════════════════════════════════════════════════════════════
// ENTRY SIGNALS ON M5 CHoCH
// ═════════════════════════════════════════════════════════════════════════════
bool upTrend = h4Trend == 1 and h1Trend == 1
bool dnTrend = h4Trend == -1 and h1Trend == -1

bool liveMode = sigTiming == "Live at CMP"

// lowest / highest price of the M5 candle that is still forming (for the stop)
var float curLo = na
var float curHi = na
bool m5Roll = m5EvT != m5EvT[1]
curLo := m5Roll or na(curLo) ? low : math.min(curLo, low)
curHi := m5Roll or na(curHi) ? high : math.max(curHi, high)

float m5A  = nz(m5Atr)
float buf  = brkBuf * m5A
float tol  = zoneTol * m5A

// Live: price clears the M5 CHoCH level right now (realtime: current price, history: the bar's high / low)
varip float usedUp = na
varip float usedDn = na
bool crossUp = liveMode and not na(m5UpLvl) and (na(usedUp) or m5UpLvl != usedUp) and (barstate.isrealtime ? close > m5UpLvl + buf : high > m5UpLvl + buf)
bool crossDn = liveMode and not na(m5DnLvl) and (na(usedDn) or m5DnLvl != usedDn) and (barstate.isrealtime ? close < m5DnLvl - buf : low < m5DnLvl - buf)

bool buyCh  = liveMode ? crossUp : m5New and m5Brk == 2
bool sellCh = liveMode ? crossDn : m5New and m5Brk == -2

// candidate entry and stop (stop = the M5 swing low / high the CHoCH starts from)
float bPx = liveMode ? (barstate.isrealtime ? close : math.max(open, m5UpLvl + buf)) : close
float sPx = liveMode ? (barstate.isrealtime ? close : math.min(open, m5DnLvl - buf)) : close
float bSl = liveMode ? math.min(nz(m5LegLo, curLo), curLo) : m5Sl
float sSl = liveMode ? math.max(nz(m5LegHi, curHi), curHi) : m5Sl

// which H1/H4 zone did the move start from? (H4 first)
int    bH4   = f_findZone(h4Zones, 1, bSl, tol)
int    bH1   = f_findZone(h1Zones, 1, bSl, tol)
int    sH4   = f_findZone(h4Zones, -1, sSl, tol)
int    sH1   = f_findZone(h1Zones, -1, sSl, tol)
string bZone = not na(bH4) ? "H4" : not na(bH1) ? "H1" : ""
string sZone = not na(sH4) ? "H4" : not na(sH1) ? "H1" : ""

varip int    buyBar   = na
varip float  buyPx    = na
varip float  buySl    = na
varip string buyZone  = ""
varip int    buyZid   = na
varip bool   buyAp    = false
varip int    sellBar  = na
varip float  sellPx   = na
varip float  sellSl   = na
varip string sellZone = ""
varip int    sellZid  = na
varip bool   sellAp   = false

bool riskB = not na(bSl) and bSl < bPx and (maxRisk == 0 or m5A == 0 or bPx - bSl <= maxRisk * m5A)
bool riskS = not na(sSl) and sSl > sPx and (maxRisk == 0 or m5A == 0 or sSl - sPx <= maxRisk * m5A)
bool coolB = na(buyBar) or bar_index - buyBar >= coolBars
bool coolS = na(sellBar) or bar_index - sellBar >= coolBars

bool modeB = switch entryMode
    "Zone reaction"                   => bZone != ""
    "Zone reaction + trend (A+ only)" => bZone != "" and upTrend
    => true
bool modeS = switch entryMode
    "Zone reaction"                   => sZone != ""
    "Zone reaction + trend (A+ only)" => sZone != "" and dnTrend
    => true
bool buyOk  = riskB and coolB and modeB
bool sellOk = riskS and coolS and modeS

// a level fires once, whether or not it passes the filters
if crossUp
    usedUp := m5UpLvl
if crossDn
    usedDn := m5DnLvl
if buyCh and buyOk
    buyBar  := bar_index
    buyPx   := bPx
    buySl   := bSl
    buyZone := bZone
    buyZid  := bZone == "H4" ? bH4 : bZone == "H1" ? bH1 : na
    buyAp   := bZone != "" and upTrend
if sellCh and sellOk
    sellBar  := bar_index
    sellPx   := sPx
    sellSl   := sSl
    sellZone := sZone
    sellZid  := sZone == "H4" ? sH4 : sZone == "H1" ? sH1 : na
    sellAp   := sZone != "" and dnTrend

bool buyEntry  = buyBar == bar_index
bool sellEntry = sellBar == bar_index
bool buyAplus  = buyEntry and buyAp
bool sellAplus = sellEntry and sellAp

// each zone gives one signal only
if buyEntry
    f_markUsed(buyZone == "H4" ? h4Zones : h1Zones, buyZid)
if sellEntry
    f_markUsed(sellZone == "H4" ? h4Zones : h1Zones, sellZid)

f_ck(bool b) => b ? "✔" : "✘"
f_arrow(int t) => t == 1 ? "Bullish ▲" : t == -1 ? "Bearish ▼" : "—"
f_tCol(int t) => t == 1 ? bullCol : t == -1 ? bearCol : color.gray

f_rr(float entry, float sl, int dir) =>
    if showRR and not na(sl) and (dir == 1 ? sl < entry : sl > entry)
        float tp = entry + rr * (entry - sl)
        int   x2 = bar_index + 15
        line.new(bar_index, entry, x2, entry, color = color.gray, width = 1)
        line.new(bar_index, sl, x2, sl, color = bearCol, style = line.style_dashed, width = 1)
        line.new(bar_index, tp, x2, tp, color = bullCol, style = line.style_dashed, width = 1)
        label.new(x2, sl, "SL " + str.tostring(sl, format.mintick), color = #00000000, textcolor = bearCol, style = label.style_label_left, size = size.tiny)
        label.new(x2, tp, "TP " + str.tostring(rr) + "R " + str.tostring(tp, format.mintick), color = #00000000, textcolor = bullCol, style = label.style_label_left, size = size.tiny)

// live trigger levels on the last bar
var line  trigUp   = na
var line  trigDn   = na
var label trigUpLb = na
var label trigDnLb = na
if barstate.islast
    line.delete(trigUp)
    line.delete(trigDn)
    label.delete(trigUpLb)
    label.delete(trigDnLb)
    if showTrig and liveMode and not na(m5UpLvl)
        trigUp   := line.new(bar_index - 10, m5UpLvl, bar_index + 10, m5UpLvl, color = bullCol, style = line.style_dotted, width = 2)
        trigUpLb := label.new(bar_index + 10, m5UpLvl, "BUY trigger (M5 CHoCH) " + str.tostring(m5UpLvl, format.mintick), color = #00000000, textcolor = bullCol, style = label.style_label_left, size = size.tiny)
    if showTrig and liveMode and not na(m5DnLvl)
        trigDn   := line.new(bar_index - 10, m5DnLvl, bar_index + 10, m5DnLvl, color = bearCol, style = line.style_dotted, width = 2)
        trigDnLb := label.new(bar_index + 10, m5DnLvl, "SELL trigger (M5 CHoCH) " + str.tostring(m5DnLvl, format.mintick), color = #00000000, textcolor = bearCol, style = label.style_label_left, size = size.tiny)

var string lastSig    = "—"
var color  lastSigCol = color.gray
string tStamp = str.format_time(time, "dd MMM HH:mm", syminfo.timezone)

if buyEntry and recent
    string tx  = (buyAplus ? "BUY A+" : "BUY") + " @ " + str.tostring(buyPx, format.mintick) + "\n" + (buyZone != "" ? buyZone + " zone · " : "") + "M5 CHoCH"
    string tip = "From H1/H4 bullish zone " + f_ck(buyZone != "") + (buyZone != "" ? " (" + buyZone + ")" : "") + "\nH4 bullish " + f_ck(h4Trend == 1) + "\nH1 bullish " + f_ck(h1Trend == 1) + "\nSL " + str.tostring(buySl, format.mintick)
    label.new(bar_index, low, tx, yloc = yloc.belowbar, color = buyAplus ? bullCol : color.new(bullCol, 45), textcolor = color.white, style = label.style_label_up, size = size.small, tooltip = tip)
    f_rr(buyPx, buySl, 1)
    lastSig    := (buyAplus ? "BUY A+ @ " : "BUY @ ") + str.tostring(buyPx, format.mintick) + " · " + tStamp
    lastSigCol := bullCol
    alert("SMC: " + (buyAplus ? "BUY A+" : "BUY") + " (M5 CHoCH) on " + syminfo.ticker + " at " + str.tostring(buyPx, format.mintick) + " SL " + str.tostring(buySl, format.mintick), liveMode ? alert.freq_once_per_bar : alert.freq_once_per_bar_close)

if sellEntry and recent
    string tx  = (sellAplus ? "SELL A+" : "SELL") + " @ " + str.tostring(sellPx, format.mintick) + "\n" + (sellZone != "" ? sellZone + " zone · " : "") + "M5 CHoCH"
    string tip = "From H1/H4 bearish zone " + f_ck(sellZone != "") + (sellZone != "" ? " (" + sellZone + ")" : "") + "\nH4 bearish " + f_ck(h4Trend == -1) + "\nH1 bearish " + f_ck(h1Trend == -1) + "\nSL " + str.tostring(sellSl, format.mintick)
    label.new(bar_index, high, tx, yloc = yloc.abovebar, color = sellAplus ? bearCol : color.new(bearCol, 45), textcolor = color.white, style = label.style_label_down, size = size.small, tooltip = tip)
    f_rr(sellPx, sellSl, -1)
    lastSig    := (sellAplus ? "SELL A+ @ " : "SELL @ ") + str.tostring(sellPx, format.mintick) + " · " + tStamp
    lastSigCol := bearCol
    alert("SMC: " + (sellAplus ? "SELL A+" : "SELL") + " (M5 CHoCH) on " + syminfo.ticker + " at " + str.tostring(sellPx, format.mintick) + " SL " + str.tostring(sellSl, format.mintick), liveMode ? alert.freq_once_per_bar : alert.freq_once_per_bar_close)

// ═════════════════════════════════════════════════════════════════════════════
// NOW: what the indicator says at the current market price
// ═════════════════════════════════════════════════════════════════════════════
// open trade from the last signal, closed when SL or TP is hit
var int    actDir  = 0
var float  actPx   = na
var float  actSl   = na
var float  actTp   = na
var string lastRes = ""
if buyEntry
    actDir := 1
    actPx  := buyPx
    actSl  := buySl
    actTp  := buyPx + rr * (buyPx - buySl)
if sellEntry
    actDir := -1
    actPx  := sellPx
    actSl  := sellSl
    actTp  := sellPx - rr * (sellSl - sellPx)
if actDir == 1 and not buyEntry
    if low <= actSl
        actDir  := 0
        lastRes := "last BUY: SL hit"
    else if high >= actTp
        actDir  := 0
        lastRes := "last BUY: TP hit"
if actDir == -1 and not sellEntry
    if high >= actSl
        actDir  := 0
        lastRes := "last SELL: SL hit"
    else if low <= actTp
        actDir  := 0
        lastRes := "last SELL: TP hit"

// no open trade: is there a valid entry at CMP right now?
// BUY NOW = H4 + H1 bullish, M5 already bullish, price reacted from a bullish H1/H4 zone, stop within limits
float nowSl    = na
int   nowState = 0      // 2 BUY open, 1 BUY NOW, 0 WAIT, -1 SELL NOW, -2 SELL open
if actDir != 0
    nowState := actDir * 2
else if upTrend and m5Trend == 1 and bullTapOk
    float sl = math.min(nz(m5LegLo, curLo), curLo)
    if sl < close and (maxRisk == 0 or m5A == 0 or close - sl <= maxRisk * m5A)
        nowState := 1
        nowSl    := sl
else if dnTrend and m5Trend == -1 and bearTapOk
    float sl = math.max(nz(m5LegHi, curHi), curHi)
    if sl > close and (maxRisk == 0 or m5A == 0 or sl - close <= maxRisk * m5A)
        nowState := -1
        nowSl    := sl

f_p(float v) => str.tostring(v, format.mintick)

string nowTxt = ""
color  nowCol = color.gray
if nowState == 2 or nowState == -2
    float r = (close - actPx) / math.abs(actPx - actSl) * actDir
    nowTxt := (actDir == 1 ? "BUY OPEN" : "SELL OPEN") + "  " + (r >= 0 ? "+" : "") + str.tostring(r, "#.##") + "R\nentry " + f_p(actPx) + "\nSL " + f_p(actSl) + "   TP " + f_p(actTp)
    nowCol := actDir == 1 ? bullCol : bearCol
else if nowState == 1 or nowState == -1
    float tp = close + rr * (close - nowSl)
    nowTxt := (nowState == 1 ? "BUY NOW @ CMP " : "SELL NOW @ CMP ") + f_p(close) + "\nSL " + f_p(nowSl) + "   TP " + f_p(tp)
    nowCol := nowState == 1 ? bullCol : bearCol
else if upTrend
    nowTxt := not na(m5UpLvl) ? "WAIT · BUY above " + f_p(m5UpLvl + buf) + "\n(M5 CHoCH from an H1/H4 zone)" : "WAIT · BUY bias\nlet price come back to an H1/H4 bullish zone"
    nowCol := color.new(bullCol, 50)
else if dnTrend
    nowTxt := not na(m5DnLvl) ? "WAIT · SELL below " + f_p(m5DnLvl - buf) + "\n(M5 CHoCH from an H1/H4 zone)" : "WAIT · SELL bias\nlet price come back to an H1/H4 bearish zone"
    nowCol := color.new(bearCol, 50)
else
    nowTxt := "NO TRADE\nH4 and H1 disagree"
    nowCol := color.gray
if lastRes != "" and nowState != 2 and nowState != -2
    nowTxt := nowTxt + "\n" + lastRes

var label nowLb   = na
var line  nowSlLn = na
var line  nowTpLn = na
if barstate.islast
    label.delete(nowLb)
    line.delete(nowSlLn)
    line.delete(nowTpLn)
    if showNow
        nowLb := label.new(bar_index + 3, close, "NOW · " + nowTxt, color = nowCol, textcolor = color.white, style = label.style_label_left, size = size.normal, textalign = text.align_left)
        float sl = nowState == 2 or nowState == -2 ? actSl : nowSl
        float tp = nowState == 2 or nowState == -2 ? actTp : na(nowSl) ? na : close + rr * (close - nowSl)
        if not na(sl)
            nowSlLn := line.new(bar_index, sl, bar_index + 12, sl, color = bearCol, style = line.style_dashed, width = 2)
            nowTpLn := line.new(bar_index, tp, bar_index + 12, tp, color = bullCol, style = line.style_dashed, width = 2)

// ═════════════════════════════════════════════════════════════════════════════
// DASHBOARD
// ═════════════════════════════════════════════════════════════════════════════
string dashLoc = switch dashPos
    "Top Right"    => position.top_right
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    => position.bottom_left

var table dash = table.new(dashLoc, 2, 8, bgcolor = color.new(#0E1320, 8), frame_color = color.new(color.gray, 60), frame_width = 1, border_color = color.new(color.gray, 85), border_width = 1)

f_row(int r, string k, string v, color vc) =>
    table.cell(dash, 0, r, k, text_color = color.new(color.white, 25), text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, r, v, text_color = vc, text_size = size.small, text_halign = text.align_left)

if showDash and barstate.islast
    string tapTxt = bullTapOk and bearTapOk ? "Both sides" : bullTapOk ? "Bullish zone ▲" : bearTapOk ? "Bearish zone ▼" : "None"
    color  tapCol = bullTapOk and not bearTapOk ? bullCol : bearTapOk and not bullTapOk ? bearCol : color.gray
    string dirTxt = upTrend ? "Look for BUY" : dnTrend ? "Look for SELL" : "Mixed · wait"
    table.cell(dash, 0, 0, "SMC Zones M5", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 0, syminfo.ticker + " · " + timeframe.period, text_color = color.white, text_size = size.small, text_halign = text.align_left)
    f_row(1, "H4 trend", f_arrow(h4Trend), f_tCol(h4Trend))
    f_row(2, "H1 trend", f_arrow(h1Trend), f_tCol(h1Trend))
    f_row(3, "Direction", dirTxt, upTrend ? bullCol : dnTrend ? bearCol : color.gray)
    f_row(4, "M5 structure", f_arrow(m5Trend), f_tCol(m5Trend))
    f_row(5, "H1/H4 zone tapped", tapTxt, tapCol)
    f_row(7, "NOW (CMP)", str.replace_all(nowTxt, "\n", " · "), nowState > 0 ? bullCol : nowState < 0 ? bearCol : color.gray)
    f_row(6, "Last entry", timeframe.in_seconds() > timeframe.in_seconds(tfM5) ? "Use M5 or lower chart" : lastSig, timeframe.in_seconds() > timeframe.in_seconds(tfM5) ? color.orange : lastSigCol)

// ═════════════════════════════════════════════════════════════════════════════
// ALERTS (or use "Any alert() function call" for the detailed messages)
// ═════════════════════════════════════════════════════════════════════════════
alertcondition(buyEntry, "BUY entry (M5 CHoCH)", "SMC BUY: M5 bullish CHoCH on {{ticker}} at {{close}} – set the alert to Once per bar for live CMP signals")
alertcondition(sellEntry, "SELL entry (M5 CHoCH)", "SMC SELL: M5 bearish CHoCH on {{ticker}} at {{close}} – set the alert to Once per bar for live CMP signals")
alertcondition(buyAplus, "BUY A+ (zone + trend + M5 CHoCH)", "SMC BUY A+ on {{ticker}} at {{close}}")
alertcondition(sellAplus, "SELL A+ (zone + trend + M5 CHoCH)", "SMC SELL A+ on {{ticker}} at {{close}}")
alertcondition(nowState == 1 and nowState[1] != 1, "NOW: BUY at CMP", "SMC NOW: BUY at current price on {{ticker}} ({{close}})")
alertcondition(nowState == -1 and nowState[1] != -1, "NOW: SELL at CMP", "SMC NOW: SELL at current price on {{ticker}} ({{close}})")
alertcondition(m5New and not isCh, "M5 BOS", "M5 BOS on {{ticker}}")
alertcondition(newH4Zone or newH1Zone, "New H1/H4 FVG + OB zone", "New H1/H4 high-potential zone on {{ticker}}")
alertcondition(h4BullTap or h1BullTap, "Price in bullish H1/H4 zone", "Price tapped a bullish H1/H4 zone on {{ticker}}")
alertcondition(h4BearTap or h1BearTap, "Price in bearish H1/H4 zone", "Price tapped a bearish H1/H4 zone on {{ticker}}")
