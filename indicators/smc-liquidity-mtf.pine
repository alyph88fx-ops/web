// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
//
// SMC Liquidity MTF Pro
// ─────────────────────────────────────────────────────────────────────────────
//  1. Smart Money Concepts: market structure (CHoCH / BOS), order blocks, FVG
//  2. Buy-side (BSL) / sell-side (SSL) liquidity lines, equal highs/lows, sweeps
//  3. Multi-timeframe: H4 + H1 trend & direction, M15 reversal (CHoCH), M5 entry confirmation
//  4. FVGs are only shown when they sit near an order block (high-potential area)
//  5. A broken FVG flips into an Inverse FVG (IFVG)
//  6. M1 RSI 10-15 → BUY signal, M1 RSI 80-95 → SELL signal
//  7. Buy area (Discount) / Sell area (Premium) of the current dealing range
//  8. CHoCH, BOS, OB, FVG and BSL / SSL lines drawn on the chart
//
//  Best used on the M1 chart (signals) with M5 / M15 open for context.
//  For education only – not financial advice.
// ─────────────────────────────────────────────────────────────────────────────

//@version=6
indicator("SMC Liquidity MTF Pro", shorttitle = "SMC-LQ MTF", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

// ═════════════════════════════════════════════════════════════════════════════
// INPUTS
// ═════════════════════════════════════════════════════════════════════════════
grpS = "Market Structure (chart TF)"
swingLen   = input.int(5, "Swing length", minval = 2, maxval = 50, group = grpS, tooltip = "Bars on each side that confirm a swing high / low. Higher = cleaner, slower structure.")
showStruct = input.bool(true, "Show CHoCH / BOS", group = grpS)
showOB     = input.bool(true, "Show order blocks", group = grpS)
obMax      = input.int(4, "Max order blocks per side", minval = 1, maxval = 20, group = grpS)

grpF = "Fair Value Gaps (only near OB)"
showFVG   = input.bool(true, "Show FVG near order blocks", group = grpF)
fvgProx   = input.float(1.0, "Max distance FVG ↔ OB (× ATR)", minval = 0.0, step = 0.25, group = grpF, tooltip = "An FVG is only drawn when it overlaps, or sits within this distance of, an active order block of the same direction.")
fvgMinAtr = input.float(0.05, "Min FVG size (× ATR)", minval = 0.0, step = 0.05, group = grpF)
showIFVG  = input.bool(true, "Turn broken FVG into IFVG", group = grpF)
fvgMaxAge = input.int(200, "Forget FVGs not near an OB after (bars)", minval = 10, maxval = 1000, group = grpF)

grpL = "Liquidity"
showLiq   = input.bool(true, "Show BSL / SSL lines", group = grpL)
liqLen    = input.int(5, "Liquidity pivot length", minval = 2, maxval = 50, group = grpL)
liqMax    = input.int(6, "Max active lines per side", minval = 1, maxval = 30, group = grpL)
eqThr     = input.float(0.1, "Equal highs / lows threshold (× ATR)", minval = 0.0, step = 0.05, group = grpL)
showSweep = input.bool(true, "Mark liquidity sweeps", group = grpL)

grpM = "Multi-Timeframe"
tfH4       = input.timeframe("240", "Trend TF 1 (H4)", group = grpM)
tfH1       = input.timeframe("60", "Trend TF 2 (H1)", group = grpM)
tfM15      = input.timeframe("15", "Reversal TF (M15)", group = grpM)
tfM5       = input.timeframe("5", "Entry confirmation TF (M5)", group = grpM)
mtfLen     = input.int(5, "MTF swing length", minval = 2, maxval = 30, group = grpM)
biasMode   = input.string("H4 + H1 agree", "Direction bias", options = ["H4 + H1 agree", "H4 only", "H1 only"], group = grpM)
showM15Rev = input.bool(true, "Mark M15 reversals (CHoCH)", group = grpM)

grpR = "M1 RSI Signals"
tfRsi      = input.timeframe("1", "RSI timeframe (M1)", group = grpR)
rsiLen     = input.int(14, "RSI length", minval = 2, group = grpR)
buyLo      = input.float(10.0, "Buy zone", minval = 0, maxval = 100, inline = "buy", group = grpR)
buyHi      = input.float(15.0, "to", minval = 0, maxval = 100, inline = "buy", group = grpR)
sellLo     = input.float(80.0, "Sell zone", minval = 0, maxval = 100, inline = "sell", group = grpR)
sellHi     = input.float(95.0, "to", minval = 0, maxval = 100, inline = "sell", group = grpR)
strictBand = input.bool(false, "Strict band (ignore RSI beyond the zone)", group = grpR, tooltip = "Off: RSI at or below 15 is a buy hit (below 10 included). On: only RSI between 10 and 15 counts. Same for the sell zone.")
onClose    = input.bool(true, "Signals on bar close only (no repaint)", group = grpR)
useBias    = input.bool(true, "Filter: trade only with H4 / H1 direction", group = grpR)
useZone    = input.bool(true, "Filter: buy in Discount / demand, sell in Premium / supply", group = grpR)
useM5      = input.bool(true, "Require M5 entry confirmation", group = grpR)
confWin    = input.int(15, "M5 confirmation window (bars)", minval = 1, maxval = 200, group = grpR)
showRaw    = input.bool(true, "Show raw RSI hits (unfiltered)", group = grpR)

grpD = "Display"
showPD   = input.bool(true, "Show Buy / Sell area (Discount / Premium)", group = grpD)
showDash = input.bool(true, "Show dashboard", group = grpD)
dashPos  = input.string("Top Right", "Dashboard position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = grpD)

grpC = "Colors"
bullCol     = input.color(#089981, "Bullish", group = grpC)
bearCol     = input.color(#F23645, "Bearish", group = grpC)
ifvgBullCol = input.color(#00BCD4, "Bullish IFVG", group = grpC)
ifvgBearCol = input.color(#E040FB, "Bearish IFVG", group = grpC)
bslCol      = input.color(#2962FF, "Buy-side liquidity (BSL)", group = grpC)
sslCol      = input.color(#FF9800, "Sell-side liquidity (SSL)", group = grpC)

// ═════════════════════════════════════════════════════════════════════════════
// TYPES & HELPERS
// ═════════════════════════════════════════════════════════════════════════════
type Zone
    float top
    float btm
    int   left
    int   dir              // 1 = bullish (support), -1 = bearish (resistance)
    box   bx
    bool  inverted = false // FVG that flipped into an IFVG
    bool  shown    = false // FVG qualified (near an OB) and drawn

type Liq
    float price
    int   dir              // 1 = BSL (above highs), -1 = SSL (below lows)
    line  ln
    label lb

method kill(Zone z) =>
    if not na(z.bx)
        z.bx.delete()

// Structure trend of any timeframe: 1 = bullish, -1 = bearish, 0 = unknown.
// Returns the value of the last CLOSED bar so HTF requests do not repaint.
f_trend(simple int len) =>
    var int   t  = 0
    var float sh = na
    var float sl = na
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low, len, len)
    if not na(ph)
        sh := ph
    if not na(pl)
        sl := pl
    if not na(sh) and close > sh
        t  := 1
        sh := na
    if not na(sl) and close < sl
        t  := -1
        sl := na
    t[1]

// Distance between two price ranges (0 when they overlap)
f_gap(float aTop, float aBtm, float bTop, float bBtm) =>
    math.max(0.0, math.max(aBtm, bBtm) - math.min(aTop, bTop))

// Is the range near any order block in the list?
f_nearOB(float top, float btm, array<Zone> obs, float maxDist) =>
    bool near = false
    if obs.size() > 0
        for z in obs
            if f_gap(top, btm, z.top, z.btm) <= maxDist
                near := true
                break
    near

// Remove mitigated order blocks, extend live ones; returns true if price is inside one
f_updOBs(array<Zone> obs) =>
    bool inside = false
    if obs.size() > 0
        for i = obs.size() - 1 to 0
            Zone z = obs.get(i)
            bool broken = z.dir == 1 ? close < z.btm : close > z.top
            if broken
                z.kill()
                obs.remove(i)
            else
                if not na(z.bx)
                    z.bx.set_right(bar_index + 3)
                if low <= z.top and high >= z.btm
                    inside := true
    inside

// Extend liquidity lines; returns true when a level was swept (wick through, close back)
f_updLiq(array<Liq> pool, color c) =>
    bool swept = false
    if pool.size() > 0
        for i = pool.size() - 1 to 0
            Liq l = pool.get(i)
            bool taken = l.dir == 1 ? high > l.price : low < l.price
            if taken
                if l.dir == 1 ? close < l.price : close > l.price
                    swept := true
                l.ln.set_x2(bar_index)
                l.ln.set_style(line.style_dotted)
                l.ln.set_color(color.new(c, 65))
                l.lb.delete()
                pool.remove(i)
            else
                l.ln.set_x2(bar_index + 5)
                l.lb.set_x(bar_index + 5)
    swept

f_obBox(int left, float top, float btm, int dir) =>
    box bx = na
    if showOB
        color c = dir == 1 ? bullCol : bearCol
        bx := box.new(left, top, bar_index + 3, btm, border_color = color.new(c, 40), bgcolor = color.new(c, 82), text = dir == 1 ? "Bull OB" : "Bear OB", text_color = c, text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_center)
    bx

f_tTxt(int t) => t == 1 ? "Bullish ▲" : t == -1 ? "Bearish ▼" : "—"
f_tCol(int t) => t == 1 ? bullCol : t == -1 ? bearCol : color.gray

float atr = ta.atr(14)

// ═════════════════════════════════════════════════════════════════════════════
// MULTI-TIMEFRAME TREND (H4 / H1 direction, M15 reversal, M5 confirmation)
// ═════════════════════════════════════════════════════════════════════════════
int tH4  = nz(request.security(syminfo.tickerid, tfH4, f_trend(mtfLen), lookahead = timeframe.in_seconds(tfH4) >= timeframe.in_seconds() ? barmerge.lookahead_on : barmerge.lookahead_off))
int tH1  = nz(request.security(syminfo.tickerid, tfH1, f_trend(mtfLen), lookahead = timeframe.in_seconds(tfH1) >= timeframe.in_seconds() ? barmerge.lookahead_on : barmerge.lookahead_off))
int tM15 = nz(request.security(syminfo.tickerid, tfM15, f_trend(mtfLen), lookahead = timeframe.in_seconds(tfM15) >= timeframe.in_seconds() ? barmerge.lookahead_on : barmerge.lookahead_off))
int tM5  = nz(request.security(syminfo.tickerid, tfM5, f_trend(mtfLen), lookahead = timeframe.in_seconds(tfM5) >= timeframe.in_seconds() ? barmerge.lookahead_on : barmerge.lookahead_off))

int bias = switch biasMode
    "H4 + H1 agree" => tH4 == tH1 ? tH4 : 0
    "H4 only"       => tH4
    => tH1

// M15 reversal = M15 structure flips direction (CHoCH)
bool m15RevUp = tM15 == 1 and tM15[1] == -1
bool m15RevDn = tM15 == -1 and tM15[1] == 1
var int m15FlipBar = na
if m15RevUp or m15RevDn
    m15FlipBar := bar_index

// ═════════════════════════════════════════════════════════════════════════════
// MARKET STRUCTURE: CHoCH / BOS + ORDER BLOCKS
// ═════════════════════════════════════════════════════════════════════════════
float sph = ta.pivothigh(high, swingLen, swingLen)
float spl = ta.pivotlow(low, swingLen, swingLen)

var float shPrice = na
var int   shBar   = na
var bool  shLive  = false
var float slPrice = na
var int   slBar   = na
var bool  slLive  = false
var int   trend   = 0

var array<Zone> bullObs = array.new<Zone>()
var array<Zone> bearObs = array.new<Zone>()

if not na(sph)
    shPrice := sph
    shBar   := bar_index - swingLen
    shLive  := true
if not na(spl)
    slPrice := spl
    slBar   := bar_index - swingLen
    slLive  := true

bool bullChoch = false
bool bullBos   = false
bool bearChoch = false
bool bearBos   = false

// Bullish break of a swing high
if shLive and close > shPrice
    shLive := false
    bool isChoch = trend == -1
    bullChoch := isChoch
    bullBos   := not isChoch
    trend     := 1
    if showStruct
        line.new(shBar, shPrice, bar_index, shPrice, color = bullCol, style = isChoch ? line.style_dashed : line.style_solid, width = 1)
        label.new(math.round((shBar + bar_index) / 2), shPrice, isChoch ? "CHoCH" : "BOS", color = #00000000, textcolor = bullCol, style = label.style_label_down, size = size.small)
    // Bullish OB = candle with the lowest low between the broken high and now (origin of the move)
    int   span  = math.min(bar_index - shBar, 300)
    float obBtm = low[1]
    float obTop = high[1]
    int   obBar = bar_index - 1
    for i = 1 to span
        if low[i] < obBtm
            obBtm := low[i]
            obTop := high[i]
            obBar := bar_index - i
    bullObs.unshift(Zone.new(top = obTop, btm = obBtm, left = obBar, dir = 1, bx = f_obBox(obBar, obTop, obBtm, 1)))
    if bullObs.size() > obMax
        bullObs.pop().kill()

// Bearish break of a swing low
if slLive and close < slPrice
    slLive := false
    bool isChoch = trend == 1
    bearChoch := isChoch
    bearBos   := not isChoch
    trend     := -1
    if showStruct
        line.new(slBar, slPrice, bar_index, slPrice, color = bearCol, style = isChoch ? line.style_dashed : line.style_solid, width = 1)
        label.new(math.round((slBar + bar_index) / 2), slPrice, isChoch ? "CHoCH" : "BOS", color = #00000000, textcolor = bearCol, style = label.style_label_up, size = size.small)
    // Bearish OB = candle with the highest high between the broken low and now
    int   span  = math.min(bar_index - slBar, 300)
    float obTop = high[1]
    float obBtm = low[1]
    int   obBar = bar_index - 1
    for i = 1 to span
        if high[i] > obTop
            obTop := high[i]
            obBtm := low[i]
            obBar := bar_index - i
    bearObs.unshift(Zone.new(top = obTop, btm = obBtm, left = obBar, dir = -1, bx = f_obBox(obBar, obTop, obBtm, -1)))
    if bearObs.size() > obMax
        bearObs.pop().kill()

bool inBullOB = f_updOBs(bullObs)
bool inBearOB = f_updOBs(bearObs)

// ═════════════════════════════════════════════════════════════════════════════
// FAIR VALUE GAPS → only near OB, flip to IFVG when broken
// ═════════════════════════════════════════════════════════════════════════════
var array<Zone> fvgs = array.new<Zone>()

bool bullGap = low > high[2] and close[1] > high[2] and (low - high[2]) >= fvgMinAtr * atr
bool bearGap = high < low[2] and close[1] < low[2] and (low[2] - high) >= fvgMinAtr * atr
if bullGap
    fvgs.push(Zone.new(top = low, btm = high[2], left = bar_index - 2, dir = 1))
if bearGap
    fvgs.push(Zone.new(top = low[2], btm = high, left = bar_index - 2, dir = -1))
if fvgs.size() > 80
    fvgs.shift().kill()

bool  inBullFvg = false
bool  inBearFvg = false
float nearDist  = fvgProx * atr

if fvgs.size() > 0
    for i = fvgs.size() - 1 to 0
        Zone z = fvgs.get(i)
        bool broken = z.dir == 1 ? close < z.btm : close > z.top
        if broken
            if z.shown and showIFVG and not z.inverted
                // FVG broken → becomes an Inverse FVG acting the other way
                z.inverted := true
                z.dir      := -z.dir
                if not na(z.bx)
                    color c = z.dir == 1 ? ifvgBullCol : ifvgBearCol
                    z.bx.set_bgcolor(color.new(c, 78))
                    z.bx.set_border_color(color.new(c, 30))
                    z.bx.set_text(z.dir == 1 ? "Bull IFVG" : "Bear IFVG")
                    z.bx.set_text_color(c)
                    z.bx.set_right(bar_index + 3)
            else
                z.kill()
                fvgs.remove(i)
        else if not z.shown
            if bar_index - z.left > fvgMaxAge
                fvgs.remove(i)
            else if not na(atr) and f_nearOB(z.top, z.btm, z.dir == 1 ? bullObs : bearObs, nearDist)
                // High-potential area: FVG sitting on / next to an order block
                z.shown := true
                if showFVG
                    color c = z.dir == 1 ? bullCol : bearCol
                    z.bx := box.new(z.left, z.top, bar_index + 3, z.btm, border_color = color.new(c, 50), bgcolor = color.new(c, 72), border_style = line.style_dotted, text = "FVG ★", text_color = c, text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_center)
        else
            if not na(z.bx)
                z.bx.set_right(bar_index + 3)
            if low <= z.top and high >= z.btm
                if z.dir == 1
                    inBullFvg := true
                else
                    inBearFvg := true

bool inBullPOI = inBullOB or inBullFvg
bool inBearPOI = inBearOB or inBearFvg

// ═════════════════════════════════════════════════════════════════════════════
// LIQUIDITY: BSL (above swing highs) / SSL (below swing lows)
// ═════════════════════════════════════════════════════════════════════════════
float lph = ta.pivothigh(high, liqLen, liqLen)
float lpl = ta.pivotlow(low, liqLen, liqLen)

var array<Liq> bslPool = array.new<Liq>()
var array<Liq> sslPool = array.new<Liq>()
var float lastLph = na
var float lastLpl = na

bool bslSwept = false
bool sslSwept = false

if showLiq
    bslSwept := f_updLiq(bslPool, bslCol)
    sslSwept := f_updLiq(sslPool, sslCol)
    if not na(lph)
        bool eqh = not na(lastLph) and not na(atr) and math.abs(lph - lastLph) <= eqThr * atr
        line  ln = line.new(bar_index - liqLen, lph, bar_index + 5, lph, color = bslCol, style = line.style_dashed, width = eqh ? 2 : 1)
        label lb = label.new(bar_index + 5, lph, eqh ? "EQH · BSL" : "BSL", color = #00000000, textcolor = bslCol, style = label.style_label_left, size = size.tiny)
        bslPool.push(Liq.new(price = lph, dir = 1, ln = ln, lb = lb))
        if bslPool.size() > liqMax
            Liq o = bslPool.shift()
            o.ln.delete()
            o.lb.delete()
        lastLph := lph
    if not na(lpl)
        bool eql = not na(lastLpl) and not na(atr) and math.abs(lpl - lastLpl) <= eqThr * atr
        line  ln = line.new(bar_index - liqLen, lpl, bar_index + 5, lpl, color = sslCol, style = line.style_dashed, width = eql ? 2 : 1)
        label lb = label.new(bar_index + 5, lpl, eql ? "EQL · SSL" : "SSL", color = #00000000, textcolor = sslCol, style = label.style_label_left, size = size.tiny)
        sslPool.push(Liq.new(price = lpl, dir = -1, ln = ln, lb = lb))
        if sslPool.size() > liqMax
            Liq o = sslPool.shift()
            o.ln.delete()
            o.lb.delete()
        lastLpl := lpl

if showSweep and bslSwept
    label.new(bar_index, high, "BSL swept", yloc = yloc.abovebar, color = #00000000, textcolor = bslCol, style = label.style_label_down, size = size.tiny)
if showSweep and sslSwept
    label.new(bar_index, low, "SSL swept", yloc = yloc.belowbar, color = #00000000, textcolor = sslCol, style = label.style_label_up, size = size.tiny)

// ═════════════════════════════════════════════════════════════════════════════
// BUY / SELL AREA: Premium & Discount of the current dealing range
// ═════════════════════════════════════════════════════════════════════════════
var float rTop    = na
var int   rTopBar = na
var float rBtm    = na
var int   rBtmBar = na

if not na(sph)
    rTop    := sph
    rTopBar := bar_index - swingLen
if not na(spl)
    rBtm    := spl
    rBtmBar := bar_index - swingLen
if not na(rTop) and high > rTop
    rTop    := high
    rTopBar := bar_index
if not na(rBtm) and low < rBtm
    rBtm    := low
    rBtmBar := bar_index

float eq     = na(rTop) or na(rBtm) ? na : (rTop + rBtm) / 2
float eqBand = na(eq) ? na : (rTop - rBtm) * 0.05
bool  inDiscount = not na(eq) and close < eq - eqBand
bool  inPremium  = not na(eq) and close > eq + eqBand

var box   premBox = na
var box   discBox = na
var line  eqLine  = na
var label eqLabel = na

if showPD and barstate.islast and not na(eq)
    int lft = math.min(rTopBar, rBtmBar)
    int rgt = bar_index + 20
    color pc = color.new(bearCol, bias == -1 ? 84 : 93)
    color dc = color.new(bullCol, bias == 1 ? 84 : 93)
    if na(premBox)
        premBox := box.new(lft, rTop, rgt, eq, border_color = #00000000, bgcolor = pc, text = "SELL AREA · Premium", text_color = bearCol, text_size = size.small, text_halign = text.align_right, text_valign = text.align_top)
        discBox := box.new(lft, eq, rgt, rBtm, border_color = #00000000, bgcolor = dc, text = "BUY AREA · Discount", text_color = bullCol, text_size = size.small, text_halign = text.align_right, text_valign = text.align_bottom)
        eqLine  := line.new(lft, eq, rgt, eq, color = color.gray, style = line.style_dotted)
        eqLabel := label.new(rgt, eq, "EQ 50%", color = #00000000, textcolor = color.gray, style = label.style_label_left, size = size.tiny)
    else
        premBox.set_lefttop(lft, rTop)
        premBox.set_rightbottom(rgt, eq)
        premBox.set_bgcolor(pc)
        discBox.set_lefttop(lft, eq)
        discBox.set_rightbottom(rgt, rBtm)
        discBox.set_bgcolor(dc)
        eqLine.set_xy1(lft, eq)
        eqLine.set_xy2(rgt, eq)
        eqLabel.set_xy(rgt, eq)

// ═════════════════════════════════════════════════════════════════════════════
// M1 RSI SIGNALS (filtered by SMC bias / area, confirmed by M5)
// ═════════════════════════════════════════════════════════════════════════════
float   rsiChart = ta.rsi(close, rsiLen)
float[] rsiArr   = request.security_lower_tf(syminfo.tickerid, tfRsi, ta.rsi(close, rsiLen), ignore_invalid_timeframe = true)
bool    chartLtf = timeframe.in_seconds() <= timeframe.in_seconds(tfRsi)

// On the M1 chart use RSI directly; on higher charts use the lowest / highest M1 RSI inside each bar
float rsiLo  = rsiChart
float rsiHi  = rsiChart
float rsiNow = rsiChart
if not chartLtf
    rsiLo  := na
    rsiHi  := na
    rsiNow := na
    if not na(rsiArr)
        if rsiArr.size() > 0
            rsiLo  := rsiArr.min()
            rsiHi  := rsiArr.max()
            rsiNow := rsiArr.last()

bool rawBuy  = not na(rsiLo) and rsiLo <= buyHi and (not strictBand or rsiLo >= buyLo)
bool rawSell = not na(rsiHi) and rsiHi >= sellLo and (not strictBand or rsiHi <= sellHi)
bool gate    = not onClose or barstate.isconfirmed
bool buyHit  = rawBuy and not rawBuy[1] and gate
bool sellHit = rawSell and not rawSell[1] and gate

bool okBiasBuy  = not useBias or bias == 1
bool okBiasSell = not useBias or bias == -1
bool okZoneBuy  = not useZone or inDiscount or inBullPOI
bool okZoneSell = not useZone or inPremium or inBearPOI

bool buySetup  = buyHit and okBiasBuy and okZoneBuy
bool sellSetup = sellHit and okBiasSell and okZoneSell

var int pendBuy  = na
var int pendSell = na
bool buyConfirm  = false
bool sellConfirm = false
bool buyLate     = false
bool sellLate    = false

if buySetup
    pendSell := na
    if not useM5 or tM5 == 1
        buyConfirm := true
        pendBuy    := na
    else
        pendBuy := bar_index
else if not na(pendBuy)
    if bar_index - pendBuy > confWin
        pendBuy := na
    else if tM5 == 1 and gate
        buyConfirm := true
        buyLate    := true
        pendBuy    := na

if sellSetup
    pendBuy := na
    if not useM5 or tM5 == -1
        sellConfirm := true
        pendSell    := na
    else
        pendSell := bar_index
else if not na(pendSell)
    if bar_index - pendSell > confWin
        pendSell := na
    else if tM5 == -1 and gate
        sellConfirm := true
        sellLate    := true
        pendSell    := na

var string lastSig    = "—"
var color  lastSigCol = color.gray
string tStamp = str.format_time(time, "dd MMM HH:mm", syminfo.timezone)

if buyConfirm
    label.new(bar_index, low, buyLate ? "BUY ✔\nM5 confirmed" : "BUY ✔\nRSI " + str.tostring(rsiLo, "#.0"), yloc = yloc.belowbar, color = bullCol, textcolor = color.white, style = label.style_label_up, size = size.small)
    lastSig    := "BUY ✔ " + tStamp
    lastSigCol := bullCol
else if buySetup
    label.new(bar_index, low, "BUY setup\nwait M5", yloc = yloc.belowbar, color = color.new(bullCol, 60), textcolor = color.white, style = label.style_label_up, size = size.tiny)
    lastSig    := "BUY setup " + tStamp
    lastSigCol := color.new(bullCol, 30)

if sellConfirm
    label.new(bar_index, high, sellLate ? "SELL ✔\nM5 confirmed" : "SELL ✔\nRSI " + str.tostring(rsiHi, "#.0"), yloc = yloc.abovebar, color = bearCol, textcolor = color.white, style = label.style_label_down, size = size.small)
    lastSig    := "SELL ✔ " + tStamp
    lastSigCol := bearCol
else if sellSetup
    label.new(bar_index, high, "SELL setup\nwait M5", yloc = yloc.abovebar, color = color.new(bearCol, 60), textcolor = color.white, style = label.style_label_down, size = size.tiny)
    lastSig    := "SELL setup " + tStamp
    lastSigCol := color.new(bearCol, 30)

// Raw RSI hits (zone reached but SMC filters not met)
plotshape(showRaw and buyHit and not buySetup, "M1 RSI oversold (raw)", shape.triangleup, location.belowbar, color.new(bullCol, 45), size = size.tiny)
plotshape(showRaw and sellHit and not sellSetup, "M1 RSI overbought (raw)", shape.triangledown, location.abovebar, color.new(bearCol, 45), size = size.tiny)

// M15 reversal markers
plotshape(showM15Rev and m15RevUp, "M15 reversal up", shape.diamond, location.belowbar, color.new(bullCol, 20), size = size.tiny, text = "M15↺", textcolor = bullCol)
plotshape(showM15Rev and m15RevDn, "M15 reversal down", shape.diamond, location.abovebar, color.new(bearCol, 20), size = size.tiny, text = "M15↺", textcolor = bearCol)

// ═════════════════════════════════════════════════════════════════════════════
// DASHBOARD
// ═════════════════════════════════════════════════════════════════════════════
string dashLoc = switch dashPos
    "Top Right"    => position.top_right
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    => position.bottom_left

var table dash = table.new(dashLoc, 2, 9, bgcolor = color.new(#0E1320, 8), frame_color = color.new(color.gray, 60), frame_width = 1, border_color = color.new(color.gray, 85), border_width = 1)

f_row(int r, string k, string v, color vc) =>
    table.cell(dash, 0, r, k, text_color = color.new(color.white, 30), text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, r, v, text_color = vc, text_size = size.small, text_halign = text.align_left)

if showDash and barstate.islast
    string biasTxt = bias == 1 ? "BUY only ▲" : bias == -1 ? "SELL only ▼" : "Mixed · wait"
    int    m15Ago  = na(m15FlipBar) ? na : bar_index - m15FlipBar
    string m15Txt  = f_tTxt(tM15) + (not na(m15Ago) and m15Ago <= 30 ? " · CHoCH " + str.tostring(m15Ago) + " bars ago" : "")
    bool   m5Ok    = bias != 0 and tM5 == bias
    string m5Txt   = f_tTxt(tM5) + (m5Ok ? " · confirms ✔" : " · wait")
    string zoneTxt = inPremium ? "Premium · sell area" : inDiscount ? "Discount · buy area" : na(eq) ? "—" : "Equilibrium"
    color  zoneCol = inPremium ? bearCol : inDiscount ? bullCol : color.gray
    color  rsiCol  = rsiNow <= buyHi ? bullCol : rsiNow >= sellLo ? bearCol : color.white
    table.cell(dash, 0, 0, "SMC MTF", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 0, syminfo.ticker + " · " + timeframe.period, text_color = color.white, text_size = size.small, text_halign = text.align_left)
    f_row(1, "H4 trend", f_tTxt(tH4), f_tCol(tH4))
    f_row(2, "H1 trend", f_tTxt(tH1), f_tCol(tH1))
    f_row(3, "Direction", biasTxt, f_tCol(bias))
    f_row(4, "M15 reversal", m15Txt, f_tCol(tM15))
    f_row(5, "M5 entry", m5Txt, m5Ok ? f_tCol(tM5) : color.gray)
    f_row(6, "M1 RSI", na(rsiNow) ? "—" : str.tostring(rsiNow, "#.0"), rsiCol)
    f_row(7, "Price area", zoneTxt, zoneCol)
    f_row(8, "Last signal", lastSig, lastSigCol)

// ═════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═════════════════════════════════════════════════════════════════════════════
alertcondition(buyConfirm, "BUY confirmed", "SMC: BUY confirmed on {{ticker}} ({{interval}}) at {{close}}")
alertcondition(sellConfirm, "SELL confirmed", "SMC: SELL confirmed on {{ticker}} ({{interval}}) at {{close}}")
alertcondition(buySetup, "BUY setup (M1 RSI oversold in buy area)", "SMC: BUY setup on {{ticker}} – waiting for M5")
alertcondition(sellSetup, "SELL setup (M1 RSI overbought in sell area)", "SMC: SELL setup on {{ticker}} – waiting for M5")
alertcondition(buyHit, "M1 RSI oversold (raw)", "M1 RSI reached the buy zone on {{ticker}}")
alertcondition(sellHit, "M1 RSI overbought (raw)", "M1 RSI reached the sell zone on {{ticker}}")
alertcondition(bullChoch, "Bullish CHoCH", "Bullish CHoCH on {{ticker}} ({{interval}})")
alertcondition(bearChoch, "Bearish CHoCH", "Bearish CHoCH on {{ticker}} ({{interval}})")
alertcondition(bullBos, "Bullish BOS", "Bullish BOS on {{ticker}} ({{interval}})")
alertcondition(bearBos, "Bearish BOS", "Bearish BOS on {{ticker}} ({{interval}})")
alertcondition(bslSwept, "Buy-side liquidity swept", "BSL swept on {{ticker}} ({{interval}})")
alertcondition(sslSwept, "Sell-side liquidity swept", "SSL swept on {{ticker}} ({{interval}})")
alertcondition(m15RevUp or m15RevDn, "M15 reversal", "M15 structure reversal (CHoCH) on {{ticker}}")
